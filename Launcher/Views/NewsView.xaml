<UserControl x:Class="Launcher.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Changelog Section Card Style -->
            <Style x:Key="ChangelogCard" TargetType="Border">
                <Setter Property="Background" Value="#1A1B22"/>
                <Setter Property="BorderBrush" Value="#2A2C38"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="20,16"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <!-- Changelog Item Bullet -->
            <Style x:Key="ChangelogBullet" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#3B82F6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,2,10,0"/>
                <Setter Property="Text" Value="•"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#141416">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="42,28,42,32">
            <StackPanel MaxWidth="880" HorizontalAlignment="Center">

                <!-- ══════ NEWS HEADER & RELEASE BANNER ══════ -->
                <Border Background="#1A1B24" BorderBrush="#2B2E3E" BorderThickness="1" CornerRadius="12" Padding="24,20" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#1D4ED8" CornerRadius="5" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="LATEST RELEASE" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                                <Border Background="#1E293B" CornerRadius="5" Padding="8,3">
                                    <TextBlock Text="v1.1.4 STABLE" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Flow Client v1.1.4 — Zero-Latency &amp; Refined Theme" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            <TextBlock Text="Welcome to Flow Client v1.1.4. Featuring unified modern dark grey backgrounds across all screens, zero-latency tab transitions, rock-solid profile dropdown, and seamless in-app updates."
                                       Foreground="#8E95A5" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                        </StackPanel>

                        <!-- Mascot head icon badge -->
                        <Border Grid.Column="1" Width="52" Height="52" CornerRadius="10" Background="#161822" BorderBrush="#25293A" BorderThickness="1"
                                VerticalAlignment="Center" Margin="20,0,0,0">
                            <Image Source="/flowm.ico" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══════ SECTION: WHAT'S NEW ══════ -->
                <TextBlock Text="✨ WHAT'S NEW &amp; HIGHLIGHTS" Foreground="#64748B" FontSize="11.5" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,10"/>

                <Border Style="{StaticResource ChangelogCard}">
                    <StackPanel>
                        <!-- Item 1: Interactive 3D Models -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Interactive 3D Minecraft Objects (Home Stage)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="The center of Home now features real, hardware-accelerated 3D Minecraft models tailored to your selected loader: Grass Block for Vanilla, Paper sheet for Fabric/Quilt, authentic Fox Head for NeoForge, and Iron Anvil for Forge. Click and drag with your mouse to rotate them freely in 3D!"
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 2: Version Navigation Arrows -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Edge Version Navigation Arrows (&lt; and &gt;)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Easily cycle between installed Minecraft versions directly from Home using the sleek navigation arrows at the screen edges, updating the active instance and 3D model with smooth pop transitions."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 3: Home Corner Action Buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Home Quit &amp; Animated Update Buttons" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Conveniently placed in the bottom corners of Home: a sleek Quit button on the bottom-left with red power hover glow and exit animation, and the iconic morphing Update button on the bottom-right."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 4: Zero Freeze Tab Switching -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Zero-Freeze Tab Switching (Versions &amp; Account)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Eliminated all micro-stutters and freezes when clicking Versions and Account. WMI queries and Java runtime discovery are now cached, and instance disk sizes calculate asynchronously in the background."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 5: Rock-Solid Dropdown -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Rock-Solid Profile Dropdown Menu" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Clicking your player avatar opens a robust in-tree dropdown overlay with a full-window click-away backdrop, completely solving issues with menus closing prematurely."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 6: Unified Dark Grey Theme -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Unified Modern Dark Grey Theme" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="All views and screens now share a uniform neutral dark grey palette (#141416), removing color mismatches across the launcher."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 4 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="In-App Updates Directly from Settings" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Check for updates and trigger one-click automatic downloads and installations directly inside Settings without having to manually reinstall."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 5 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Directional Navigation Slide Transitions" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Switching between categories slides content in the direction of the destination tab with smooth cubic easing."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════ SECTION: VISUAL & LAYOUT REDESIGN ══════ -->
                <TextBlock Text="🎨 VISUAL &amp; LAYOUT REFINEMENTS" Foreground="#64748B" FontSize="11.5" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoFont}" Margin="0,10,0,10"/>

                <Border Style="{StaticResource ChangelogCard}">
                    <StackPanel>
                        <!-- Item 1 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Clean Top Bar Layout" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Restored iconic FLOW branding on the top-left, centered 5-tab menu (News, Account, Home, Versions, Settings), and relocated player profile pill to the top-right."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 2 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="3D Isometric Cubic Mascot Stage" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Features continuous idle bobbing floating animation with depth tiles in a serene, deep-slate dark environment."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Item 3 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ChangelogBullet}" Grid.Column="0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Uncluttered Centered LAUNCH Dock" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Giant 380×56px vibrant electric blue launch button with live status pills. Automatically transforms into red 'CLOSE GAME' while Minecraft is active."
                                           Foreground="#8E95A5" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════ SECTION: CLEANED UP & REMOVED ══════ -->
                <TextBlock Text="🗑️ CLEANED UP &amp; REMOVED" Foreground="#64748B" FontSize="11.5" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoFont}" Margin="0,10,0,10"/>

                <Border Style="{StaticResource ChangelogCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="–" Foreground="#EF4444" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" Grid.Column="0"/>
                            <TextBlock Text="Removed mock advertising cards and promotional banners flanking the launch dock." Foreground="#CBD5E1" FontSize="12.5" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="–" Foreground="#EF4444" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" Grid.Column="0"/>
                            <TextBlock Text="Removed unnecessary footer branding text under the launch button." Foreground="#CBD5E1" FontSize="12.5" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="–" Foreground="#EF4444" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" Grid.Column="0"/>
                            <TextBlock Text="Removed the Java | Bedrock capsule toggle from the navigation bar." Foreground="#CBD5E1" FontSize="12.5" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="–" Foreground="#EF4444" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" Grid.Column="0"/>
                            <TextBlock Text="Removed top-right window title controls (-) and (X) for an ultra-sleek, clean borderless window." Foreground="#CBD5E1" FontSize="12.5" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
