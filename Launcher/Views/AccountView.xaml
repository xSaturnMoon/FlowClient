<UserControl x:Class="Launcher.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             xmlns:components="clr-namespace:Launcher.Components"
             AllowDrop="True"
             Drop="AccountView_Drop"
             DragOver="AccountView_DragOver">
    <UserControl.DataContext>
        <vm:AccountViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">

        <Grid Margin="48,48,48,32">

            <!-- Sign in -->
            <StackPanel VerticalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel Visibility="{Binding ShowDeviceCode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="Account" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Sign in with Microsoft to play online and sync your profile."
                               Foreground="#6E6E72" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,36"/>
                    <Button Style="{StaticResource ExploreLaunchBtn}" Click="Login_Click" Margin="0">
                        <TextBlock Text="Sign in with Microsoft" FontSize="15" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#505054" FontSize="11" Margin="0,20,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowDeviceCode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Authorize access" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Enter this code on Microsoft's website." Foreground="#6E6E72" FontSize="14" Margin="0,0,0,28"/>
                    <TextBlock Text="{Binding UserCode}" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold"
                               FontFamily="Consolas" Margin="0,0,0,24"/>
                    <Button Content="Open browser" Style="{StaticResource ExploreNavChipActive}"
                            Click="OpenBrowser_Click" Margin="0,0,0,4"/>
                    <Button Content="Cancel" Style="{StaticResource ExploreNavChip}" Click="CancelLogin_Click"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#505054" FontSize="11" Margin="0,20,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Signed in -->
            <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Hero + skin / 3D viewer -->
                <Grid x:Name="AccountStage"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      MaxWidth="440"
                      Height="520"
                      ClipToBounds="True">

                    <StackPanel x:Name="AccountSkinPanel" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="AccountPanelTransform"/>
                        </StackPanel.RenderTransform>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="56" Height="56" CornerRadius="8" Background="#161618" ClipToBounds="True" Margin="0,0,16,0">
                                <Image Source="{Binding ProfilePicture}"
                                       Width="56" Height="56"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding MinecraftUsername}" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#6E6E72" FontSize="13" Margin="0,4,0,0">
                                    <Run Text="{Binding AccountTypeText}"/><Run Text=" · "/><Run Text="{Binding ShortUuid}" FontFamily="Consolas"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#505054" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Skin" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,28,0,12"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="ChipClassic" Content="Classic" Tag="classic" Style="{StaticResource ExploreNavPillActive}"
                                    Click="SkinModel_Click"/>
                            <Button x:Name="ChipSlim" Content="Slim" Tag="slim" Style="{StaticResource ExploreNavPill}"
                                    Click="SkinModel_Click"/>
                        </WrapPanel>

                        <Button Content="Choose skin file…" Style="{StaticResource ExploreNavChip}" Click="PickSkin_Click"/>
                        <Button Content="View current skin" Style="{StaticResource ExploreNavChip}" Click="ViewSkin_Click" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedSkinFileName}" Foreground="#505054" FontSize="11" Margin="0,8,0,0"
                                   Visibility="{Binding SelectedSkinFileName, Converter={StaticResource StrVis}}"/>

                        <Button Style="{StaticResource ExploreLaunchBtn}" Click="UploadSkin_Click" IsEnabled="{Binding CanApplySkin}">
                            <TextBlock Text="Apply" FontSize="15" FontWeight="SemiBold"/>
                        </Button>

                        <TextBlock Text="Drop a .png file anywhere on this page" Foreground="#404044" FontSize="11" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding ProfileLockMessage}" Foreground="#FF9F0A" FontSize="11" Margin="0,8,0,0"
                                   Visibility="{Binding ProfileLockMessage, Converter={StaticResource StrVis}}"/>
                        <TextBlock Text="{Binding SkinUploadStatus}" Foreground="#2563EB" FontSize="11" Margin="0,8,0,0"
                                   Visibility="{Binding SkinUploadStatus, Converter={StaticResource StrVis}}"/>

                        <WrapPanel Margin="0,28,0,0">
                            <Button Content="Refresh session" Style="{StaticResource ExploreNavPill}" Click="RefreshSession_Click" Margin="0,0,6,0"/>
                            <Button Content="Sign out" Style="{StaticResource ExploreNavPill}" Click="Logout_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Grid x:Name="SkinViewerPanel"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SkinViewerTransform" Y="-520"/>
                        </Grid.RenderTransform>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding MinecraftUsername}" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="12"
                                    Height="380" Margin="0,0,0,20">
                                <components:SkinViewer3D x:Name="SkinViewer" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <Button Content="Back" Style="{StaticResource ExploreNavChip}" Click="CloseSkinPreview_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Details list -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Details" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="Linked" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding LinkedAtText}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="Last sync" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding LastSyncText}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="Token" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding TokenExpiryText}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="Email" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding Email}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="Launcher" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <Run Text="{Binding LauncherVersion}"/><Run Text=" · "/><Run Text="{Binding LauncherChannel}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="Java" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding JavaVersion}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ExploreInstanceNav}" Cursor="Hand" MouseLeftButtonDown="CopyUuid_Click">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="UUID · click to copy" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding FormattedUuid}" Foreground="#CCE4FF" FontSize="11" FontWeight="SemiBold"
                                               Margin="0,2,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Cape" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,12"/>
                            <ItemsControl ItemsSource="{Binding CapeOptions}"
                                          Visibility="{Binding HasCapeChoices, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Cursor="Hand" MouseLeftButtonDown="CapeItem_Click" Margin="0,0,0,4" CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ExploreInstanceNav}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#141820"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#8E8E93"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="Active" Foreground="#2563EB" FontSize="10" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No capes on this account"
                                       Foreground="#505054" FontSize="11" Margin="6,0,0,0"
                                       Visibility="{Binding HasCapeChoices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <TextBlock Text="{Binding CapeStatus}" Foreground="#2563EB" FontSize="11" Margin="6,8,0,0"
                                       Visibility="{Binding CapeStatus, Converter={StaticResource StrVis}}"/>
                            <TextBlock Text="Skin and cape share the same Mojang cooldown."
                                       Foreground="#404044" FontSize="10" Margin="6,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
