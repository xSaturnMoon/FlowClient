<UserControl x:Class="Launcher.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.DataContext>
        <vm:StatsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#141416">
        <Grid Margin="48,48,48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="560">
                    <TextBlock Text="Stats" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Play time, sessions, servers, and launcher activity at a glance."
                               Foreground="#6E6E72" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,28"/>

                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                                Padding="16,14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Total play time" Foreground="#8E8E93" FontSize="11"/>
                                <TextBlock Text="{Binding HeroTotalHours}" Foreground="#FFFFFF"
                                           FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                                Padding="16,14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Sessions" Foreground="#8E8E93" FontSize="11"/>
                                <TextBlock Text="{Binding HeroSessions}" Foreground="#FFFFFF"
                                           FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                                Padding="16,14" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Streak" Foreground="#8E8E93" FontSize="11"/>
                                <TextBlock Text="{Binding HeroStreak}" Foreground="#FFFFFF"
                                           FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                                Padding="16,14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Daily average" Foreground="#8E8E93" FontSize="11"/>
                                <TextBlock Text="{Binding HeroAvgDaily}" Foreground="#FFFFFF"
                                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                                Padding="16,14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Server joins" Foreground="#8E8E93" FontSize="11"/>
                                <TextBlock Text="{Binding HeroLaunches}" Foreground="#FFFFFF"
                                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Servers played" Foreground="#8E8E93" FontSize="11"/>
                                <TextBlock Text="{Binding HeroServers}" Foreground="#FFFFFF"
                                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Weekly activity" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding PeriodSummary}" Foreground="#505054" FontSize="11"/>
                    </Grid>

                    <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="10"
                            Padding="16,16,16,12" Margin="0,0,0,24" MinHeight="140">
                        <Grid>
                            <TextBlock Text="Play Minecraft to start tracking your stats."
                                       Foreground="#505054" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasPlayData, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <ItemsControl ItemsSource="{Binding WeeklyChart}"
                                          Visibility="{Binding HasPlayData, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="2,0">
                                            <Grid Height="92" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <Border Width="24" Height="{Binding BarHeight}"
                                                        Background="#0A84FF" CornerRadius="4"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Opacity="0.9"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayValue}" Foreground="#FFFFFF"
                                                       FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Foreground="#6E6E72"
                                                       FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <TextBlock Text="Recent sessions" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding RecentSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#111113" BorderBrush="#1C1C20" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold">
                                                <Run Text="{Binding Version}"/><Run Text=" · " Foreground="#6E6E72"/>
                                                <Run Text="{Binding Loader}" Foreground="#6E6E72"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Server}" Foreground="#505054" FontSize="11" Margin="0,4,0,0"/>
                                            <TextBlock Foreground="#404044" FontSize="10" Margin="0,4,0,0">
                                                <Run Text="{Binding Start}"/><Run Text=" → "/><Run Text="{Binding End}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Duration}" Foreground="#0A84FF"
                                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Ram}" Foreground="#505054"
                                                       FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No sessions recorded yet."
                               Foreground="#505054" FontSize="12" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentSessions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Content="Back to Launch" Style="{StaticResource ExploreNavChip}"
                            HorizontalAlignment="Left" Click="BackToLaunch_Click" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="Overview" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding OverviewCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="{Binding Label}" Foreground="#8E8E93" FontSize="11"/>
                                    <TextBlock Text="{Binding Value}" Foreground="#FFFFFF"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#505054" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Top servers" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,12"/>
                <ItemsControl ItemsSource="{Binding TopServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#505054" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No servers yet." Foreground="#505054" FontSize="11" Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TopServers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Recent instances" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,12"/>
                <ItemsControl ItemsSource="{Binding TopInstances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ExploreInstanceNav}">
                                <StackPanel Margin="6,0">
                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#505054" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
