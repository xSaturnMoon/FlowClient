<UserControl x:Class="Launcher.Views.QuitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels">
    <UserControl.DataContext>
        <vm:QuitViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#141416">
        <Grid Margin="48,48,48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Text="Quit" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Close Flow and exit the launcher."
                           Foreground="#6E6E72" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,36"/>

                <Button Style="{StaticResource ExploreQuitBtn}" Click="Exit_Click" Margin="0">
                    <TextBlock Text="Exit Flow" FontSize="15" FontWeight="SemiBold"/>
                </Button>

                <Button Content="Back to Launch" Style="{StaticResource ExploreNavChip}"
                        HorizontalAlignment="Left" Click="BackToLaunch_Click" Margin="0,12,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="Details" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Version" Foreground="#8E8E93" FontSize="11"/>
                        <TextBlock Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0">
                            <Run Text="{Binding LauncherVersion}"/><Run Text=" · "/><Run Text="{Binding LauncherChannel}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Note" Foreground="#8E8E93" FontSize="11"/>
                        <TextBlock Text="Running games stay open after you quit Flow."
                                   Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
