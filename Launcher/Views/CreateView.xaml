<UserControl x:Class="Launcher.Views.CreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             Background="Transparent">
    <UserControl.DataContext>
        <vm:CreateViewModel x:Name="Vm"/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:StringToImageSourceConverter x:Key="ImgSrc"/>

        <!-- Loader Selection Capsule Button Style -->
        <Style x:Key="LoaderPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderBrush" Value="#2B2B32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#A0A0AA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25252A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3F3F48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#666672"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Version Selection Capsule Button Style -->
        <Style x:Key="VersionPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderBrush" Value="#2B2B32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#9C9C9D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25252A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3F3F48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#666672"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Create Button Style -->
        <Style x:Key="CreateMainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#101010"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="22" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="36,28,36,36" HorizontalAlignment="Center" MaxWidth="640" Width="640">
            <StackPanel>
                <!-- Title & Header -->
                <TextBlock Text="Create Installation" FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="Set up a new Minecraft instance with custom loader and version." FontSize="13"
                           FontFamily="{StaticResource NunitoFont}" Foreground="#7E7E84" Margin="0,0,0,24"/>

                <!-- 1. NAME FIELD -->
                <TextBlock Text="INSTALLATION NAME" FontSize="11" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,8"/>
                <Border Height="40" Background="#1E1E22" BorderBrush="#2B2B32" BorderThickness="1"
                        CornerRadius="20" Padding="16,0" Margin="0,0,0,22" SnapsToDevicePixels="True">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="TxtInstanceName"
                                 Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                 FontSize="13.5" FontFamily="{StaticResource NunitoFont}"
                                 CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 2. MOD LOADER SELECTION -->
                <TextBlock Text="MOD LOADER" FontSize="11" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Loaders}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LoaderPillButtonStyle}" Click="LoaderButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="#18181A" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding IconUri, Converter={StaticResource ImgSrc}}"
                                               Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. MINECRAFT VERSION SELECTION -->
                <TextBlock Text="MINECRAFT VERSION" FontSize="11" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Versions}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource VersionPillButtonStyle}" Click="VersionButton_Click">
                                <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center"
                                           Margin="0,1,0,0"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Custom Version Field -->
                <Border Height="36" Background="#1E1E22" BorderBrush="#2B2B32" BorderThickness="1"
                        CornerRadius="18" Padding="14,0" Margin="0,0,0,24" SnapsToDevicePixels="True">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCustomPlaceholder" Text="Or type any custom version (e.g. 26.1, 1.20.2)..."
                                   Foreground="#55555C" FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtCustomVersion"
                                 Text="{Binding CustomVersion, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="TxtCustomVersion_TextChanged"
                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                 FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                 CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 4. LIVE PREVIEW CAPSULE (Matching the LaunchView pill) -->
                <TextBlock Text="INSTANCE PREVIEW" FontSize="11" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,8"/>
                <Border Background="#1E1E22" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="20"
                        Height="44" Padding="14,0,16,0" Margin="0,0,0,28" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Loader Icon Container -->
                        <Border Background="#26262B" BorderBrush="#323238" BorderThickness="1"
                                CornerRadius="13" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image Source="{Binding SelectedLoaderIconUri, Converter={StaticResource ImgSrc}}"
                                   Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Instance / Version Details -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding InstanceName}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,1"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedLoaderUpper}" Foreground="#A0A0AA" FontSize="10" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text=" · " Foreground="#55555C" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedVersion}" Foreground="#7E7E84" FontSize="10" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. CREATE CTA BUTTON -->
                <Button Width="260" Height="44" Style="{StaticResource CreateMainButtonStyle}"
                        HorizontalAlignment="Left" Click="CreateInstance_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 7.5,1 L 7.5,14 M 1,7.5 L 14,7.5"
                              Stroke="#101010" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Create Installation" FontSize="13.5" FontWeight="Bold"
                                   FontFamily="{StaticResource NunitoBoldFont}" Foreground="#101010"
                                   VerticalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
