<UserControl x:Class="Launcher.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.DataContext>
        <vm:ConsoleViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <Style x:Key="ConsoleScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}">
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#131114">
        <Grid Margin="48,48,48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Console" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Launcher output, the most recent latest.log, and the latest crash report."
                               Foreground="#6E6E72" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                    <Button x:Name="ChipLauncher" Content="Launcher" Tag="launcher"
                            Style="{StaticResource ExploreNavPillActive}" Click="PanelChip_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ChipLog" Content="Latest Log" Tag="log"
                            Style="{StaticResource ExploreNavPill}" Click="PanelChip_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ChipCrash" Content="Crash Report" Tag="crash"
                            Style="{StaticResource ExploreNavPill}" Click="PanelChip_Click"/>
                </WrapPanel>

                <Border Grid.Row="2" Background="#0D0D0E" BorderBrush="#1C1C20" BorderThickness="1"
                        CornerRadius="10" Padding="0">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ConsoleScrollBar}"/>
                        </ScrollViewer.Resources>
                        <TextBox x:Name="LogOutput"
                                 Text="{Binding DisplayText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#C8C8CC"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 TextWrapping="Wrap"
                                 Padding="14,12"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="#505054" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Refresh" Style="{StaticResource ExploreNavChip}" Click="Refresh_Click" Margin="0,0,6,0"/>
                        <Button Content="Copy" Style="{StaticResource ExploreNavChip}" Click="Copy_Click" Margin="0,0,6,0"/>
                        <Button Content="Open folder" Style="{StaticResource ExploreNavChip}" Click="OpenFolder_Click"/>
                    </WrapPanel>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <StackPanel Visibility="{Binding ShowActiveFileInfo, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,20">
                    <TextBlock Text="Active file" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource ExploreInstanceNav}">
                        <StackPanel Margin="6,0">
                            <TextBlock Text="{Binding ActiveFileTitle}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveFileDetail}" Foreground="#505054" FontSize="10" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsCrashPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Recent" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding RecentCrashes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ExploreInstanceNav}" MouseLeftButtonUp="Crash_Click" Tag="{Binding}">
                                    <StackPanel Margin="6,0">
                                        <TextBlock Text="{Binding FileName}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SourceLabel}" Foreground="#6E6E72" FontSize="10" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#505054" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No crash reports." Foreground="#505054" FontSize="11" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentCrashes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="Actions" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Auto-scroll" Foreground="#8E8E93" FontSize="11"/>
                        <CheckBox Content="Follow new lines" IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                  Foreground="#FFFFFF" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="Clear launcher log" Style="{StaticResource ExploreNavChip}"
                        Click="ClearLauncher_Click" Margin="0,8,0,0"
                        Visibility="{Binding IsLauncherPanel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Back to Launch" Style="{StaticResource ExploreNavChip}"
                        Click="BackToLaunch_Click" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
