<UserControl x:Class="Launcher.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Ambient radial glow in background for depth -->
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" GradientOrigin="0.8,0.2" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#181525" Offset="0"/>
                <GradientStop Color="#0E0D11" Offset="0.85"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="36,28,36,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT: HERO & SELECTED INSTANCE SHOWCASE ══════ -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Greeting Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="{Binding Greeting}" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                    <TextBlock Text="Pronto per giocare. Seleziona un'istanza e tuffati nel mondo di Minecraft."
                               Foreground="#7D7D8B" FontSize="13" Margin="0,4,0,0" FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>

                <!-- Selected Instance Hero Card -->
                <Border Grid.Row="1" Style="{StaticResource ExploreHeroCard}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Top Row: Big Loader Badge + Titles -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="64" Height="64" CornerRadius="14" Background="#1A1924" BorderBrush="#2D2B3C" BorderThickness="1"
                                    Margin="0,0,16,0" VerticalAlignment="Center" Padding="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.4" ShadowDepth="2"/>
                                </Border.Effect>
                                <Image Source="{Binding SelectedLoaderIconUri, Converter={StaticResource ImgSrc}}"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedName}" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoFont}" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                    <Border Background="#132B1E" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="● PRONTO" Foreground="#30D158" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Foreground="#8D8D99" FontSize="13" Margin="0,4,0,0" FontFamily="{StaticResource NunitoFont}">
                                    <Run Text="{Binding SelectedVersion}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SelectedLoader}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Spec Pills -->
                        <WrapPanel Margin="0,0,0,18">
                            <Border Background="#171620" BorderBrush="#262534" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,8,6">
                                <TextBlock Foreground="#B0B0C0" FontSize="11.5" FontFamily="{StaticResource NunitoFont}">
                                    <Run Text="⚡ Modloader: " Foreground="#777785"/><Run Text="{Binding SelectedLoader}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#171620" BorderBrush="#262534" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,8,6">
                                <TextBlock Foreground="#B0B0C0" FontSize="11.5" FontFamily="{StaticResource NunitoFont}">
                                    <Run Text="💾 Memoria: " Foreground="#777785"/><Run Text="{Binding SelectedRamText}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#171620" BorderBrush="#262534" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,8,6">
                                <TextBlock Foreground="#B0B0C0" FontSize="11.5" FontFamily="{StaticResource NunitoFont}">
                                    <Run Text="⏱️ Giocato: " Foreground="#777785"/><Run Text="{Binding SelectedLastPlayed}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <!-- Instance Quick Action Pills -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Button Content="📁 Cartella Mod" Style="{StaticResource ExploreActionPill}" Click="OpenModsFolder_Click" ToolTip="Apri la cartella mods in Esplora Risorse"/>
                            <Button Content="📸 Screenshot" Style="{StaticResource ExploreActionPill}" Click="OpenScreenshotsFolder_Click" Margin="8,0,0,0" ToolTip="Apri la cartella screenshot"/>
                            <Button Content="📂 File Gioco" Style="{StaticResource ExploreActionPill}" Click="OpenGameFolder_Click" Margin="8,0,0,0" ToolTip="Apri la cartella radice di questa versione"/>
                        </StackPanel>

                        <!-- Big Glow Play Button -->
                        <Button Click="Play_Click" IsEnabled="{Binding CanPlay}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExplorePlayBtnGlow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" CornerRadius="14" SnapsToDevicePixels="True">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FF3B30" Offset="0"/>
                                                                    <GradientStop Color="#D70015" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#FF3B30" BlurRadius="24" Opacity="0.45" Direction="270" ShadowDepth="4"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#FF544B" Offset="0"/>
                                                                            <GradientStop Color="#FF3B30" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" Fill="#FFFFFF">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M8,5 L22,13 L8,21 Z"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Data" Value="M6,6 H18 V18 H6 Z"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding PlayButtonText}" FontSize="16" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Status message -->
                        <Border Background="#121826" BorderBrush="#1C2E4C" BorderThickness="1" CornerRadius="8"
                                Padding="12,7" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="●" Foreground="#0A84FF" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#89B4FA" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Empty State (No Instances) -->
                <Border Grid.Row="1" Style="{StaticResource ExploreHeroCard}" Padding="36"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Nessuna versione ancora installata" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,6"/>
                        <TextBlock Text="Crea o esplora versioni con Fabric, Forge o Vanilla in un clic."
                                   Foreground="#7E7E8B" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"
                                   FontFamily="{StaticResource NunitoFont}"/>
                        <Button Content="✨ Esplora Versioni" Style="{StaticResource ExploreNavChipActive}"
                                Height="40" Padding="20,0" FontSize="13" FontWeight="Bold"
                                HorizontalAlignment="Center" Click="GoToExplore_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════ RIGHT: PROFILE, DISCORD RPC & SERVER QUICK-PLAY ══════ -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">

                <!-- Player Identity Card -->
                <Border Background="#131218" BorderBrush="#22212B" BorderThickness="1" CornerRadius="14"
                        Padding="14,12" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonDown="PlayerCard_Click"
                        ToolTip="Clicca per aprire le impostazioni dell'Account">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.2" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Width="44" Height="44" CornerRadius="10" Background="#1C1B24" ClipToBounds="True" Margin="0,0,12,0">
                            <Image Source="{Binding PlayerAvatar}" Width="44" Height="44" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayerName}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="●" Foreground="#30D158" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Online · Flow Client" Foreground="#30D158" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="→" Foreground="#6E6E78" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Discord Rich Presence Status Card -->
                <Border Background="#12111E" BorderBrush="#252345" BorderThickness="1" CornerRadius="12"
                        Padding="12,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Discord SVG Icon -->
                        <Path Grid.Column="0" Width="20" Height="16" Stretch="Uniform" Fill="#5865F2" Margin="0,0,10,0" VerticalAlignment="Center"
                              Data="M18.9,2.8 C17.4,2.1 15.9,1.6 14.3,1.5 C14.1,1.9 13.9,2.3 13.7,2.8 C12,2.5 10.3,2.5 8.6,2.8 C8.4,2.3 8.2,1.9 8,1.5 C6.4,1.6 4.9,2.1 3.4,2.8 C0.6,6.9 0,11.2 0.3,15.4 C2.2,16.8 4,17.7 5.7,18.2 C6.2,17.6 6.6,16.9 7,16.2 C6.3,15.9 5.7,15.6 5.1,15.2 C5.3,15.1 5.4,14.9 5.6,14.8 C9.1,16.4 12.9,16.4 16.4,14.8 C16.6,14.9 16.7,15.1 16.9,15.2 C16.3,15.6 15.7,15.9 15,16.2 C15.4,16.9 15.8,17.6 16.3,18.2 C18,17.7 19.8,16.8 21.7,15.4 C22.2,10.4 21,6.1 18.9,2.8 Z M7.5,12.7 C6.4,12.7 5.6,11.7 5.6,10.5 C5.6,9.3 6.4,8.3 7.5,8.3 C8.6,8.3 9.5,9.3 9.4,10.5 C9.4,11.7 8.6,12.7 7.5,12.7 Z M14.5,12.7 C13.4,12.7 12.6,11.7 12.6,10.5 C12.6,9.3 13.4,8.3 14.5,8.3 C15.6,8.3 16.5,9.3 16.4,10.5 C16.4,11.7 15.6,12.7 14.5,12.7 Z"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Discord RPC" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            <TextBlock Text="{Binding DiscordRpcStatus}" Foreground="#8E8EB0" FontSize="10.5" FontFamily="{StaticResource NunitoFont}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#1D1B36" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="ATTIVO" Foreground="#5865F2" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Quick Play Server Hub -->
                <Border Background="#131218" BorderBrush="#22212B" BorderThickness="1" CornerRadius="14"
                        Padding="14,14,14,12">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="2,0,2,10">
                            <TextBlock Text="SERVER PREFERITI" Foreground="#8E8E98" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="⚡ AVVIO RAPIDO" Foreground="#0A84FF" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Empty State -->
                        <StackPanel Visibility="{Binding ShowServersEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,8,0,8" HorizontalAlignment="Center">
                            <TextBlock Text="Nessun server salvato nei preferiti." Foreground="#6E6E78" FontSize="12"
                                       HorizontalAlignment="Center" FontFamily="{StaticResource NunitoFont}"/>
                            <TextBlock Text="Aggiungi server in Esplora per avviarli qui con 1 clic!"
                                       Foreground="#505058" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,10"
                                       FontFamily="{StaticResource NunitoFont}"/>
                            <Button Content="Sfoglia Server" Style="{StaticResource ExploreNavChipActive}"
                                    Height="28" Padding="14,0" FontSize="11" FontWeight="SemiBold"
                                    HorizontalAlignment="Center" Click="GoToExplore_Click"/>
                        </StackPanel>

                        <!-- Server List -->
                        <ItemsControl ItemsSource="{Binding FavoriteServers}"
                                      Visibility="{Binding HasServers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ExploreServerCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Style="{StaticResource ExploreIconBadge}" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold"
                                                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                                <TextBlock Text="{Binding Address}" FontSize="10.5" Foreground="#6E6E78"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                            </StackPanel>

                                            <!-- Instant Play Button -->
                                            <Button Grid.Column="2" Content="⚡ Entra" Tag="{Binding}" Click="ServerPlay_Click"
                                                    Style="{StaticResource ExploreNavChipActive}" Height="26" Padding="8,0" FontSize="10.5"
                                                    FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    ToolTip="Avvia Minecraft ed entra direttamente in questo server"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
