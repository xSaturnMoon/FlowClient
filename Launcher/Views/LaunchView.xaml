<UserControl x:Class="Launcher.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>

            <!-- Sleek Edge Navigation Arrow Buttons (< and >) — transparent, no plate -->
            <Style x:Key="HomeNavArrowButton" TargetType="Button">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="root" Background="Transparent">
                                <ContentPresenter x:Name="icon" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="icon" Property="Opacity" Value="1.0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="icon" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Update Button Style — transparent, no plate -->
            <Style x:Key="HomeCornerActionButton" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter x:Name="icon" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="icon" Property="Opacity" Value="1.0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="icon" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quit Button Style — transparent, red glow on hover -->
            <Style x:Key="HomeQuitButton" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter x:Name="icon" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="icon" Property="Opacity" Value="1.0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="icon" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent" ClipToBounds="True">
        <Grid.RowDefinitions>
            <!-- Row 0: Central Stage (midpoint between top bar and launch dock) -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Bottom Launch Dock & Controls -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════ ROW 0: CENTRAL STAGE (3D MINECRAFT OBJECT & EDGE ARROWS) ══════ -->
        <Grid Grid.Row="0">

            <!-- Real Hardware-Accelerated 3D Viewport with Drag-to-Rotate -->
            <Viewport3D x:Name="ModelViewport" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="440" Height="440" Margin="0"
                        MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove"
                        MouseUp="Viewport_MouseUp" Cursor="Hand"
                        ToolTip="Click and drag to rotate in 3D">
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0, 0.45, 5.4" LookDirection="0, -0.1, -5.4" UpDirection="0, 1, 0" FieldOfView="40"/>
                </Viewport3D.Camera>

                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <!-- Voxel Lighting -->
                            <AmbientLight Color="#909090"/>
                            <DirectionalLight Color="#FFFFFF" Direction="-1.2, -2.5, -2.0"/>
                            <DirectionalLight Color="#4A4A4A" Direction="1.2, 1.2, 2.0"/>

                            <!-- Dynamic 3D Model with Pitch, Yaw, Bobbing & Scale transforms -->
                            <Model3DGroup x:Name="Mascot3DGroup">
                                <Model3DGroup.Transform>
                                    <Transform3DGroup>
                                        <ScaleTransform3D x:Name="ModelScale" ScaleX="1" ScaleY="1" ScaleZ="1"/>
                                        <RotateTransform3D>
                                            <RotateTransform3D.Rotation>
                                                <AxisAngleRotation3D x:Name="PitchRotation" Axis="1,0,0" Angle="20"/>
                                            </RotateTransform3D.Rotation>
                                        </RotateTransform3D>
                                        <RotateTransform3D>
                                            <RotateTransform3D.Rotation>
                                                <AxisAngleRotation3D x:Name="YawRotation" Axis="0,1,0" Angle="35"/>
                                            </RotateTransform3D.Rotation>
                                        </RotateTransform3D>
                                        <TranslateTransform3D x:Name="BobTranslate" OffsetX="0" OffsetY="0" OffsetZ="0"/>
                                    </Transform3DGroup>
                                </Model3DGroup.Transform>
                            </Model3DGroup>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>

            <!-- Navigation Arrows: Exactly Vertically Centered in Row 0 at Same Centerline as 3D Model -->
            <Button Style="{StaticResource HomeNavArrowButton}" Click="PreviousVersion_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0"
                    ToolTip="Previous Version">
                <Path Data="M 15,10 L 9,16 L 15,22" Stroke="#8E92A4" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="14" Height="16" Stretch="Uniform"/>
            </Button>

            <Button Style="{StaticResource HomeNavArrowButton}" Click="NextVersion_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"
                    ToolTip="Next Version">
                <Path Data="M 9,10 L 15,16 L 9,22" Stroke="#8E92A4" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="14" Height="16" Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- ══════ ROW 1: BOTTOM LAUNCH DOCK & VERSION DISPLAY ══════ -->
        <Grid Grid.Row="1" Margin="0,0,0,26">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Upgraded Selected Version Showcase Card -->
                <Border Background="#181923" BorderBrush="#2A2C3E" BorderThickness="1" CornerRadius="12"
                        Padding="14,8" Margin="0,0,0,12" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Loader Icon Container -->
                        <Border x:Name="LoaderBadgeBorder" Background="#222434" BorderBrush="#32354A" BorderThickness="1"
                                CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="{Binding SelectedLoaderIconUri, Converter={StaticResource ImgSrc}}"
                                   Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Instance / Version Details -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectedName}" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtLoaderBadge" Text="FABRIC" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text=" · " Foreground="#525464" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedVersion}" Foreground="#8E92A4" FontSize="11.5" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status message capsule (visible when downloading or launching) -->
                <Border Background="#141926" BorderBrush="#1E2A42" BorderThickness="1" CornerRadius="8"
                        Padding="12,5" Margin="0,0,0,10" HorizontalAlignment="Center"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#3B82F6" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Big Vibrant LAUNCH Button -->
                <Button Width="380" Height="56" Click="Play_Click" IsEnabled="{Binding CanPlay}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TopNavLaunchButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" CornerRadius="14" SnapsToDevicePixels="True" Background="#DC2626">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.25" Direction="270" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#EF4444"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding PlayButtonText}" FontSize="18" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoFont}" Foreground="#FFFFFF"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════ BOTTOM-LEFT: QUIT LAUNCHER BUTTON ══════ -->
        <Button Style="{StaticResource HomeQuitButton}" Click="Quit_Click"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,26"
                ToolTip="Quit Flow Client">
            <Path Data="M12,3 L12,12 M6.34,5.64 A8,8 0 1,0 17.66,5.64"
                  Stroke="#8E92A4" StrokeThickness="1.7" Fill="Transparent"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="17" Height="17" Stretch="Uniform"/>
        </Button>

        <!-- ══════ BOTTOM-RIGHT: ANIMATED UPDATE BUTTON ══════ -->
        <Button x:Name="BtnUpdate" Style="{StaticResource HomeCornerActionButton}" Click="Update_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26"
                ToolTip="Check for Updates">
            <Grid Width="18" Height="18">
                <!-- 1. Outer Circle of Update Icon -->
                <Path x:Name="OuterCircle"
                      Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z"
                      StrokeThickness="1.6" Fill="Transparent"
                      Stroke="#8E92A4"
                      Width="18" Height="18" Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="OuterCircleScale" ScaleX="1" ScaleY="1"/>
                    </Path.RenderTransform>
                </Path>

                <!-- 2. Inner Down Arrow -->
                <Path x:Name="IconUpdateArrow"
                      Data="M2,2 M22,22 M12,8.5 L12,14.5 M9,12.5 L12,15.5 L15,12.5"
                      StrokeThickness="1.6" Fill="Transparent"
                      Stroke="#8E92A4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="18" Height="18" Stretch="Uniform"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="UpdateArrowScale" ScaleX="1" ScaleY="1"/>
                    </Path.RenderTransform>
                </Path>

                <!-- 3. Spinning arc (Windows 11 boot style) -->
                <Path x:Name="OuterCircleSpinner"
                      Data="M2,2 M22,22 M12,2 A10,10 0 0,1 22,12"
                      StrokeThickness="1.8" Fill="Transparent"
                      Stroke="#3B82F6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="18" Height="18" Stretch="Uniform"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SpinnerScale" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>

                <!-- 4. Checkmark (✓) -->
                <Path x:Name="IconCheckmark"
                      Data="M4,12 L9,17 L20,6"
                      StrokeThickness="1.8" Fill="Transparent"
                      Stroke="#22C55E"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="18" Height="18" Stretch="Uniform"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CheckmarkScale" ScaleX="0" ScaleY="0"/>
                            <RotateTransform x:Name="CheckmarkRotate" Angle="-35"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>

                <!-- 5. Cross (✕) -->
                <Path x:Name="IconCross"
                      Data="M4,4 L20,20 M20,4 L4,20"
                      StrokeThickness="1.8" Fill="Transparent"
                      Stroke="#8E92A4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="18" Height="18" Stretch="Uniform"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CrossScale" ScaleX="0" ScaleY="0"/>
                            <RotateTransform x:Name="CrossRotate" Angle="90"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Button>

    </Grid>
</UserControl>
