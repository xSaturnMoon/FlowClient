    <UserControl x:Class="Launcher.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#131114">
        <Grid Margin="48,48,48,56">
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Hero + Play -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="{Binding Greeting}" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Select a version and launch Minecraft." Foreground="#6E6E72" FontSize="14" Margin="0,0,0,36"/>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource ExploreIconBadge}" Width="56" Height="56" Padding="10" Margin="0,0,16,0">
                                <Image Source="{Binding SelectedLoaderIconUri, Converter={StaticResource ImgSrc}}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedName}" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#6E6E72" FontSize="13" Margin="0,4,0,0">
                                    <Run Text="{Binding SelectedVersion}"/><Run Text=" · "/><Run Text="{Binding SelectedLoader}"/>
                                </TextBlock>
                                <TextBlock Foreground="#505054" FontSize="12" Margin="0,6,0,0">
                                    <Run Text="{Binding SelectedRamText}"/><Run Text=" · Last played "/><Run Text="{Binding SelectedLastPlayed}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource ExploreLaunchBtn}" Click="Play_Click" IsEnabled="{Binding CanPlay}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,12,0" Fill="#FFFFFF">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M8,5 L20,12 L8,19 Z"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Data" Value="M6,6 H18 V18 H6 Z"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding PlayButtonText}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="No versions yet" Foreground="#505054" FontSize="14" Margin="0,0,0,16"/>
                        <Button Content="Create a version in Explore" Style="{StaticResource ExploreNavChipActive}"
                                HorizontalAlignment="Left" Click="GoToExplore_Click"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#505054" FontSize="11" Margin="0,20,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
                </StackPanel>

                <!-- Versions + Favorites -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Versions" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding Instances}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ExploreInstanceNav}"
                                                Tag="{Binding Id}" MouseLeftButtonDown="Instance_Click">
                                            <Grid Margin="6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource ExploreIconBadge}" Margin="0,0,12,0">
                                                    <Image Source="{Binding LoaderIconUri, Converter={StaticResource ImgSrc}}" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#505054"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#CCE4FF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding Loader}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Margin="0,24,0,0"
                            BorderBrush="#1C1C20"
                            BorderThickness="0,1,0,0"
                            Padding="0,20,0,0">
                        <StackPanel>
                            <Border Background="Transparent"
                                    Cursor="Hand"
                                    Padding="0,0,0,12"
                                    MouseLeftButtonDown="ToggleServers_Click">
                                <Grid>
                                    <TextBlock Text="Favorites"
                                               Foreground="#8E8E93"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                    <Path Width="10" Height="6"
                                          Stretch="Uniform"
                                          Stroke="#6E6E72"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M1,1 L5.5,5.5 L10,1"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ServersChevronRotate" Angle="180"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="ServersDrawer"
                                        Visibility="Collapsed"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                <TextBlock Text="No favorite servers yet"
                                           Foreground="#505054"
                                           FontSize="13"
                                           Margin="6,4,0,0"
                                           Visibility="{Binding ShowServersEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding FavoriteServers}"
                                              Visibility="{Binding HasServers, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ServerRow"
                                                    Style="{StaticResource ExploreInstanceNav}"
                                                    Margin="0,0,0,4">
                                                <Grid Margin="6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Style="{StaticResource ExploreIconBadge}" Margin="0,0,12,0">
                                                        <Image Source="{Binding Icon}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Address}"
                                                                   FontSize="11"
                                                                   Foreground="#505054"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="×"
                                                                Tag="{Binding}"
                                                                Click="ToggleFavorite_Click"
                                                                x:Name="UnfavoriteBtn"
                                                                Style="{StaticResource ExploreFavoriteRowRemoveBtn}"
                                                                ToolTip="Remove from favorites"/>
                                                        <Button Content="Play"
                                                                Tag="{Binding}"
                                                                Click="ServerPlay_Click"
                                                                x:Name="PlayBtn"
                                                                Style="{StaticResource ExploreFavoriteRowPlayBtn}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="PlayBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="UnfavoriteBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="PlayBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="UnfavoriteBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
        </Grid>
    </Grid>
</UserControl>
