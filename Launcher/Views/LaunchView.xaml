<UserControl x:Class="Launcher.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#0C0D14" ClipToBounds="True">
        <!-- ══════ CENTRAL STAGE: FLOATING GEOMETRY & 3D MASCOT ══════ -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Floating Geometric Accent Frames (Behind Mascot) -->
            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="0" Height="0">
                <!-- Frame 1: Top-Left Large -->
                <Border Canvas.Left="-230" Canvas.Top="-150" Width="135" Height="135"
                        BorderBrush="#1E273A" BorderThickness="4" Background="#0A111E" Opacity="0.8"/>

                <!-- Frame 2: Mid-Left -->
                <Border Canvas.Left="-270" Canvas.Top="35" Width="100" Height="100"
                        BorderBrush="#1B2334" BorderThickness="3" Background="#0A111E" Opacity="0.75"/>

                <!-- Tile 3: Small Left-Bottom -->
                <Border Canvas.Left="-130" Canvas.Top="140" Width="40" Height="40"
                        Background="#172030" Opacity="0.6"/>

                <!-- Tile 4: Top-Center Small -->
                <Border Canvas.Left="70" Canvas.Top="-175" Width="68" Height="68"
                        Background="#1A2436" Opacity="0.65"/>

                <!-- Frame 5: Top-Right -->
                <Border Canvas.Left="155" Canvas.Top="-115" Width="95" Height="95"
                        BorderBrush="#1C2436" BorderThickness="3" Background="#0A111E" Opacity="0.75"/>

                <!-- Tile 6: Middle-Right -->
                <Border Canvas.Left="125" Canvas.Top="15" Width="65" Height="65"
                        Background="#182132" Opacity="0.6"/>

                <!-- Frame 7: Right-Center -->
                <Border Canvas.Left="235" Canvas.Top="45" Width="80" Height="80"
                        BorderBrush="#1D2638" BorderThickness="3" Background="#0A111E" Opacity="0.7"/>

                <!-- Tile 8: Far-Right Small -->
                <Border Canvas.Left="330" Canvas.Top="-15" Width="36" Height="36"
                        Background="#172030" Opacity="0.55"/>
            </Canvas>

            <!-- ─── 3D CUBIC MASCOT HEAD WITH CUTE EYES & IDLE BOBBING ─── -->
            <Grid Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-45,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MascotFloat" Y="0"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MascotFloat"
                                                 Storyboard.TargetProperty="Y"
                                                 From="-8" To="8" Duration="0:0:3"
                                                 AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <!-- Mascot Isometric Cube -->
                <Canvas Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Top Face (Perspective light slate) -->
                    <Polygon Points="38,45 68,15 208,15 178,45" Fill="#6F727D"/>

                    <!-- Left Side Face (Perspective shaded slate) -->
                    <Polygon Points="38,45 68,15 68,155 38,185" Fill="#484B54"/>

                    <!-- Top-Left Tuft Accent -->
                    <Border Canvas.Left="58" Canvas.Top="9" Width="20" Height="8" Background="#6F727D"/>

                    <!-- Front Face (Main cubic face with block eyes) -->
                    <Border Canvas.Left="38" Canvas.Top="45" Width="140" Height="140" Background="#5B5D67" CornerRadius="1">
                        <Grid>
                            <!-- Stone Texture pixel patches -->
                            <Canvas Width="140" Height="140">
                                <Border Canvas.Left="12" Canvas.Top="12" Width="18" Height="18" Background="#4F515B"/>
                                <Border Canvas.Left="80" Canvas.Top="8" Width="24" Height="16" Background="#666874"/>
                                <Border Canvas.Left="10" Canvas.Top="115" Width="22" Height="16" Background="#4E5059"/>
                                <Border Canvas.Left="60" Canvas.Top="122" Width="28" Height="12" Background="#636571"/>
                                <Border Canvas.Left="115" Canvas.Top="110" Width="16" Height="20" Background="#4E5059"/>
                            </Canvas>

                            <!-- Left Eye (Big cartoon block eye) -->
                            <Border Width="34" Height="58" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="24,38,0,0">
                                <Border Width="18" Height="40" Background="#111216" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,0,0"/>
                            </Border>

                            <!-- Right Eye (Big cartoon block eye) -->
                            <Border Width="34" Height="58" Background="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,38,24,0">
                                <Border Width="18" Height="40" Background="#111216" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="0,0,0,0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>

        <!-- ══════ BOTTOM LAUNCH DOCK ══════ -->
        <Grid VerticalAlignment="Bottom" Margin="0,0,0,42">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Status message capsule (visible when downloading or launching) -->
                <Border Background="#141926" BorderBrush="#1E2A42" BorderThickness="1" CornerRadius="8"
                        Padding="12,5" Margin="0,0,0,10" HorizontalAlignment="Center"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#3B82F6" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Big Blue LAUNCH Button -->
                <Button Width="380" Height="56" Click="Play_Click" IsEnabled="{Binding CanPlay}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TopNavLaunchButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" CornerRadius="14" SnapsToDevicePixels="True" Background="#DC2626">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.25" Direction="270" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#EF4444"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding PlayButtonText}" FontSize="18" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoFont}" Foreground="#FFFFFF"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
