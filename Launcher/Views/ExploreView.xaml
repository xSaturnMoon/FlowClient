<UserControl x:Class="Launcher.Views.ExploreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             xmlns:components="clr-namespace:Launcher.Components">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
            <conv:StringToBrushConverter x:Key="ColorBrush"/>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
            <conv:BoolToModToggleLabelConverter x:Key="ModEnabledLabel"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">

        <!-- ══════════════ 1. CREATE INSTANCE SCREEN ══════════════ -->
        <Grid Margin="48,36,48,28"
              Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
                <TextBlock Text="Create Instance" Foreground="#FFFFFF" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Choose a name, mod loader, and Minecraft version to get started."
                           Foreground="#6E6E72" FontSize="13.5" Margin="0,0,0,28"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Name, Type, Loader -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Instance Name" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ExploreSearchBox}" Text="{Binding NewName}" Margin="0,0,0,20"/>

                        <TextBlock Text="Version Type" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,20">
                            <Button x:Name="ChipRelease" Content="Release" Tag="release" Style="{StaticResource ExploreNavPillActive}" Click="VersionType_Click"/>
                            <Button x:Name="ChipSnapshot" Content="Snapshot" Tag="snapshot" Style="{StaticResource ExploreNavPill}" Click="VersionType_Click"/>
                            <Button x:Name="ChipBeta" Content="Beta" Tag="old_beta" Style="{StaticResource ExploreNavPill}" Click="VersionType_Click"/>
                            <Button x:Name="ChipAlpha" Content="Alpha" Tag="old_alpha" Style="{StaticResource ExploreNavPill}" Click="VersionType_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Mod Loader" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,28">
                            <Button x:Name="LoaderVanilla" Content="Vanilla" Tag="Vanilla" Style="{StaticResource ExploreNavPill}" Click="LoaderChip_Click"/>
                            <Button x:Name="LoaderFabric" Content="Fabric" Tag="Fabric" Style="{StaticResource ExploreNavPillActive}" Click="LoaderChip_Click"/>
                            <Button x:Name="LoaderForge" Content="Forge" Tag="Forge" Style="{StaticResource ExploreNavPill}" Click="LoaderChip_Click"/>
                            <Button x:Name="LoaderNeo" Content="NeoForge" Tag="NeoForge" Style="{StaticResource ExploreNavPill}" Click="LoaderChip_Click"/>
                            <Button x:Name="LoaderQuilt" Content="Quilt" Tag="Quilt" Style="{StaticResource ExploreNavPill}" Click="LoaderChip_Click"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create Instance" Style="{StaticResource ExploreBtnPrimary}" Padding="24,10"
                                    Click="ConfirmCreate_Click" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Style="{StaticResource ExploreHeaderActionBtn}" Padding="16,10"
                                    Click="CancelCreate_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Minecraft version search & list -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Minecraft Version" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource ExploreSearchBox}" Text="{Binding VersionSearch, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="VersionSearch_TextChanged" Margin="0,0,0,10"/>
                        <Grid>
                            <ListBox x:Name="VersionList" Style="{StaticResource ExploreVersionList}" Height="300"
                                     ItemsSource="{Binding FilteredVersions}" SelectedItem="{Binding NewVersion, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ExploreVersionListItem}"
                                     SelectionChanged="VersionList_SelectionChanged"/>
                            <TextBlock Text="Loading versions..." Foreground="#505054" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ══════════════ 2. EMPTY STATE (No instances) ══════════════ -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="64" Height="64" CornerRadius="16" Background="#121216" BorderBrush="#1C1C24" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                      Stroke="#4E4E58" StrokeThickness="1.8" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="No Instances Yet" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" TextAlignment="Center"/>
            <TextBlock Text="Create your first Minecraft instance to start playing and installing mods."
                       Foreground="#6E6E73" FontSize="13" TextAlignment="Center" Margin="0,6,0,24" MaxWidth="380" TextWrapping="Wrap"/>
            <Button Content="+ Create Instance" Style="{StaticResource ExploreBtnPrimary}" Padding="24,10" HorizontalAlignment="Center"
                    Click="NewInstance_Click"/>
        </StackPanel>

        <!-- ══════════════ 3. GLOBAL TEXTURES / SHADERS PANEL ══════════════ -->
        <Grid Margin="48,36,48,28"
              Visibility="{Binding ShowGlobalPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding GlobalPanelTitle}" Foreground="#FFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding GlobalPanelSubtitle}" Foreground="#6E6E72" FontSize="13"/>
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📁 Open Folder" Style="{StaticResource ExploreHeaderActionBtn}" Click="OpenGlobalFolder_Click" Margin="0,0,8,0"/>
                        <Button Content="➕ Add File" Style="{StaticResource ExploreHeaderActionBtn}" Click="AddGlobalFile_Click"/>
                    </WrapPanel>
                </Grid>
            </StackPanel>

            <!-- Installed list -->
            <Border Grid.Row="1" Style="{StaticResource ExploreCatalogPane}" Margin="0,0,0,14" MaxHeight="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Installed" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <TextBlock Text="No items installed" Foreground="#505054" FontSize="12"
                                       Visibility="{Binding HasNoGlobalInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding GlobalInstalled}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource ModRemoveBtn}"
                                                    Tag="{Binding FileName}" Click="RemoveGlobal_Click" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <components:CatalogBrowserPanel x:Name="GlobalCatalogBrowser" Grid.Row="2"
                                            InstallCompleted="CatalogBrowser_InstallCompleted"/>

            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#505054" FontSize="11" Margin="0,10,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
        </Grid>

        <!-- ══════════════ 4. MAIN 2-COLUMN VIEW (MATCHING ACCOUNTVIEW) ══════════════ -->
        <Grid Margin="48,36,48,28"
              Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT COLUMN: ACTIVE INSTANCE & CONTENT ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Instance Header & Play Action -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" Background="#161618" Padding="7" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image Source="{Binding DetailLoaderIconUri, Converter={StaticResource ImgSrc}}" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetailName}" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border Background="#16161C" BorderBrush="#252530" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding DetailVersion}" Foreground="#D4D4D8" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#132034" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding DetailLoader}" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#16161C" BorderBrush="#252530" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                <TextBlock Text="{Binding DetailModCount, StringFormat={}{0} mods installed}" Foreground="#8E8E93" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶ Launch" Style="{StaticResource ExploreBtnPrimary}" Height="40" Padding="26,0" FontSize="14" FontWeight="SemiBold"
                                Click="Play_Click" Margin="0,0,10,0"/>
                        <Button Content="📁 Folder" Style="{StaticResource ExploreHeaderActionBtn}" Height="40" Padding="14,0"
                                Click="OpenFolder_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Subtabs Switcher (Installed Mods / Browse Modrinth) -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                    <Button x:Name="TabCatalog" Content="Installed Mods" Tag="catalog" Style="{StaticResource ExploreNavPillActive}" Click="Tab_Click"
                            Visibility="{Binding ShowModsTabs, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button x:Name="TabMods" Content="Browse Modrinth" Tag="mods" Style="{StaticResource ExploreNavPill}" Click="Tab_Click"
                            Visibility="{Binding ShowModsTabs, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </WrapPanel>

                <!-- Content Area -->
                <Grid Grid.Row="2">
                    <!-- Vanilla instance info card -->
                    <Border Background="#111115" BorderBrush="#1C1C24" BorderThickness="1" CornerRadius="12" Padding="32,28"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowModsTabs, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                            <Border Width="52" Height="52" CornerRadius="14" Background="#181822" BorderBrush="#262634" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                                      Stroke="#60A5FA" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Vanilla Minecraft" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" TextAlignment="Center"/>
                            <TextBlock Text="This instance runs standard official Vanilla Minecraft without a mod loader. Ready to play immediately, or create a Fabric or Forge instance to install mods."
                                       Foreground="#71717A" FontSize="12.5" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Modded Content (Fabric / Forge / etc.) -->
                    <Grid Visibility="{Binding ShowModsTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Tab 1: Installed Mods -->
                        <Grid Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                        <!-- Search box -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBox Style="{StaticResource ExploreSearchBox}" Height="38"
                                     Text="{Binding ModSearch, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="ModSearch_TextChanged"/>
                            <TextBlock Text="Search installed mods..." Foreground="#52525A" FontSize="12" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Mods list -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                            </ScrollViewer.Resources>
                            <StackPanel>
                                <!-- Empty State -->
                                <Border Background="#111115" BorderBrush="#1C1C24" BorderThickness="1" CornerRadius="12" Padding="32,28"
                                        Visibility="{Binding HasNoInstalledMods, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="52" Height="52" CornerRadius="14" Background="#181822" BorderBrush="#262634" BorderThickness="1"
                                                HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <Path Data="M20,6 H12 L10,4 H4 A2,2 0 0,0 2,6 V18 A2,2 0 0,0 4,20 H20 A2,2 0 0,0 22,18 V8 A2,2 0 0,0 20,6 Z"
                                                  Stroke="#60A5FA" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="No mods installed" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" TextAlignment="Center"/>
                                        <TextBlock Text="Browse and install mods directly from Modrinth with one click."
                                                   Foreground="#71717A" FontSize="12.5" TextAlignment="Center" Margin="0,4,0,16"/>
                                        <Button Content="Browse Modrinth" Style="{StaticResource ExploreBtnPrimary}" Padding="20,9" HorizontalAlignment="Center"
                                                Click="GoToModrinth_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Installed Mods Cards -->
                                <ItemsControl ItemsSource="{Binding Mods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111114" BorderBrush="#1A1A22" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#181820" Padding="4" Margin="0,0,12,0" ClipToBounds="True">
                                                        <Image Source="{Binding IconUrl, Converter={StaticResource ImgSrc}}" Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Foreground="#71717A" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding VersionNumber}"/><Run Text=" · "/><Run Text="{Binding FileName}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{Binding Enabled, Converter={StaticResource ModEnabledLabel}}" Style="{StaticResource ModToggleBtn}"
                                                                Tag="{Binding FileName}" Click="ToggleMod_Click" Margin="0,0,8,0"/>
                                                        <Button Content="Remove" Style="{StaticResource ModRemoveBtn}"
                                                                Tag="{Binding FileName}" Click="RemoveMod_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Tab 2: Browse Modrinth -->
                    <components:CatalogBrowserPanel x:Name="InstanceCatalogBrowser"
                                                    Visibility="{Binding ShowCatalogBrowser, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    InstallCompleted="CatalogBrowser_InstallCompleted"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ── RIGHT COLUMN: DETAILS & SETTINGS (MATCHING ACCOUNTVIEW) ── -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="Details &amp; Settings" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>

                        <!-- Card 1: Switch Instance -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Instances" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="AttachModpackBtn" Content="Import" Style="{StaticResource ExploreNavPill}" Height="22" Padding="8,0" FontSize="11"
                                                Margin="0,0,4,0" Click="AttachModpack_Click"/>
                                        <Button Content="+ New" Style="{StaticResource ExploreNavPillActive}" Height="22" Padding="8,0" FontSize="11"
                                                Click="NewInstance_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsControl ItemsSource="{Binding Instances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Tag="{Binding Id}" MouseLeftButtonDown="InstanceCard_Click" Cursor="Hand"
                                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#16161A"/>
                                                            <Setter Property="BorderBrush" Value="#22222A"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#132034"/>
                                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1A1A22"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#181820" Padding="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Image Source="{Binding LoaderIconUri, Converter={StaticResource ImgSrc}}" Stretch="Uniform"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Foreground="#71717A" FontSize="10.5">
                                                                <Run Text="{Binding Version}"/><Run Text=" · "/><Run Text="{Binding Loader}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" VerticalAlignment="Center" Background="#1C1C24" CornerRadius="4" Padding="5,2">
                                                            <TextBlock Text="{Binding ModCount, StringFormat={}{0} mods}" Foreground="#8E8E93" FontSize="10"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Memory (RAM) -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Allocated Memory" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EditRam, StringFormat={}{0} MB}" Foreground="#60A5FA" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Style="{StaticResource ExploreSlider}" Minimum="1024" Maximum="16384"
                                        TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding EditRam}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="2 GB" Tag="2048" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="RamPreset_Click"/>
                                    <Button Content="4 GB" Tag="4096" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="RamPreset_Click"/>
                                    <Button Content="6 GB" Tag="6144" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="RamPreset_Click"/>
                                    <Button Content="8 GB" Tag="8192" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="RamPreset_Click"/>
                                    <Button Content="12 GB" Tag="12288" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="RamPreset_Click"/>
                                    <Button Content="16 GB" Tag="16384" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="RamPreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Game Window & Resolution -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Game Window" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#60A5FA" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right">
                                        <Run Text="{Binding EditWidth}"/><Run Text="×"/><Run Text="{Binding EditHeight}"/>
                                    </TextBlock>
                                </Grid>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="720p" Tag="1280x720" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="ResPreset_Click"/>
                                    <Button Content="1080p" Tag="1920x1080" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="ResPreset_Click"/>
                                    <Button Content="1440p" Tag="2560x1440" Style="{StaticResource ExploreNavPill}" Height="24" Padding="8,0" Margin="0,0,4,4" Click="ResPreset_Click"/>
                                </WrapPanel>
                                <CheckBox Content="Fullscreen mode" Style="{StaticResource ExploreToggle}" IsChecked="{Binding EditFullscreen}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: JVM Arguments -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="JVM Arguments (Optional)" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ExploreSearchBox}" Text="{Binding EditJvmArgs}"
                                         AcceptsReturn="True" MinHeight="42" MaxHeight="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Actions & Save -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Instance Actions" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Duplicate" Style="{StaticResource ExploreNavPill}" Height="26" Padding="12,0" Margin="0,0,6,0" Click="Duplicate_Click"/>
                                    <Button Content="Delete" Style="{StaticResource ExploreNavPill}" Height="26" Padding="12,0" Foreground="#FF6B6B" Click="Delete_Click"/>
                                </WrapPanel>
                                <Button Content="Save Settings" Style="{StaticResource ExploreBtnPrimary}" Height="34" Padding="16,0"
                                        Click="SaveSettings_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="11.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource StrVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 6: Shared Resources -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Shared Resources" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="GlobalTexturesBtn" Content="Global Textures" Style="{StaticResource ExploreGlobalNavChip}" Click="GlobalTextures_Click" Margin="0,0,6,4"/>
                                    <Button x:Name="GlobalShadersBtn" Content="Global Shaders" Style="{StaticResource ExploreGlobalNavChip}" Click="GlobalShaders_Click" Margin="0,0,0,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
