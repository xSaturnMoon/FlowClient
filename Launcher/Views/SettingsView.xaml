                                    <Button Style="{StaticResource RamChipButton}" Content="Aikar Flags" Click="JvmPreset_Click" Tag="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC"/>
