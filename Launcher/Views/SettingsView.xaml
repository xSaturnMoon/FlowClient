                                <Button Content="Copy" Style="{StaticResource ActionPillButtonStyle}" Click="CopyPath_Click" Tag="{Binding ModsDirectory}" Margin="0,0,8,0"/>
                                <Button Content="Open" Style="{StaticResource PrimaryActionPillButtonStyle}" Click="OpenModsDir_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

