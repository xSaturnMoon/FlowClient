                                    <Border Background="#1C1D24" CornerRadius="4" Padding="7,3" Margin="0,0,6,6"><TextBlock Text="✓ Keystrokes" Foreground="#A0A5B5" FontSize="10.5" FontWeight="SemiBold"/></Border>
