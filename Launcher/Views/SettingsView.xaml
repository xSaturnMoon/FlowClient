<UserControl x:Class="Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FlowClient;component/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>

            <!-- Category Tab Button Style -->
            <Style x:Key="SettingsCategoryTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#8E8E93"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#16161A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Specific Category Tab Active Styles -->
            <Style x:Key="CatLaunchTabStyle" TargetType="Button" BasedOn="{StaticResource SettingsCategoryTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLaunchCategory}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CatPerformanceTabStyle" TargetType="Button" BasedOn="{StaticResource SettingsCategoryTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPerformanceCategory}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CatFoldersTabStyle" TargetType="Button" BasedOn="{StaticResource SettingsCategoryTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFoldersCategory}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CatStorageTabStyle" TargetType="Button" BasedOn="{StaticResource SettingsCategoryTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStorageCategory}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CatAboutTabStyle" TargetType="Button" BasedOn="{StaticResource SettingsCategoryTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAboutCategory}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Launch action option card style -->
            <Style x:Key="LaunchActionCard" TargetType="Button">
                <Setter Property="Background" Value="#141417"/>
                <Setter Property="BorderBrush" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,13"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#35353E"/>
                                    <Setter TargetName="b" Property="Background" Value="#19191E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom Modern Radio Button for Launch Action -->
            <Style x:Key="ModernActionRadioButton" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="#55555C" Background="Transparent" SnapsToDevicePixels="True">
                                <Ellipse x:Name="InnerDot" Width="10" Height="10" Fill="#FFFFFF" Visibility="Collapsed"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OuterCircle" Property="BorderBrush" Value="#FFFFFF"/>
                                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Animated Toggle Switch Style -->
            <Style x:Key="ModernToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="46" Height="26" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="13" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="TrackBrush" Color="#28282E"/>
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="Knob" Width="20" Height="20"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"
                                         SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="KnobBrush" Color="#6E6E76"/>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslate" X="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#FFFFFF"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="#121214"/>
                                    <Setter TargetName="Knob" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="20"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Knob"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="20" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFFFFF" Duration="0:0:0.18"/>
                                                <ColorAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                To="#121214" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Knob"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#28282E" Duration="0:0:0.18"/>
                                                <ColorAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                To="#6E6E76" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Custom Ram Slider Style -->
            <Style x:Key="ModernRamSliderStyle" TargetType="Slider">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" Background="#28282E" CornerRadius="3" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" Background="#FFFFFF" CornerRadius="3,0,0,3" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Ellipse x:Name="thumbCircle" Width="18" Height="18" Fill="#FFFFFF"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.45" Color="#000000"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbCircle" Property="Width" Value="20"/>
                                                            <Setter TargetName="thumbCircle" Property="Height" Value="20"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumbCircle" Property="Width" Value="20"/>
                                                            <Setter TargetName="thumbCircle" Property="Height" Value="20"/>
                                                            <Setter TargetName="thumbCircle" Property="Fill" Value="#E0E0E0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" Background="Transparent" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Base Chip Button Style -->
            <Style x:Key="SettingsChipButton" TargetType="Button">
                <Setter Property="Background" Value="#161619"/>
                <Setter Property="BorderBrush" Value="#25252A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="{StaticResource NunitoBoldFont}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#25252D"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- RAM Chip Active Styles -->
            <Style x:Key="RamChip2Style" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam2Selected}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RamChip4Style" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam4Selected}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RamChip6Style" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam6Selected}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RamChip8Style" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam8Selected}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RamChip12Style" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam12Selected}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RamChip16Style" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam16Selected}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Resolution Chip Active Styles -->
            <Style x:Key="ResChipFhdStyle" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResFhd}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResChipHdPlusStyle" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResHdPlus}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResChipHdStyle" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResHd}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResChip2KStyle" TargetType="Button" BasedOn="{StaticResource SettingsChipButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRes2K}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#121214"/>
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Folder Card Style -->
            <Style x:Key="FolderDirectoryCard" TargetType="Border">
                <Setter Property="Background" Value="#141417"/>
                <Setter Property="BorderBrush" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <!-- Custom JVM Args and Resolution TextBox Style -->
            <Style x:Key="ExploreTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#111114"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#25252A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid Margin="32,24,32,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT: CATEGORY SIDEBAR ══════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                    <TextBlock Text="Flow Client Configuration" Foreground="#6E6E73" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>

                <!-- Categories list with sleek outline SVG icons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="PREFERENCES" Foreground="#52525A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="8,0,0,6"/>

                        <!-- 1. General & Launch -->
                        <Button Style="{StaticResource CatLaunchTabStyle}" Click="CategoryTab_Click" Tag="Launch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4.5,16.5 L7.5,19.5 M15,4.5 L19.5,9 M15,4.5 C12,1.5 6.5,4 4,6.5 C6.5,9 9,11.5 12,14.5 C15,11.5 17.5,9 20,6.5 C17.5,4 15,4.5 15,4.5 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="General &amp; Launch" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Java & Performance -->
                        <Button Style="{StaticResource CatPerformanceTabStyle}" Click="CategoryTab_Click" Tag="Performance">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M13,2 L3,14 H12 L11,22 L21,10 H12 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Java &amp; Performance" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SYSTEM &amp; STORAGE" Foreground="#52525A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="8,14,0,6"/>

                        <!-- 3. Folders & Resources -->
                        <Button Style="{StaticResource CatFoldersTabStyle}" Click="CategoryTab_Click" Tag="Folders">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3,7 A2,2 0 0,1 5,5 H9 L11,7 H19 A2,2 0 0,1 21,9 V18 A2,2 0 0,1 19,20 H5 A2,2 0 0,1 3,18 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Game Folders" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Storage & Disk Cleanup -->
                        <Button Style="{StaticResource CatStorageTabStyle}" Click="CategoryTab_Click" Tag="Storage">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19,11 H5 M19,7 H5 M19,15 H5 M21,3 H3 A1,1 0 0,0 2,4 V20 A1,1 0 0,0 3,21 H21 A1,1 0 0,0 22,20 V4 A1,1 0 0,0 21,3 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Storage &amp; Cleanup" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="FLOW CLIENT" Foreground="#52525A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="8,14,0,6"/>

                        <!-- 5. About & Diagnostics -->
                        <Button Style="{StaticResource CatAboutTabStyle}" Click="CategoryTab_Click" Tag="About">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,16 V12 M12,8 H12.01"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="About &amp; Diagnostics" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Back button -->
                <Button Grid.Row="2" Content="← Back to Home" Style="{StaticResource ExploreBtnGhost}"
                        Click="BackToLaunch_Click" Margin="0,10,0,0" HorizontalAlignment="Left"
                        FontFamily="{StaticResource NunitoFont}" FontSize="12.5"/>
            </Grid>

            <!-- ══════ RIGHT: MAIN CONTENT VIEWPORT ══════ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,10,0">

                    <!-- ══════ 1. GENERAL & LAUNCH ══════ -->
                    <StackPanel Visibility="{Binding IsLaunchCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="General &amp; Launch" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Configure Minecraft launch behavior, window resolution, Discord status, and client preferences."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Group: Launch Action -->
                        <TextBlock Text="LAUNCH BEHAVIOR" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- Option 1: Hide while playing (Recommended) -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐ Hide while playing" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <Border Background="#1C3829" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RECOMMENDED" Foreground="#30D158" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Hides the launcher while playing to free system resources. Automatically reappears when Minecraft closes."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" Style="{StaticResource ModernActionRadioButton}"
                                             IsChecked="{Binding IsActionHide, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 2: Minimize -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minimize to taskbar" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Keeps the launcher minimized in the taskbar during your game session."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" Style="{StaticResource ModernActionRadioButton}"
                                             IsChecked="{Binding IsActionMinimize, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 3: Keep Open -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Keep open in background" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Leaves the client open in the background for instant access to tabs and profiles."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" Style="{StaticResource ModernActionRadioButton}"
                                             IsChecked="{Binding IsActionKeepOpen, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 4: Close When Game Ready -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Close when game starts" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Completely closes Flow Client as soon as Minecraft is loaded to maximize FPS."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" Style="{StaticResource ModernActionRadioButton}"
                                             IsChecked="{Binding IsActionClose, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Group: Display & Resolution -->
                        <TextBlock Text="MINECRAFT DISPLAY &amp; RESOLUTION" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,14,0,8"/>

                        <!-- Fullscreen Toggle -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Start in Fullscreen" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Launch Minecraft directly in full-screen display mode."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding IsGameFullscreen, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Resolution Card -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Default Window Resolution" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Game dimensions applied when starting Minecraft in windowed mode."
                                                   Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Resolution Presets -->
                                <WrapPanel Margin="0,12,0,8">
                                    <Button Style="{StaticResource ResChipFhdStyle}" Content="1920 × 1080 (FHD)" Click="ResolutionPreset_Click" Tag="1920x1080"/>
                                    <Button Style="{StaticResource ResChipHdPlusStyle}" Content="1600 × 900 (HD+)" Click="ResolutionPreset_Click" Tag="1600x900"/>
                                    <Button Style="{StaticResource ResChipHdStyle}" Content="1280 × 720 (HD)" Click="ResolutionPreset_Click" Tag="1280x720"/>
                                    <Button Style="{StaticResource ResChip2KStyle}" Content="2560 × 1440 (2K)" Click="ResolutionPreset_Click" Tag="2560x1440"/>
                                </WrapPanel>

                                <!-- Custom Width x Height inputs -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="WIDTH (PX)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ExploreTextBox}" Text="{Binding GameWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="HEIGHT (PX)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource ExploreTextBox}" Text="{Binding GameHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group: Integrations & Behavior -->
                        <TextBlock Text="INTEGRATIONS &amp; BEHAVIOR" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,14,0,8"/>

                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Discord Rich Presence" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Display your active Minecraft instance, current server, and Flow Client status on Discord."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Check for updates on startup" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Automatically checks in the background for new official Flow Client releases."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Smooth interface animations" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Enable smooth sliding transitions, hover scale effects, and animated toggle switches."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UiAnimations, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Confirm before aborting launch" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Show a confirmation prompt before stopping an active download or launch."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ModernToggleSwitchStyle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding ConfirmBeforeStop, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ 2. JAVA & PERFORMANCE ══════ -->
                    <StackPanel Visibility="{Binding IsPerformanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Java &amp; Performance" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Hardware specifications, instance memory allocation, and Java Virtual Machine options."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Hardware Info Card -->
                        <TextBlock Text="DETECTED HARDWARE SPECIFICATIONS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="PROCESSOR (CPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding CpuName}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- GPU -->
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Text="GRAPHICS CARD (GPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding GpuName}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- RAM -->
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="TOTAL SYSTEM RAM" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding TotalRam}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- RAM Allocation -->
                        <TextBlock Text="INSTANCE RAM ALLOCATION" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Default Allocated RAM" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding RamUsagePercentText}" Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DefaultRamGbText}" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource NunitoBoldFont}"/>
                                </Grid>

                                <!-- Custom Modern RAM Slider -->
                                <Slider Style="{StaticResource ModernRamSliderStyle}"
                                        Minimum="1024" Maximum="{Binding MaxRamMb}"
                                        Value="{Binding DefaultRamMb, Mode=TwoWay}"
                                        SmallChange="512" LargeChange="1024"
                                        IsSnapToTickEnabled="True" TickFrequency="512"
                                        Margin="0,14,0,4"/>

                                <!-- RAM Ratio Bar -->
                                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding RamUsageRatio, Mode=OneWay}"
                                             Background="#202025" Foreground="#FFFFFF" BorderThickness="0" Margin="0,4,0,8"/>

                                <!-- Warning if > 75% RAM -->
                                <Border Background="#261C12" BorderBrush="#5E381A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,10"
                                        Visibility="{Binding IsRamWarningVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⚠️ Warning: Allocating more than 75% of your system RAM may reduce Windows stability."
                                               Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Preset chips -->
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource RamChip2Style}" Content="2 GB" Click="RamPreset_Click" Tag="2048"/>
                                    <Button Style="{StaticResource RamChip4Style}" Content="4 GB (Recommended)" Click="RamPreset_Click" Tag="4096"/>
                                    <Button Style="{StaticResource RamChip6Style}" Content="6 GB" Click="RamPreset_Click" Tag="6144"/>
                                    <Button Style="{StaticResource RamChip8Style}" Content="8 GB" Click="RamPreset_Click" Tag="8192"/>
                                    <Button Style="{StaticResource RamChip12Style}" Content="12 GB" Click="RamPreset_Click" Tag="12288"/>
                                    <Button Style="{StaticResource RamChip16Style}" Content="16 GB" Click="RamPreset_Click" Tag="16384"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Java Runtime -->
                        <TextBlock Text="JAVA RUNTIME" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="System Java Executable" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding JavaVersion}" Foreground="#30D158" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Browse..." Click="BrowseJava_Click" Padding="12,5" FontSize="11.5" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Auto" Click="ResetJava_Click" Padding="10,5" FontSize="11.5" ToolTip="Reset to automatic detection"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#0C0C0E" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding EffectiveJavaPath}" Foreground="#8E8E93" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Custom JVM Arguments -->
                        <TextBlock Text="ADVANCED JVM PARAMETERS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <TextBlock Text="Custom Command Line Arguments" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBox Style="{StaticResource ExploreTextBox}" Text="{Binding CustomJvmArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,8" FontFamily="Consolas" FontSize="11.5"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource SettingsChipButton}" Content="Default" Click="JvmPreset_Click" Tag="DEFAULT"/>
                                    <Button Style="{StaticResource SettingsChipButton}" Content="Optimized G1GC (Recommended)" Click="JvmPreset_Click" Tag="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200"/>
                                    <Button Style="{StaticResource SettingsChipButton}" Content="Aikar Flags" Click="JvmPreset_Click" Tag="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════ 3. GAME FOLDERS & QUICK ACCESS ══════ -->
                    <StackPanel Visibility="{Binding IsFoldersCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Game Folders &amp; Quick Access" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Instant one-click access to game directories, worlds, resource packs, shaders, and logs."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <UniformGrid Columns="2" Margin="0,0,-8,0">

                            <!-- 1. .minecraft Root -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#1C212D" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text=".minecraft Root" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Global options, servers.dat, and configurations" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding MinecraftDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding MinecraftDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenMinecraftDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. Worlds / Saves -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#1C2E22" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="🌍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Worlds &amp; Saves" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Singleplayer maps and world backups" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding WorldsDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding WorldsDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenWorldsDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. Screenshots -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#2B2317" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="📸" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Screenshots" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="All captures taken with the F2 screenshot key" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ScreenshotsDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding ScreenshotsDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenScreenshotsDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 4. Resource Packs -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#241B2D" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="🎨" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Resource Packs" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Texture packs and audio resource packs" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ResourcePacksDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding ResourcePacksDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenResourcePacksDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 5. Shader Packs -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#17242C" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="✨" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Shader Packs" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Iris, Canvas, and OptiFine graphic shaders" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ShaderPacksDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding ShaderPacksDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenShaderPacksDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 6. Mods Directory -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#2B1A22" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="🧩" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Mods Directory (.jar)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Installed mods for Fabric, Forge, and NeoForge" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ModsDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding ModsDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenModsDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 7. Crash Reports & Logs -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#2C1B1B" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="📋" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Crash Reports &amp; Logs" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Diagnostic error registers and game crash reports" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CrashReportsDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding CrashReportsDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenCrashReportsDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 8. Flow Launcher AppData -->
                            <Border Style="{StaticResource FolderDirectoryCard}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#201C2E" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Flow Launcher Data" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text="Launcher settings, client profiles, and cache" Foreground="#7E7E84" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#0D0D10" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding LauncherDataDirectory}" Foreground="#727585" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ExploreBtnGhost}" Content="Copy" Click="CopyPath_Click" Tag="{Binding LauncherDataDirectory}" Padding="9,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Open" Click="OpenLauncherDataDir_Click" Padding="14,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </UniformGrid>
                    </StackPanel>

                    <!-- ══════ 4. STORAGE & DISK CLEANUP ══════ -->
                    <StackPanel Visibility="{Binding IsStorageCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Storage &amp; Disk Cleanup" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Analyze disk space usage and safely clean temporary files and update packages."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Big Hero Card with live space calculation -->
                        <Border Background="#141417" BorderBrush="#1E1E22" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top row: Big number -->
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="RECLAIMABLE DISK SPACE DETECTED" Foreground="#7E7E84" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding ReclaimableSpaceText}" Foreground="#FFFFFF" FontSize="28" FontWeight="ExtraBold" Margin="0,4,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource ExploreBtnGhost}" Content="🔄 Recalculate" Click="RefreshStorage_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,5" FontSize="11.5"/>
                                </Grid>

                                <Rectangle Grid.Row="1" Height="1" Fill="#1E202A" Margin="0,14,0,14"/>

                                <!-- Breakdown 3 columns -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Update packages -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="UPDATE PACKAGES" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding UpdateCacheSizeText}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Downloaded .zip update packages" Foreground="#52525A" FontSize="10"/>
                                    </StackPanel>

                                    <!-- Temp & Staging -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="TEMP &amp; STAGING" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding TempFilesSizeText}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Temporary extraction leftovers" Foreground="#52525A" FontSize="10"/>
                                    </StackPanel>

                                    <!-- Logs & Crash reports -->
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="HISTORICAL LOGS &amp; REPORTS" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding LogsSizeText}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Archived logs and crash reports" Foreground="#52525A" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Action Card 1: Clean Temp & Update Cache -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧹 Clean temporary files and update packages" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <TextBlock Text="Safely delete downloaded update ZIP archives and temp folder leftovers to reclaim disk space."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ExploreBtnPrimary}" Content="Clean Now"
                                        Click="CleanTempFiles_Click" VerticalAlignment="Center" Padding="16,8" FontSize="12.5" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Action Card 2: Clean Old Logs & Crashes -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="🗑️ Clean old logs and crash reports" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Removes crash diagnostic files and archived historical game logs (.log.gz)."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ExploreBtnGhost}" Content="Clean Logs"
                                        Click="CleanLogsAndCrashes_Click" VerticalAlignment="Center" Padding="16,8" FontSize="12.5"/>
                            </Grid>
                        </Border>

                        <!-- Feedback Message Banner -->
                        <Border Background="#10241A" BorderBrush="#1C4B33" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,6,0,0"
                                Visibility="{Binding CleanupResultText, Converter={StaticResource StrNotEmptyToVis}}">
                            <Grid>
                                <TextBlock Text="{Binding CleanupResultText}" Foreground="#34D399" FontSize="12.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ 5. ABOUT & DIAGNOSTICS ══════ -->
                    <StackPanel Visibility="{Binding IsAboutCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="About &amp; Diagnostics" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Version details, update checking, and technical support."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Release Card -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Flow Client" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat='Released on {0}'}" Foreground="#7E7E84" FontSize="12" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding InstallDate, StringFormat='Installed on this PC: {0}'}" Foreground="#55555C" FontSize="11" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Border Background="#1C2F52" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="#60A5FA" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="#1E1E24" Margin="0,14,0,14"/>

                                <!-- Update Check Row -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Check for Updates"
                                                Click="CheckUpdatesNow_Click" Padding="14,8" FontSize="12"/>

                                        <!-- Download and Install button (when update found) -->
                                        <Button Style="{StaticResource ExploreBtnPlay}" Click="InstallUpdateNow_Click"
                                                Margin="12,0,0,0" Padding="16,8" FontSize="12" FontWeight="Bold"
                                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ Download &amp; Install v" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LatestVersion}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Status message -->
                                    <TextBlock Text="{Binding UpdateCheckMessage}" Foreground="#93C5FD" FontSize="12"
                                               FontFamily="{StaticResource NunitoFont}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"
                                               MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Diagnostics Copy -->
                        <TextBlock Text="TECHNICAL SUPPORT" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Copy System Diagnostic Report" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Generates a formatted summary with hardware, Java version, allocated memory, and paths for easier support and debugging."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="📋 Copy Report" Click="CopyDiagnostic_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Reset Defaults -->
                        <TextBlock Text="CONFIGURATION MANAGEMENT" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,4,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Reset All Settings to Defaults" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Reset memory, launch, resolution, and interface preferences to default factory values." Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Reset to Defaults" Click="ResetDefaults_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="11.5"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
