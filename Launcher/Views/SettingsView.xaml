<UserControl x:Class="Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#131114">
        <Grid Margin="48,48,48,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="520">
                    <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Launcher behavior, integrated mods, and general preferences."
                               Foreground="#6E6E72" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,28"/>

                    <TextBlock Text="Launch" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Close after launch" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Quit Flow when Minecraft starts."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding CloseLauncherOnLaunch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Minimize after launch" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Keep Flow running in the background."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding MinimizeLauncherOnLaunch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Confirm before stop" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Ask before closing Minecraft from the Play button."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding ConfirmBeforeStop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Mods" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,10"/>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FlowClient mod" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Inject the integrated branding mod on every supported version."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding EnableFlowClientMod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Voice chat mod" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Auto-install Simple Voice Chat on Fabric instances."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding EnableVoiceChatMod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="General" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,10"/>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="UI animations" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Smooth transitions across the launcher."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding UiAnimations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ExploreSettingCard}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto-check updates" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Look for launcher updates when Flow starts."
                                           Foreground="#6E6E72" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                      IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Button Content="Back to Launch" Style="{StaticResource ExploreNavChip}"
                            HorizontalAlignment="Left" Click="BackToLaunch_Click" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="Summary" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="On launch" Foreground="#8E8E93" FontSize="11"/>
                        <TextBlock Text="{Binding LaunchBehaviorSummary}" Foreground="#FFFFFF"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="FlowClient mod" Foreground="#8E8E93" FontSize="11"/>
                        <TextBlock Text="{Binding FlowClientModSummary}" Foreground="#FFFFFF"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Voice chat" Foreground="#8E8E93" FontSize="11"/>
                        <TextBlock Text="{Binding VoiceChatSummary}" Foreground="#FFFFFF"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ExploreInstanceNav}">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Storage" Foreground="#8E8E93" FontSize="11"/>
                        <TextBlock x:Name="SettingsPathText" Foreground="#FFFFFF"
                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
