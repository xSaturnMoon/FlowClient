                                <Button Content="Recalculate" Style="{StaticResource ActionPillButtonStyle}" Click="RefreshStorage_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#28282E" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="UPDATE CACHE" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                    <TextBlock Text="{Binding UpdateCacheSizeText}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="TEMP FILES" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                    <TextBlock Text="{Binding TempFilesSizeText}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="LOGS &amp; CRASHES" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                    <TextBlock Text="{Binding LogsSizeText}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action 1: Clean Temp & Update Cache -->
                    <Border Style="{StaticResource SettingCapsuleCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Clean Temporary Files &amp; Update Cache" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                <TextBlock Text="Delete downloaded installer ZIP archives and temporary extraction leftovers."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clean Now" Style="{StaticResource PrimaryActionPillButtonStyle}"
                                    Click="CleanTempFiles_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Action 2: Clean Logs -->
                    <Border Style="{StaticResource SettingCapsuleCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Clean Old Logs &amp; Crash Reports" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                <TextBlock Text="Removes archived diagnostic error registers and historical game log files."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clean Logs" Style="{StaticResource ActionPillButtonStyle}"
                                    Click="CleanLogsAndCrashes_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Feedback Banner -->
                    <Border Background="#162E20" CornerRadius="14" Padding="14,10" Margin="0,4,0,0"
                            Visibility="{Binding CleanupResultText, Converter={StaticResource StrNotEmptyToVis}}">
                        <TextBlock Text="{Binding CleanupResultText}" Foreground="#34D399" FontSize="12.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                    </Border>
                </StackPanel>

                <!-- ══════════════ TAB 5: ABOUT & DIAGNOSTICS ══════════════ -->
                <StackPanel Visibility="{Binding IsAboutCategory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ABOUT FLOW CLIENT" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,10"/>

                    <!-- App Release Card -->
                    <Border Style="{StaticResource SettingCapsuleCard}" Padding="22,18" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <Image Source="/Assets/flow_title_logo.png" Height="20" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding CurrentVersion}" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                    <TextBlock Text="{Binding ReleaseDate, StringFormat='Released on {0}'}" Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding InstallDate, StringFormat='Installed on this PC: {0}'}" Foreground="#55555C" FontSize="10.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Content="Check for Updates" Style="{StaticResource PrimaryActionPillButtonStyle}"
                                        Click="CheckUpdatesNow_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- Download and Install button when update found -->
                            <Button Style="{StaticResource PrimaryActionPillButtonStyle}" Click="InstallUpdateNow_Click"
                                    Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Install Update v" Foreground="#101010" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LatestVersion}" Foreground="#101010" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Status message -->
                            <TextBlock Text="{Binding UpdateCheckMessage}" Foreground="#93C5FD" FontSize="12"
                                       FontFamily="{StaticResource NunitoBoldFont}" Margin="0,10,0,0"
                                       Visibility="{Binding UpdateCheckMessage, Converter={StaticResource StrNotEmptyToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Technical Diagnostics -->
                    <TextBlock Text="TECHNICAL SUPPORT" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,10,0,10"/>
                    <Border Style="{StaticResource SettingCapsuleCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="System Diagnostic Report" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                <TextBlock Text="Copies a formatted summary with hardware, Java, paths, and settings for technical support."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Copy Report" Style="{StaticResource ActionPillButtonStyle}"
                                    Click="CopyDiagnostic_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Reset Defaults -->
                    <TextBlock Text="CONFIGURATION MANAGEMENT" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,10,0,10"/>
                    <Border Style="{StaticResource SettingCapsuleCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Reset All Settings to Defaults" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                <TextBlock Text="Restore memory, launch, resolution, and interface options to default factory values."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset Settings" Style="{StaticResource DangerActionPillButtonStyle}"
                                    Click="ResetDefaults_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
