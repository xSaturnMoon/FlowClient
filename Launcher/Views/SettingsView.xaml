                            </Grid>
                            <Border Background="#161619" CornerRadius="12" Padding="14,8" Margin="0,12,0,0">
                                <TextBlock Text="{Binding EffectiveJavaPath}" Foreground="#8E8E93" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Group 4: Advanced JVM Parameters -->
