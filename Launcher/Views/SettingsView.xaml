<UserControl x:Class="Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             Background="Transparent">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>

            <!-- Subtab Capsule Pill Style -->
            <Style x:Key="SettingsSubTabBtnStyle" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#9C9C9D"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="17" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#27272D"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Specific Active Subtab Styles -->
            <Style x:Key="SubTabGeneralStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabBtnStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLaunchCategory}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#101010"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SubTabPerformanceStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabBtnStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPerformanceCategory}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#101010"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SubTabFoldersStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabBtnStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFoldersCategory}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#101010"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SubTabStorageStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabBtnStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStorageCategory}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#101010"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SubTabAboutStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabBtnStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAboutCategory}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#101010"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Borderless Setting Row Card -->
            <Style x:Key="SettingCapsuleCard" TargetType="Border">
                <Setter Property="Background" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Clickable Launch Action Card -->
            <Style x:Key="LaunchActionCapsuleCard" TargetType="Button">
                <Setter Property="Background" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="18" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#27272D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular Radio Button Indicator -->
            <Style x:Key="ModernActionRadioButton" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="OuterCircle" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                    BorderBrush="#55555C" Background="Transparent" SnapsToDevicePixels="True">
                                <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="#FFFFFF" Visibility="Collapsed"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OuterCircle" Property="BorderBrush" Value="#FFFFFF"/>
                                    <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Animated Toggle Switch Style -->
            <Style x:Key="ModernToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="46" Height="26" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="13" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="TrackBrush" Color="#28282E"/>
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="Knob" Width="20" Height="20"
                                         HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"
                                         SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Fill>
                                        <SolidColorBrush x:Name="KnobBrush" Color="#6E6E76"/>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslate" X="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#FFFFFF"/>
                                    <Setter TargetName="Knob" Property="Fill" Value="#121214"/>
                                    <Setter TargetName="Knob" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="20"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Knob"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="20" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#FFFFFF" Duration="0:0:0.18"/>
                                                <ColorAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                To="#121214" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Knob"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#28282E" Duration="0:0:0.18"/>
                                                <ColorAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                To="#6E6E76" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Custom Ram Slider Style -->
            <Style x:Key="ModernRamSliderStyle" TargetType="Slider">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" Background="#28282E" CornerRadius="3" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" Background="#FFFFFF" CornerRadius="3,0,0,3" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Ellipse x:Name="thumbCircle" Width="18" Height="18" Fill="#FFFFFF"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.45" Color="#000000"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbCircle" Property="Width" Value="20"/>
                                                            <Setter TargetName="thumbCircle" Property="Height" Value="20"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumbCircle" Property="Width" Value="20"/>
                                                            <Setter TargetName="thumbCircle" Property="Height" Value="20"/>
                                                            <Setter TargetName="thumbCircle" Property="Fill" Value="#E0E0E0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" Background="Transparent" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- RAM Preset Capsule Pill Style (Matching LibraryView RamPillButtonStyle) -->
            <Style x:Key="RamPillButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#9C9C9D"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="16" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#27272D"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Specific RAM Active Styles -->
            <Style x:Key="Ram2PillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam2Selected}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Ram4PillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam4Selected}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Ram6PillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam6Selected}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Ram8PillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam8Selected}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Ram12PillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam12Selected}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Ram16PillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRam16Selected}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Specific Resolution Active Styles -->
            <Style x:Key="ResFhdPillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResFhd}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResHdPlusPillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResHdPlus}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ResHdPillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResHd}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Res2KPillStyle" TargetType="Button" BasedOn="{StaticResource RamPillButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRes2K}" Value="True">
                        <Setter Property="Background" Value="#32323A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Action Pill Button Style (Matching LibraryView ActionPillButtonStyle) -->
            <Style x:Key="ActionPillButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#EEEEEE"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="{StaticResource NunitoBoldFont}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="17" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2B2B32"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary White Pill Button Style -->
            <Style x:Key="PrimaryActionPillButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionPillButtonStyle}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#101010"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="17" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Danger Pill Button Style -->
            <Style x:Key="DangerActionPillButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionPillButtonStyle}">
                <Setter Property="Background" Value="#2B1A1E"/>
                <Setter Property="Foreground" Value="#EF4444"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0" CornerRadius="17" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3B2228"/>
                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Capsule Input TextBox Style -->
            <Style x:Key="CapsuleInputTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource NunitoFont}"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="36,24,36,36" HorizontalAlignment="Left" MaxWidth="660" Width="660">
            <StackPanel>

                <!-- Page Header (Flow Design) -->
                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#FFFFFF" Margin="4,0,0,3"/>
                <TextBlock Text="Configure client behavior, game memory, display resolution, and storage." FontSize="13"
                           FontFamily="{StaticResource NunitoFont}" Foreground="#7E7E84" Margin="4,0,0,20"/>

                <!-- Top Subtabs Capsule Bar (Matching Melty/Flow Design) -->
                <WrapPanel Margin="0,0,0,24">
                    <Button Content="General" Style="{StaticResource SubTabGeneralStyle}" Click="CategoryTab_Click" Tag="Launch"/>
                    <Button Content="Performance" Style="{StaticResource SubTabPerformanceStyle}" Click="CategoryTab_Click" Tag="Performance"/>
                    <Button Content="Folders" Style="{StaticResource SubTabFoldersStyle}" Click="CategoryTab_Click" Tag="Folders"/>
                    <Button Content="Storage" Style="{StaticResource SubTabStorageStyle}" Click="CategoryTab_Click" Tag="Storage"/>
                    <Button Content="About" Style="{StaticResource SubTabAboutStyle}" Click="CategoryTab_Click" Tag="About"/>
                </WrapPanel>

                <!-- ══════════════ TAB 1: GENERAL & LAUNCH ══════════════ -->
                <StackPanel Visibility="{Binding IsLaunchCategory, Converter={StaticResource BoolToVis}}">

                    <!-- Group 1: Launch Action -->
                    <TextBlock Text="LAUNCH BEHAVIOR" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,10"/>

                    <!-- Option 1: Hide while playing (Recommended) -->
                    <Button Style="{StaticResource LaunchActionCapsuleCard}" Click="LaunchAction_Click" Tag="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Hide while playing" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                    <Border Background="#1C3829" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="RECOMMENDED" Foreground="#30D158" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Hides the launcher while playing to free system resources. Reappears when Minecraft closes."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                            <RadioButton Grid.Column="1" Style="{StaticResource ModernActionRadioButton}"
                                         IsChecked="{Binding IsActionHide, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Option 2: Minimize -->
                    <Button Style="{StaticResource LaunchActionCapsuleCard}" Click="LaunchAction_Click" Tag="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Minimize to taskbar" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                <TextBlock Text="Minimizes Flow Client to the taskbar while the game is running."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                            <RadioButton Grid.Column="1" Style="{StaticResource ModernActionRadioButton}"
                                         IsChecked="{Binding IsActionMinimize, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Option 3: Keep Open -->
                    <Button Style="{StaticResource LaunchActionCapsuleCard}" Click="LaunchAction_Click" Tag="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
