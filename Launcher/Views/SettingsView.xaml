<UserControl x:Class="Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Category Tab Button Style -->
            <Style x:Key="SettingsCategoryTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#8E8E93"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Launch action option card style -->
            <Style x:Key="LaunchActionCard" TargetType="Button">
                <Setter Property="Background" Value="#111113"/>
                <Setter Property="BorderBrush" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#303038"/>
                                    <Setter TargetName="b" Property="Background" Value="#151518"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- RAM selector chip -->
            <Style x:Key="RamChipButton" TargetType="Button">
                <Setter Property="Background" Value="#161619"/>
                <Setter Property="BorderBrush" Value="#25252A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#222228"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#0C0C10">

        <Grid Margin="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: CATEGORY NAVIGATION ═══ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                    <TextBlock Text="Flow Client configuration" Foreground="#6E6E73" FontSize="12" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>

                <!-- Categories list -->
                <StackPanel Grid.Row="1">
                    <!-- Launch -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Launch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Game &amp; Launch" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLaunchCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Java & Performance -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Performance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Java &amp; System" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPerformanceCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Mods & Features -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Mods">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Mods &amp; Features" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModsCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Launcher & Appearance -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Launcher &amp; Appearance" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppearanceCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Folders & Cache -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Storage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Folders &amp; Cache" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStorageCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Back button -->
                <Button Grid.Row="2" Content="Back to Launch" Style="{StaticResource ExploreBtnGhost}"
                        Click="BackToLaunch_Click" Margin="0,0,0,8" HorizontalAlignment="Left"
                        FontFamily="{StaticResource NunitoFont}" FontSize="12.5"/>
            </Grid>

            <!-- ═══ RIGHT: CATEGORY CONTENT ═══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,12,0">

                    <!-- 1. CATEGORIA: GAME & LAUNCH -->
                    <StackPanel Visibility="{Binding IsLaunchCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Game &amp; Launch" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure Flow Client behavior when launching a Minecraft session."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Post-Launch Selector -->
                        <TextBlock Text="POST-LAUNCH BEHAVIOR" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- Option 1: Hide while playing (Recommended) -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐ Hide while playing" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <Border Background="#1C3829" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RECOMMENDED" Foreground="#30D158" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Hides the launcher while playing to free up system resources. Reopens automatically when Minecraft closes."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionHide}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 2: Minimize to taskbar -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minimize to taskbar" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Minimizes Flow Client to the Windows taskbar during gameplay."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionMinimize}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 3: Keep open -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Keep open" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Keeps the launcher window visible on screen in the background."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionKeepOpen}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 4: Close when game is ready -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Close when game is ready" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Waits until the Minecraft window is fully initialized and visible before closing."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionClose}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Safety & Control -->
                        <TextBlock Text="SAFETY &amp; CONTROL" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>

                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ask confirmation before stopping the game" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Shows a confirmation prompt before terminating the running Minecraft instance."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding ConfirmBeforeStop, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Discord RPC -->
                        <TextBlock Text="INTEGRATIONS &amp; GAMING" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>

                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Discord Rich Presence (RPC)" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <Border Background="#1C1B3A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DISCORD" Foreground="#5865F2" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Displays your Flow Client status and in-game details (version, mod loader, playtime, server) on Discord."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 2. CATEGORIA: JAVA & PERFORMANCE -->
                    <StackPanel Visibility="{Binding IsPerformanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Java &amp; System" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage Java runtime environment and memory allocation for instances."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Java Runtime Card -->
                        <TextBlock Text="DETECTED JAVA RUNTIME" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Primary Java executable" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding JavaVersion}" Foreground="#30D158" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Border Background="#122A44" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="AUTOMATIC" Foreground="#2563EB" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <Border Background="#0C0C0E" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding JavaPath}" Foreground="#8E8E93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Info Card -->
                        <TextBlock Text="SYSTEM HARDWARE SPECS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="PROCESSOR (CPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding CpuName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- GPU -->
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Text="GRAPHICS CARD (GPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding GpuName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- RAM -->
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="TOTAL SYSTEM RAM" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding TotalRam}" Foreground="#2563EB" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Default RAM Selector -->
                        <TextBlock Text="DEFAULT INSTANCE RAM" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Allocated memory" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Select the initial RAM allocated when creating new installations." Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DefaultRamGbText}" Foreground="#2563EB" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource RamChipButton}" Content="2 GB" Click="RamPreset_Click" Tag="2048"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="4 GB" Click="RamPreset_Click" Tag="4096"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="6 GB" Click="RamPreset_Click" Tag="6144"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="8 GB" Click="RamPreset_Click" Tag="8192"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="12 GB" Click="RamPreset_Click" Tag="12288"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="16 GB" Click="RamPreset_Click" Tag="16384"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. CATEGORIA: MODS & FEATURES -->
                    <StackPanel Visibility="{Binding IsModsCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Mods &amp; Features" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Integrated modules and enhanced compatibility for your game instances."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="BUILT-IN OFFICIAL MODS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- FlowClient Mod -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="FlowClient In-Game Mod" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Automatically injects the official FlowClient mod (in-game branding, optimizations, and custom HUD)."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableFlowClientMod, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Voice Chat Mod -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Simple Voice Chat" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Automatically installs the proximity voice chat mod for supported multiplayer servers."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableVoiceChatMod, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 4. CATEGORIA: LAUNCHER & APPEARANCE -->
                    <StackPanel Visibility="{Binding IsAppearanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Launcher &amp; Appearance" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Visual customization and application updates."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="INTERFACE" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- UI Animations -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Smooth animations &amp; transitions" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Enables fluid motion effects when navigating between tabs and launching."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UiAnimations, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Auto Check Updates -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Check for updates on startup" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Automatically checks for newer versions of Flow Client when starting up."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Info Versione & Verifica Manuale -->
                        <TextBlock Text="UPDATES &amp; RELEASES" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Flow Client" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat='Released on {0}'}" Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Border Background="#2563EB" CornerRadius="5" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="#1E1E22" Margin="0,12,0,12"/>

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <!-- Verifica Button -->
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Check for updates"
                                                Click="CheckUpdatesNow_Click" Padding="14,8" FontSize="12"/>

                                        <!-- Scarica ed Aggiorna Button (Visible when update found) -->
                                        <Button Style="{StaticResource ExploreBtnPlay}" Click="InstallUpdateNow_Click"
                                                Margin="12,0,0,0" Padding="16,8" FontSize="12" FontWeight="Bold"
                                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ Download &amp; Install v" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LatestVersion}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Status Message -->
                                    <TextBlock Text="{Binding UpdateCheckMessage}" Foreground="#93C5FD" FontSize="12"
                                               FontFamily="{StaticResource NunitoFont}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"
                                               MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. CATEGORIA: FOLDERS & CACHE -->
                    <StackPanel Visibility="{Binding IsStorageCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Folders &amp; Cache" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Quick access to local directories and disk cleanup tools."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="QUICK DIRECTORY ACCESS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- Instances Folder -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Minecraft Instances Directory (.minecraft)" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding InstancesDirectory}" Foreground="#7E7E84" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Open" Click="OpenInstancesDir_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Data Folder -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Launcher Data Directory (FlowLauncher)" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding LauncherDataDirectory}" Foreground="#7E7E84" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Open" Click="OpenDataDir_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Official App Folder -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Flow Client Installation Directory" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding OfficialInstallDirectory}" Foreground="#7E7E84" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Open" Click="OpenInstallDir_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Maintenance & Cleanup -->
                        <TextBlock Text="MAINTENANCE &amp; CLEANUP" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <TextBlock Text="Clean temporary files and cached updates" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Deletes leftover downloaded update archives, staging folders, and stale log files to free up disk space."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,12" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                <Grid>
                                    <Button Style="{StaticResource ExploreBtnGhost}" Content="🧹 Clean now"
                                            Click="CleanTempFiles_Click" HorizontalAlignment="Left" Padding="14,6" FontSize="12"/>
                                    <TextBlock Text="{Binding MaintenanceMessage}" Foreground="#30D158" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
