                        <StackPanel>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Java Executable" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
