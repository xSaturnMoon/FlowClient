<UserControl x:Class="Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Category Tab Button Style -->
            <Style x:Key="SettingsCategoryTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#8E8E93"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Launch action option card style -->
            <Style x:Key="LaunchActionCard" TargetType="Button">
                <Setter Property="Background" Value="#111113"/>
                <Setter Property="BorderBrush" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#303038"/>
                                    <Setter TargetName="b" Property="Background" Value="#151518"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- RAM selector chip -->
            <Style x:Key="RamChipButton" TargetType="Button">
                <Setter Property="Background" Value="#161619"/>
                <Setter Property="BorderBrush" Value="#25252A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#222228"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#1A162B" Offset="0"/>
                <GradientStop Color="#0C0B10" Offset="0.85"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid Margin="36,32,36,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: CATEGORY NAVIGATION ═══ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Impostazioni" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                    <TextBlock Text="Configurazione di Flow Client" Foreground="#6E6E73" FontSize="12" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>

                <!-- Categories list -->
                <StackPanel Grid.Row="1">
                    <!-- Avvio -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Launch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Avvio &amp; Gioco" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLaunchCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Java & Sistema -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Performance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Java &amp; Sistema" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPerformanceCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Mod & Integrazioni -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Mods">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Mod &amp; Funzioni" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModsCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Interfaccia -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Launcher &amp; Aspetto" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppearanceCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Cartelle & Dati -->
                    <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Storage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Cartelle &amp; Cache" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStorageCategory}" Value="True">
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Back button -->
                <Button Grid.Row="2" Content="Torna a Launch" Style="{StaticResource ExploreBtnGhost}"
                        Click="BackToLaunch_Click" Margin="0,0,0,8" HorizontalAlignment="Left"
                        FontFamily="{StaticResource NunitoFont}" FontSize="12.5"/>
            </Grid>

            <!-- ═══ RIGHT: CATEGORY CONTENT ═══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,12,0">

                    <!-- 1. CATEGORIA: AVVIO & GIOCO -->
                    <StackPanel Visibility="{Binding IsLaunchCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Avvio &amp; Gioco" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Determina cosa succede a Flow Client non appena avvii una sessione di Minecraft."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Selettore Comportamento Post-Avvio -->
                        <TextBlock Text="COMPORTAMENTO DOPO IL LANCIO" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- Opzione 1: Nascondi mentre giochi (Consigliato) -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐ Nascondi mentre giochi" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <Border Background="#1C3829" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="CONSIGLIATO" Foreground="#30D158" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Nasconde il launcher mentre giochi liberando risorse. Si riapre da solo quando chiudi Minecraft, senza rischiare crash."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionHide}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Opzione 2: Riduci a icona -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Riduci a icona" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Minimizza Flow Client nella barra delle applicazioni durante il gioco."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionMinimize}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Opzione 3: Resta aperto -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Resta aperto" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Lascia la finestra del launcher visibile sullo schermo in background."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionKeepOpen}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Opzione 4: Chiudi ad avvio completato -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Chiudi quando il gioco è pronto" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Attende che la finestra di Minecraft sia effettivamente avviata e visibile a schermo prima di chiudere il client."
                                               Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionClose}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Altre opzioni avvio -->
                        <TextBlock Text="SICUREZZA &amp; CONTROLLO" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>

                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Chiedi conferma prima di arrestare il gioco" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Mostra una richiesta di conferma prima di forzare la chiusura di Minecraft."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding ConfirmBeforeStop, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Discord RPC -->
                        <TextBlock Text="INTEGRAZIONI &amp; GAMING" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>

                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Discord Rich Presence (RPC)" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <Border Background="#1C1B3A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DISCORD" Foreground="#5865F2" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Mostra su Discord il tuo stato in-launcher e dettagli in-game (versione, modloader, tempo di gioco, server)."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 2. CATEGORIA: JAVA & PRESTAZIONI -->
                    <StackPanel Visibility="{Binding IsPerformanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Java &amp; Prestazioni" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Gestione dell'ambiente Java e dell'allocazione di memoria per le istanze."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Java Runtime Card -->
                        <TextBlock Text="JAVA RUNTIME RILEVATO" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Eseguibile Java principale" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding JavaVersion}" Foreground="#30D158" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Border Background="#122A44" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="AUTOMATICO" Foreground="#0A84FF" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <Border Background="#0C0C0E" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding JavaPath}" Foreground="#8E8E93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Info Card -->
                        <TextBlock Text="SPECIFICHE HARDWARE DEL SISTEMA" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="PROCESSORE (CPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding CpuName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- GPU -->
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Text="SCHEDA VIDEO (GPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding GpuName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- RAM -->
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="RAM TOTALE PC" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding TotalRam}" Foreground="#0A84FF" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Default RAM Selector -->
                        <TextBlock Text="RAM PREDEFINITA PER LE ISTANZE" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Memoria consigliata" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Seleziona la RAM iniziale da assegnare quando crei nuove versioni." Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DefaultRamGbText}" Foreground="#0A84FF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource RamChipButton}" Content="2 GB" Click="RamPreset_Click" Tag="2048"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="4 GB" Click="RamPreset_Click" Tag="4096"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="6 GB" Click="RamPreset_Click" Tag="6144"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="8 GB" Click="RamPreset_Click" Tag="8192"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="12 GB" Click="RamPreset_Click" Tag="12288"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="16 GB" Click="RamPreset_Click" Tag="16384"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. CATEGORIA: MOD & FUNZIONI -->
                    <StackPanel Visibility="{Binding IsModsCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Mod &amp; Funzioni" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Moduli integrati e compatibilità estesa per le tue istanze di gioco."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="MOD UFFICIALI INTEGRATE" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- FlowClient Mod -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="FlowClient In-Game Mod" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Inietta automaticamente il modulo ufficiale FlowClient (branding in-game, ottimizzazioni e overlay personalizzato)."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableFlowClientMod, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Voice Chat Mod -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Simple Voice Chat" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Installa automaticamente la mod di chat vocale di prossimità per i server multiplayer supportati."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableVoiceChatMod, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 4. CATEGORIA: LAUNCHER & ASPETTO -->
                    <StackPanel Visibility="{Binding IsAppearanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Launcher &amp; Aspetto" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Personalizzazione visiva e aggiornamenti dell'applicazione."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="INTERFACCIA" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- UI Animations -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Animazioni e transizioni fluide" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Attiva gli effetti di animazione all'apertura del client e al cambio pagina."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UiAnimations, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Auto Check Updates -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Controllo aggiornamenti all'avvio" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Cerca automaticamente nuove versioni di Flow Client all'avvio dell'applicazione."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Info Versione & Verifica Manuale -->
                        <TextBlock Text="INFORMAZIONI RELEASE" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Flow Client" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat='Rilasciata il {0}'}" Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Border Background="#0A6FCB" CornerRadius="5" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="#1E1E22" Margin="0,12,0,12"/>

                                <Grid>
                                    <Button Style="{StaticResource ExploreBtnPrimary}" Content="Verifica aggiornamenti ora"
                                            Click="CheckUpdatesNow_Click" HorizontalAlignment="Left" Padding="14,6" FontSize="12"/>
                                    <TextBlock Text="{Binding UpdateCheckMessage}" Foreground="#E0E0E0" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. CATEGORIA: CARTELLE & CACHE -->
                    <StackPanel Visibility="{Binding IsStorageCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cartelle &amp; Cache" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,4"/>
                        <TextBlock Text="Accedi rapidamente ai percorsi di sistema e mantieni pulito lo spazio su disco."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="ACCESSO RAPIDO CARTELLE" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- Instances Folder -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Cartella Istanze Minecraft (.minecraft)" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding InstancesDirectory}" Foreground="#7E7E84" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Apri" Click="OpenInstancesDir_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Data Folder -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Cartella Dati Launcher (FlowLauncher)" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding LauncherDataDirectory}" Foreground="#7E7E84" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Apri" Click="OpenDataDir_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Official App Folder -->
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Cartella Installazione Flow Client" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding OfficialInstallDirectory}" Foreground="#7E7E84" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Apri" Click="OpenInstallDir_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Maintenance & Cleanup -->
                        <TextBlock Text="MANUTENZIONE &amp; PULIZIA" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <StackPanel>
                                <TextBlock Text="Pulisci file temporanei e vecchi pacchetti di update" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                <TextBlock Text="Elimina pacchetti ZIP scaricati in precedenza, cartelle di staging e file di log obsoleti per liberare spazio su disco."
                                           Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,12" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                <Grid>
                                    <Button Style="{StaticResource ExploreBtnGhost}" Content="🧹 Pulisci adesso"
                                            Click="CleanTempFiles_Click" HorizontalAlignment="Left" Padding="14,6" FontSize="12"/>
                                    <TextBlock Text="{Binding MaintenanceMessage}" Foreground="#30D158" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
