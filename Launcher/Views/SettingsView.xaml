                                        <TextBlock Text="Archivi .zip scaricati" Foreground="#52525A" FontSize="10"/>
                                    </StackPanel>

                                    <!-- Temp & Staging -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="TEMP &amp; STAGING" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
