                                <Button Content="Open" Style="{StaticResource PrimaryActionPillButtonStyle}" Click="OpenResourcePacksDir_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 5. Shader Packs -->
