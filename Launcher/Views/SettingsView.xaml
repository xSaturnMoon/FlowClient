                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="RECLAIMABLE DISK SPACE" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
