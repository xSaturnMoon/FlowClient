                        <TextBlock Text="Spazio &amp; Pulizia Disco" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Analisi dello spazio occupato e pulizia sicura di file temporanei e pacchetti di aggiornamento."
