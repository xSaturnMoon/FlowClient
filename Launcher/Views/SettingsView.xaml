                                <Button Content="Copy" Style="{StaticResource ActionPillButtonStyle}" Click="CopyPath_Click" Tag="{Binding WorldsDirectory}" Margin="0,0,8,0"/>
                                <Button Content="Open" Style="{StaticResource PrimaryActionPillButtonStyle}" Click="OpenWorldsDir_Click"/>
                            </StackPanel>
