                        </Border>

                        <!-- Custom JVM Arguments -->
                        <TextBlock Text="PARAMETRI JVM AVANZATI" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,12,0,8"/>
