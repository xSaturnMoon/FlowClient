                                    <Border Background="#1C1D24" CornerRadius="4" Padding="7,3" Margin="0,0,6,6"><TextBlock Text="✓ Motion Blur" Foreground="#A0A5B5" FontSize="10.5" FontWeight="SemiBold"/></Border>
                                    <Border Background="#1C1D24" CornerRadius="4" Padding="7,3" Margin="0,0,6,6"><TextBlock Text="✓ Hitboxes &amp; Chunk Borders" Foreground="#A0A5B5" FontSize="10.5" FontWeight="SemiBold"/></Border>
                                    <Border Background="#1C1D24" CornerRadius="4" Padding="7,3" Margin="0,0,6,6"><TextBlock Text="✓ Zoomify &amp; Freelook" Foreground="#A0A5B5" FontSize="10.5" FontWeight="SemiBold"/></Border>
                                    <Border Background="#1C1D24" CornerRadius="4" Padding="7,3" Margin="0,0,6,6"><TextBlock Text="✓ Armor &amp; Item Durability" Foreground="#A0A5B5" FontSize="10.5" FontWeight="SemiBold"/></Border>
