                                    </StackPanel>

                                    <!-- Logs & Crash reports -->
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="LOG &amp; REPORT STORICI" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding LogsSizeText}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="Crash e log compressi" Foreground="#52525A" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Action Card 1: Clean Temp & Update Cache -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧹 Pulisci file temporanei e pacchetti di update" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <TextBlock Text="Elimina in modo sicuro gli archivi ZIP degli aggiornamenti scaricati e i residui nella cartella Temp per recuperare spazio su disco."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ExploreBtnPrimary}" Content="Pulisci Ora"
                                        Click="CleanTempFiles_Click" VerticalAlignment="Center" Padding="16,8" FontSize="12.5" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Action Card 2: Clean Old Logs & Crashes -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="🗑️ Pulisci vecchi log e crash report" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Rimuove i file diagnostici di crash e i vecchi registri di gioco archiviati (.log.gz)."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ExploreBtnGhost}" Content="Pulisci Log"
                                        Click="CleanLogsAndCrashes_Click" VerticalAlignment="Center" Padding="16,8" FontSize="12.5"/>
                            </Grid>
                        </Border>

                        <!-- Feedback Message Banner -->
                        <Border Background="#10241A" BorderBrush="#1C4B33" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,6,0,0"
                                Visibility="{Binding CleanupResultText, Converter={StaticResource StrNotEmptyToVis}}">
                            <Grid>
                                <TextBlock Text="{Binding CleanupResultText}" Foreground="#34D399" FontSize="12.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ 6. INTERFACCIA & UI ══════ -->
                    <StackPanel Visibility="{Binding IsAppearanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Interfaccia &amp; UI" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Personalizzazione grafica, animazioni e preferenze del launcher."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="EFFETTI E TRANSIZIONI" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- UI Animations -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Animazioni e transizioni fluide" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Abilita transizioni di scorrimento eleganti tra le schede e gli stati di avvio."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding UiAnimations, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Auto Check Updates -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Controllo automatico aggiornamenti all'avvio" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Verifica in background se è presente una nuova versione ufficiale di Flow Client."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Reset Defaults -->
                        <TextBlock Text="GESTIONE CONFIGURAZIONE" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,16,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Ripristina tutte le impostazioni" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Reimposta le preferenze di memoria, avvio e interfaccia ai valori di fabbrica." Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="Ripristina Predefinite" Click="ResetDefaults_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6" FontSize="11.5"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ 7. INFO & DIAGNOSTICA ══════ -->
                    <StackPanel Visibility="{Binding IsAboutCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Info &amp; Diagnostica" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Informazioni sulla versione, verifica aggiornamenti e supporto."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Release Card -->
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Flow Client" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat='Rilasciato il {0}'}" Foreground="#7E7E84" FontSize="12" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding InstallDate, StringFormat='Installato su questo PC: {0}'}" Foreground="#55555C" FontSize="11" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <Border Background="#1C2F52" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="#60A5FA" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1" Fill="#1E1E24" Margin="0,14,0,14"/>

                                <!-- Update Check Row -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource ExploreBtnPrimary}" Content="Verifica aggiornamenti"
                                                Click="CheckUpdatesNow_Click" Padding="14,8" FontSize="12"/>

                                        <!-- Download and Install button (when update found) -->
                                        <Button Style="{StaticResource ExploreBtnPlay}" Click="InstallUpdateNow_Click"
                                                Margin="12,0,0,0" Padding="16,8" FontSize="12" FontWeight="Bold"
                                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ Scarica &amp; Installa v" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LatestVersion}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Status message -->
                                    <TextBlock Text="{Binding UpdateCheckMessage}" Foreground="#93C5FD" FontSize="12"
                                               FontFamily="{StaticResource NunitoFont}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"
                                               MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Diagnostics Copy -->
                        <TextBlock Text="SUPPORTO TECNICO" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Copia Report Diagnostico di Sistema" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Genera un riepilogo formattato con hardware, versione Java, memoria allocata e percorsi per facilitare l'assistenza e il debug."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <Button Style="{StaticResource ExploreBtnGhost}" Content="📋 Copia Report" Click="CopyDiagnostic_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
