                            Margin="4,0,4,8"/>

                    <!-- Warning if > 75% RAM -->
                    <Border Background="#261C12" CornerRadius="12" Padding="12,8" Margin="0,4,0,14"
                            Visibility="{Binding IsRamWarningVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠️ Warning: Allocating more than 75% of your system RAM may reduce Windows stability."
                                   Foreground="#F59E0B" FontSize="11.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                    </Border>

                    <!-- Group 3: Java Runtime -->
                    <TextBlock Text="JAVA RUNTIME" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,12,0,10"/>
