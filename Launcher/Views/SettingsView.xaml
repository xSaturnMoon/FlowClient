<UserControl x:Class="Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>

            <!-- Category Tab Button Style -->
            <Style x:Key="SettingsCategoryTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#8E8E93"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Launch action option card style -->
            <Style x:Key="LaunchActionCard" TargetType="Button">
                <Setter Property="Background" Value="#111113"/>
                <Setter Property="BorderBrush" Value="#1E1E22"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,13"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#303038"/>
                                    <Setter TargetName="b" Property="Background" Value="#151518"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- RAM selector chip -->
            <Style x:Key="RamChipButton" TargetType="Button">
                <Setter Property="Background" Value="#161619"/>
                <Setter Property="BorderBrush" Value="#25252A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="13,7"/>
                <Setter Property="Margin" Value="0,0,7,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#222228"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Folder Card Style -->
            <Style x:Key="FolderDirectoryCard" TargetType="Border">
                <Setter Property="Background" Value="#131316"/>
                <Setter Property="BorderBrush" Value="#1F1F24"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <!-- Custom JVM Args TextBox Style -->
            <Style x:Key="ExploreTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#111114"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#25252A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CaretBrush" Value="#3B82F6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid Margin="32,28,32,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ LEFT: CATEGORY SIDEBAR (SVG OUTLINE ICONS) ══════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                    <TextBlock Text="Flow Client Configuration" Foreground="#6E6E73" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>

                <!-- Categories list with clean SVG icons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Group: MINECRAFT -->
                        <TextBlock Text="MINECRAFT &amp; GAME" Foreground="#52525A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="8,0,0,6"/>

                        <!-- 1. Launch -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Launch">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4.5,16.5 L7.5,19.5 M15,4.5 L19.5,9 M15,4.5 C12,1.5 6.5,4 4,6.5 C6.5,9 9,11.5 12,14.5 C15,11.5 17.5,9 20,6.5 C17.5,4 15,4.5 15,4.5 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Launch &amp; Game" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLaunchCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 2. Performance -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Performance">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M13,2 L3,14 H12 L11,22 L21,10 H12 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Java &amp; Performance" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPerformanceCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 3. Mods -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Mods">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4,9 A2,2 0 0,0 4,13 H5 A2,2 0 0,1 7,15 V16 A2,2 0 0,0 11,16 V15 A2,2 0 0,1 13,13 H14 A2,2 0 0,0 14,9 H13 A2,2 0 0,1 11,7 V6 A2,2 0 0,0 7,6 V7 A2,2 0 0,1 5,9 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Mods &amp; Features" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModsCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 4. Folders -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Folders">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3,7 A2,2 0 0,1 5,5 H9 L11,7 H19 A2,2 0 0,1 21,9 V18 A2,2 0 0,1 19,20 H5 A2,2 0 0,1 3,18 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Folders &amp; Resources" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFoldersCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Group: SISTEMA -->
                        <TextBlock Text="SYSTEM &amp; MAINTENANCE" Foreground="#52525A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="8,14,0,6"/>

                        <!-- 5. Storage -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Storage">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19,11 H5 M19,7 H5 M19,15 H5 M21,3 H3 A1,1 0 0,0 2,4 V20 A1,1 0 0,0 3,21 H21 A1,1 0 0,0 22,20 V4 A1,1 0 0,0 21,3 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Storage &amp; Cleanup" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStorageCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Group: FLOW CLIENT -->
                        <TextBlock Text="FLOW CLIENT" Foreground="#52525A" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="8,14,0,6"/>

                        <!-- 6. Appearance -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="Appearance">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C13.5,22 14.5,21 14.5,19.5 C14.5,18.8 14.2,18.2 13.8,17.7 C13.4,17.2 13.2,16.6 13.2,16 C13.2,14.9 14.1,14 15.2,14 H17 C19.8,14 22,11.8 22,9 C22,5.1 17.5,2 12,2 Z"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Appearance &amp; UI" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAppearanceCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- 7. About -->
                        <Button Style="{StaticResource SettingsCategoryTab}" Click="CategoryTab_Click" Tag="About">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,16 V12 M12,8 H12.01"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="About &amp; Diagnostics" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAboutCategory}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Back button -->
                <Button Grid.Row="2" Content="← Back to Home" Style="{StaticResource ExploreBtnGhost}"
                        Click="BackToLaunch_Click" Margin="0,10,0,0" HorizontalAlignment="Left"
                        FontFamily="{StaticResource NunitoFont}" FontSize="12.5"/>
            </Grid>

            <!-- ══════ RIGHT: MAIN CONTENT VIEWPORT ══════ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,10,0">

                    <!-- ══════ 1. AVVIO & GIOCO ══════ -->
                    <StackPanel Visibility="{Binding IsLaunchCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Launch &amp; Game" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Configure Flow Client behavior during Minecraft launch and game sessions."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <TextBlock Text="LAUNCH BEHAVIOR" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>

                        <!-- Option 1: Hide while playing (Recommended) -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐ Hide while playing" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                        <Border Background="#1C3829" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="RECOMMENDED" Foreground="#30D158" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Hides the launcher while playing to free system resources. Automatically reappears when Minecraft closes."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionHide, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 2: Minimize -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minimize to taskbar" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Keeps the launcher minimized in the taskbar during your game session."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionMinimize, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 3: Keep Open -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Keep open" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Leaves the client open in the background for instant access to tabs and settings."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionKeepOpen, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Option 4: Close When Game Ready -->
                        <Button Style="{StaticResource LaunchActionCard}" Click="LaunchAction_Click" Tag="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Close when game starts" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Completely closes Flow Client as soon as Minecraft is loaded to maximize FPS."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" IsChecked="{Binding IsActionClose, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Extra Launch Options -->
                        <TextBlock Text="ADDITIONAL OPTIONS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,14,0,8"/>

                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Confirm before aborting launch" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Show a confirmation prompt before stopping an active download or launch."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding ConfirmBeforeStop, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ExploreSettingCard}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Discord Rich Presence" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="Show your playing status, active Minecraft version, and server on Discord."
                                               Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ExploreToggle}" HorizontalAlignment="Right"
                                          IsChecked="{Binding EnableDiscordRpc, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ 2. JAVA & PRESTAZIONI ══════ -->
                    <StackPanel Visibility="{Binding IsPerformanceCategory, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Java &amp; Performance" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,3"/>
                        <TextBlock Text="Memory allocation, JVM arguments, and system hardware specifications."
                                   Foreground="#7E7E84" FontSize="13" Margin="0,0,0,18" FontFamily="{StaticResource NunitoFont}"/>

                        <!-- Hardware Info Card -->
                        <TextBlock Text="DETECTED HARDWARE SPECIFICATIONS" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="PROCESSOR (CPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding CpuName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- GPU -->
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Text="GRAPHICS CARD (GPU)" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding GpuName}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>

                                <!-- RAM -->
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="TOTAL SYSTEM RAM" Foreground="#6E6E73" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                    <TextBlock Text="{Binding TotalRam}" Foreground="#3B82F6" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- RAM Allocation -->
                        <TextBlock Text="INSTANCE RAM ALLOCATION" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Default allocated RAM" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
                                        <TextBlock Text="{Binding RamUsagePercentText}" Foreground="#7E7E84" FontSize="11.5" Margin="0,2,0,0" FontFamily="{StaticResource NunitoFont}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DefaultRamGbText}" Foreground="#3B82F6" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- RAM Ratio Bar -->
                                <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding RamUsageRatio, Mode=OneWay}"
                                             Background="#222228" Foreground="#3B82F6" BorderThickness="0" Margin="0,12,0,6"/>

                                <!-- Warning if > 75% RAM -->
                                <Border Background="#261C12" BorderBrush="#5E381A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,10"
                                        Visibility="{Binding IsRamWarningVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⚠️ Warning: Allocating more than 75% of your system RAM may reduce Windows stability."
                                               Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Preset chips -->
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource RamChipButton}" Content="2 GB" Click="RamPreset_Click" Tag="2048"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="4 GB (Recommended)" Click="RamPreset_Click" Tag="4096"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="6 GB" Click="RamPreset_Click" Tag="6144"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="8 GB" Click="RamPreset_Click" Tag="8192"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="12 GB" Click="RamPreset_Click" Tag="12288"/>
                                    <Button Style="{StaticResource RamChipButton}" Content="16 GB" Click="RamPreset_Click" Tag="16384"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Java Runtime -->
                        <TextBlock Text="JAVA RUNTIME" Foreground="#6E6E73" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="0,12,0,8"/>
                        <Border Style="{StaticResource ExploreSettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="System Java Executable" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}"/>
