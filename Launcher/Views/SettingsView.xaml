                                       FontFamily="{StaticResource NunitoFont}" Foreground="#6E6E73" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1E1E22" BorderThickness="0" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DefaultRamGbText}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}"/>
                        </Border>
                    </Grid>

                    <!-- RAM Presets Capsule Pills -->
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="2 GB" Style="{StaticResource Ram2PillStyle}" Click="RamPreset_Click" Tag="2048"/>
                        <Button Content="4 GB" Style="{StaticResource Ram4PillStyle}" Click="RamPreset_Click" Tag="4096"/>
