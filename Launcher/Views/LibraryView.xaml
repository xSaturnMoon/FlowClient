<UserControl x:Class="Launcher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#101010">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Back Button Style for Instance Settings -->
        <Style x:Key="LibraryBackBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#181920"/>
            <Setter Property="BorderBrush" Value="#2A2B36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22242D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Center Settings Button Style inside Card -->
        <Style x:Key="CenterSettingsPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="#D0181822"
                                BorderBrush="#60FFFFFF"
                                BorderThickness="1.5"
                                CornerRadius="24">
                            <Path x:Name="GearPath"
                                  Data="M 12 15 C 10.343 15 9 13.657 9 12 C 9 10.343 10.343 9 12 9 C 13.657 9 15 10.343 15 12 C 15 13.657 13.657 15 12 15 Z M 19.43 12.98 C 19.47 12.66 19.5 12.34 19.5 12 C 19.5 11.66 19.47 11.34 19.43 11.02 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L 16.56 6.05 C 16.04 5.65 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.73 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.02 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.66 4.57 12.98 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.72 19.03 4.95 18.95 L 7.44 17.95 C 7.96 18.35 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.28 19.04 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.98 Z"
                                  Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Installed Version Card DataTemplate -->
        <DataTemplate x:Key="InstalledVersionCardTemplate">
            <Border x:Name="CardRoot"
                    Width="185" Height="260"
                    Margin="0,0,22,22"
                    CornerRadius="16"
                    Background="#16171B"
                    BorderBrush="#25262E"
                    BorderThickness="1.5"
                    Cursor="Hand"
                    ClipToBounds="True"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>

                <Grid>
                    <!-- Background layers -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="168"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Poster Artwork Area -->
                        <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                            <Grid>
                                <!-- Atmospheric Gradient -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#252733" Offset="0.0"/>
                                            <GradientStop Color="#191B24" Offset="0.6"/>
                                            <GradientStop Color="#14151C" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Stylized Minecraft Visual Centerpiece -->
                                <Image Source="/Assets/grass_block.png" Width="76" Height="76"
                                       Opacity="0.45" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Badges row on top of poster -->
                                <Grid Margin="10,10,10,0" VerticalAlignment="Top">
                                    <!-- Loader Badge -->
                                    <Border Background="#90000000" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding LoaderIconUri}" Width="13" Height="13" Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Loader}" Foreground="#E0E0E6" FontSize="10.5" FontWeight="Bold"
                                                       FontFamily="{StaticResource NunitoFont}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Version Badge -->
                                    <Border Background="#90000000" CornerRadius="6" Padding="7,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MinecraftVersion}" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoFont}"/>
                                    </Border>
                                </Grid>

                                <!-- Gradient shade toward bottom of top half -->
                                <Border VerticalAlignment="Bottom" Height="36">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#16171B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom Details Area -->
                        <Grid Grid.Row="1" Margin="14,6,14,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoBoldFont}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding LastPlayedText, StringFormat='Last played: {0}'}"
                                           Foreground="#787985" FontSize="11" Margin="0,4,0,0"
                                           FontFamily="{StaticResource NunitoFont}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Active Selection Border Highlight -->
                    <Border BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="16"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False"/>

                    <!-- Grayish Overlay (Fades in on hover) -->
                    <Border x:Name="HoverOverlay"
                            Background="#45121216"
                            CornerRadius="16"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                    <!-- Centered Settings Icon (Fades in on hover) -->
                    <Button x:Name="CenterSettingsBtn"
                            Style="{StaticResource CenterSettingsPillButtonStyle}"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Tag="{Binding}"
                            Click="SettingsButton_Click"/>
                </Grid>
            </Border>

            <!-- Interactive Hover Animations (Zoom, Gray Dim, Center Settings Icon) -->
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Scale up slightly (Zoom) -->
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.04" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.04" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Grayish Dim Overlay -->
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.18"/>

                                <!-- Center Settings Button -->
                                <DoubleAnimation Storyboard.TargetName="CenterSettingsBtn"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.18"/>

                                <!-- Border illumination -->
                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#424452" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Return Scale -->
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Remove Grayish Overlay -->
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.0" Duration="0:0:0.18"/>

                                <!-- Hide Center Settings Button -->
                                <DoubleAnimation Storyboard.TargetName="CenterSettingsBtn"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.0" Duration="0:0:0.18"/>

                                <!-- Return Border color -->
                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#25262E" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#101010">

        <!-- ══════════════ 1. INSTALLED VERSIONS GRID VIEW ══════════════ -->
        <Grid Visibility="{Binding IsViewingGrid, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header: "Installed Version" styled identical to reference image "Browse by game" -->
            <Grid Grid.Row="0" Margin="36,28,36,18">
                <TextBlock Text="Installed Version"
                           Foreground="#FFFFFF"
                           FontSize="26"
                           FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Main Scrollable Area for Version Cards -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,6,14,32"
                          FocusVisualStyle="{x:Null}">
                <Grid>
                    <!-- Cards Grid -->
                    <ItemsControl ItemsSource="{Binding FilteredVersions}"
                                  ItemTemplate="{StaticResource InstalledVersionCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Empty State (When no instances are found) -->
                    <Border Background="#14151B" BorderBrush="#20212A" BorderThickness="1" CornerRadius="16"
                            Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No Installed Versions Found" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Installed Minecraft versions will appear here as rounded poster cards."
                                       Foreground="#72737D" FontSize="13" FontFamily="{StaticResource NunitoFont}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════ 2. INSTANCE SETTINGS PAGE (EMPTY / CLEAN PLACEHOLDER) ══════════════ -->
        <Grid Visibility="{Binding IsViewingSettings, Converter={StaticResource BoolToVis}}"
              Margin="36,24,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Bar & Header for Specific Instance -->
            <StackPanel Grid.Row="0">
                <!-- Back Button to Library -->
                <Button Style="{StaticResource LibraryBackBtnStyle}" Click="BackToLibrary_Click" Margin="0,0,0,18" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 12,2 L 4,10 L 12,18"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Library" FontSize="13" FontWeight="Bold"
                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Instance Banner -->
                <Border Background="#14151B" BorderBrush="#23242E" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon / Loader Badge -->
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="#1D202A" Margin="0,0,18,0">
                            <Image Source="{Binding SelectedSettingsInstance.LoaderIconUri}" Width="30" Height="30"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name & Metadata Pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSettingsInstance.Name}" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#1E293B" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedSettingsInstance.MinecraftVersion, StringFormat='Minecraft {0}'}"
                                               Foreground="#60A5FA" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                                <Border Background="#2E1C25" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedSettingsInstance.Loader}"
                                               Foreground="#F472B6" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                                <Border Background="#1E1E26" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedSettingsInstance.LastPlayedText, StringFormat='Last played: {0}'}"
                                               Foreground="#858592" FontSize="11" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Clean / Empty Container (Ready for next features) -->
            <Border Grid.Row="1" Background="#121317" BorderBrush="#202129" BorderThickness="1.5" CornerRadius="16" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                    <Border Background="#1B1C24" Width="64" Height="64" CornerRadius="32" Margin="0,0,0,18" HorizontalAlignment="Center">
                        <Path Data="M 12 15 C 10.343 15 9 13.657 9 12 C 9 10.343 10.343 9 12 9 C 13.657 9 15 10.343 15 12 C 15 13.657 13.657 15 12 15 Z M 19.43 12.98 C 19.47 12.66 19.5 12.34 19.5 12 C 19.5 11.66 19.47 11.34 19.43 11.02 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L 16.56 6.05 C 16.04 5.65 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.73 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.02 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.66 4.57 12.98 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.72 19.03 4.95 18.95 L 7.44 17.95 C 7.96 18.35 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.28 19.04 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.98 Z"
                              Fill="#7E8295" Width="26" Height="26" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Version Settings" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                    <TextBlock Text="This configuration view is clean and prepared for upcoming features."
                               Foreground="#6E7080" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"
                               FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
