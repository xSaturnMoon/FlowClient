<UserControl x:Class="Launcher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#101010">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Back Button Style for Instance Settings (Clean Neutral, No Blue) -->
        <Style x:Key="LibraryBackBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181D"/>
            <Setter Property="BorderBrush" Value="#2E2E36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D0D0D5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#282830"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60606D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pure Settings Gear Button (1.5x Larger, No Circle Container, No Blue) -->
        <Style x:Key="CenterSettingsCleanButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GearScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <!-- 1.5x Larger Gear (36px), Drop Shadow for maximum contrast, No Circle -->
                            <Path x:Name="GearPath"
                                  Data="M 12 15 C 10.343 15 9 13.657 9 12 C 9 10.343 10.343 9 12 9 C 13.657 9 15 10.343 15 12 C 15 13.657 13.657 15 12 15 Z M 19.43 12.98 C 19.47 12.66 19.5 12.34 19.5 12 C 19.5 11.66 19.47 11.34 19.43 11.02 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L 16.56 6.05 C 16.04 5.65 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.73 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.02 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.66 4.57 12.98 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.72 19.03 4.95 18.95 L 7.44 17.95 C 7.96 18.35 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.28 19.04 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.98 Z"
                                  Fill="#EEEEEE" Width="36" Height="36" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.95" Color="#000000"/>
                                </Path.Effect>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GearPath" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.14" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.14" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Lunar-Style Version Card DataTemplate -->
        <DataTemplate x:Key="InstalledVersionCardTemplate">
            <Border x:Name="CardRoot"
                    Width="320" Height="155"
                    Margin="0,0,24,24"
                    CornerRadius="12"
                    BorderBrush="#25262D"
                    BorderThickness="1.5"
                    Cursor="Hand"
                    ClipToBounds="True"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>

                <Border.Background>
                    <ImageBrush ImageSource="{Binding ArtworkUri}"
                                Stretch="UniformToFill"
                                AlignmentX="Center" AlignmentY="Center"/>
                </Border.Background>

                <Grid>
                    <!-- 1. Dark Vignette / Contrast Overlay for perfect text readability -->
                    <Border CornerRadius="10.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#45000000" Offset="0.0"/>
                                <GradientStop Color="#15000000" Offset="0.45"/>
                                <GradientStop Color="#85000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 2. Top Badges (Loader + Version) -->
                    <Grid Margin="12,10,12,0" VerticalAlignment="Top">
                        <!-- Loader Pill Top-Left -->
                        <Border Background="#95000000" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding LoaderIconUri}" Width="13" Height="13" Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loader}" Foreground="#E5E5E8" FontSize="11" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Border>

                        <!-- Version Pill Top-Right -->
                        <Border Background="#95000000" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MinecraftVersion}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}"/>
                        </Border>
                    </Grid>

                    <!-- 3. Prominent Center Title & Subtitle (Like Lunar Client) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="#FFFFFF"
                                   FontSize="23"
                                   FontWeight="ExtraBold"
                                   FontFamily="{StaticResource NunitoBoldFont}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="290">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.9" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding SubtitleText}"
                                   Foreground="#D2D2D8"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource NunitoFont}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- 4. Active Selection Border Highlight (Neutral Crisp White, No Blue) -->
                    <Border BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="10.5"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.45" Color="#FFFFFF"/>
                        </Border.Effect>
                    </Border>

                    <!-- 5. Grayish Dimming Overlay (Fades in on hover) -->
                    <Border x:Name="HoverOverlay"
                            Background="#50000000"
                            CornerRadius="10.5"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                    <!-- 6. Centered Settings Icon (1.5x Bigger, No Circle, No Blue) -->
                    <Button x:Name="CenterSettingsBtn"
                            Style="{StaticResource CenterSettingsCleanButtonStyle}"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Tag="{Binding}"
                            Click="SettingsButton_Click"/>
                </Grid>
            </Border>

            <!-- Card Hover Triggers: Zoom, Gray Dim, Center Settings Icon -->
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Scale up slightly -->
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.03" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.03" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Grayish Dimming -->
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.18"/>

                                <!-- Show Center Settings Button -->
                                <DoubleAnimation Storyboard.TargetName="CenterSettingsBtn"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.18"/>

                                <!-- Border highlight (clean neutral gray, no blue) -->
                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#505058" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Return Scale -->
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Remove Grayish Dimming -->
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.0" Duration="0:0:0.18"/>

                                <!-- Hide Settings Button -->
                                <DoubleAnimation Storyboard.TargetName="CenterSettingsBtn"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.0" Duration="0:0:0.18"/>

                                <!-- Return Border color -->
                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#25262D" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#101010">

        <!-- ══════════════ 1. INSTALLED VERSIONS GRID VIEW ══════════════ -->
        <Grid Visibility="{Binding IsViewingGrid, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header: "Installed Version" styled after reference image -->
            <Grid Grid.Row="0" Margin="36,28,36,18">
                <TextBlock Text="Installed Version"
                           Foreground="#FFFFFF"
                           FontSize="26"
                           FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Main Scrollable Area for Horizontal Poster Cards -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,6,14,32"
                          FocusVisualStyle="{x:Null}">
                <Grid>
                    <!-- Horizontal Cards Grid -->
                    <ItemsControl ItemsSource="{Binding FilteredVersions}"
                                  ItemTemplate="{StaticResource InstalledVersionCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Empty State (When no instances are found) -->
                    <Border Background="#14151B" BorderBrush="#20212A" BorderThickness="1" CornerRadius="12"
                            Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No Installed Versions Found" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Installed Minecraft versions will appear here as horizontal banner cards."
                                       Foreground="#72737D" FontSize="13" FontFamily="{StaticResource NunitoFont}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════ 2. INSTANCE SETTINGS PAGE (CLEAN / EMPTY PLACEHOLDER) ══════════════ -->
        <Grid Visibility="{Binding IsViewingSettings, Converter={StaticResource BoolToVis}}"
              Margin="36,24,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Bar & Header for Specific Instance -->
            <StackPanel Grid.Row="0">
                <!-- Back Button to Library (Neutral, No Blue) -->
                <Button Style="{StaticResource LibraryBackBtnStyle}" Click="BackToLibrary_Click" Margin="0,0,0,18" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 12,2 L 4,10 L 12,18"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Library" FontSize="13" FontWeight="Bold"
                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Instance Banner (Artwork + Name + Tags) -->
                <Border Background="#14151B" BorderBrush="#24252D" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Artwork Thumbnail -->
                        <Border Grid.Column="0" Width="80" Height="48" CornerRadius="8" Margin="0,0,18,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding SelectedSettingsInstance.ArtworkUri}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <!-- Name & Metadata Pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSettingsInstance.Name}" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#1E1F26" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedSettingsInstance.MinecraftVersion, StringFormat='Minecraft {0}'}"
                                               Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                                <Border Background="#25252E" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedSettingsInstance.Loader}"
                                               Foreground="#D5D5DC" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                                <Border Background="#1C1C22" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedSettingsInstance.LastPlayedText, StringFormat='Last played: {0}'}"
                                               Foreground="#858592" FontSize="11" FontFamily="{StaticResource NunitoFont}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Clean / Empty Container (Ready for next features) -->
            <Border Grid.Row="1" Background="#121317" BorderBrush="#202129" BorderThickness="1.5" CornerRadius="12" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                    <Border Background="#1A1B22" Width="64" Height="64" CornerRadius="32" Margin="0,0,0,18" HorizontalAlignment="Center">
                        <Path Data="M 12 15 C 10.343 15 9 13.657 9 12 C 9 10.343 10.343 9 12 9 C 13.657 9 15 10.343 15 12 C 15 13.657 13.657 15 12 15 Z M 19.43 12.98 C 19.47 12.66 19.5 12.34 19.5 12 C 19.5 11.66 19.47 11.34 19.43 11.02 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L 16.56 6.05 C 16.04 5.65 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.73 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.02 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.66 4.57 12.98 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.72 19.03 4.95 18.95 L 7.44 17.95 C 7.96 18.35 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.28 19.04 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.98 Z"
                              Fill="#80808C" Width="26" Height="26" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Version Settings" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                    <TextBlock Text="This configuration view is clean and prepared for upcoming features."
                               Foreground="#70707C" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"
                               FontFamily="{StaticResource NunitoFont}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
