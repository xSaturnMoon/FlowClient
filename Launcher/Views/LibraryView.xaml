<UserControl x:Class="Launcher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:conv="clr-namespace:Launcher.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#101010">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToImageSourceConverter x:Key="ImgSrc"/>

        <!-- Capsule "Search Bar Style" Back Button (Borderless, Clean, No Blue) -->
        <Style x:Key="LibraryCapsuleBackBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D0D0D6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27272D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18181C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Sub-Tab Pill Style -->
        <Style x:Key="SettingsSubTabPillStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9C9C9D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="17" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#27272D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RAM Preset Capsule Pill Style -->
        <Style x:Key="RamPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9C9C9D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="16" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#27272D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Capsule Pill Button Style -->
        <Style x:Key="ActionPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="19" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#27272D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Custom Ram Slider Style -->
        <Style x:Key="ModernRamSliderStyle" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track Base (Inactive Background) -->
                            <Border Height="6" Background="#28282E" CornerRadius="3" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="#FFFFFF" CornerRadius="3,0,0,3" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Ellipse x:Name="thumbCircle" Width="18" Height="18" Fill="#FFFFFF"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.45" Color="#000000"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbCircle" Property="Width" Value="20"/>
                                                        <Setter TargetName="thumbCircle" Property="Height" Value="20"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbCircle" Property="Width" Value="20"/>
                                                        <Setter TargetName="thumbCircle" Property="Height" Value="20"/>
                                                        <Setter TargetName="thumbCircle" Property="Fill" Value="#E0E0E0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Animated Toggle Switch Style -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="13" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#28282E"/>
                                </Border.Background>
                            </Border>
                            <Ellipse x:Name="Knob" Width="20" Height="20"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"
                                     SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="KnobBrush" Color="#6E6E76"/>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslate" X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#121214"/>
                                <Setter TargetName="Knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#FFFFFF" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                            To="#121214" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#28282E" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                            To="#6E6E76" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Icon Delete Button Style -->
        <Style x:Key="IconDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style for Modrinth Versions -->
        <Style x:Key="ModrinthVersionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#25252B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="{StaticResource NunitoBoldFont}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="Background" Value="#1C1C20"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="FontFamily" Value="{StaticResource NunitoFont}"/>
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2B2B33"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#383842"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="14" Background="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Background}"
                                                Padding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Padding}" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=SelectionBoxItem}"
                                                                  ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=SelectionBoxItemTemplate}"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#8E8E93" Width="8" Height="5" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2F2F37"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" Focusable="False" MaxHeight="200">
                                <Border x:Name="DropDownBorder" Background="#1C1C20" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtab Pills for Modrinth Categories -->
        <Style x:Key="ModrinthSubTabModsBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModrinthModsSelected}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#101010"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModrinthSubTabTexturesBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModrinthTexturesSelected}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#101010"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModrinthSubTabShadersBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsSubTabPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModrinthShadersSelected}" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#101010"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pure Settings Gear Button (1.5x Larger, No Circle Container, No Blue) -->
        <Style x:Key="CenterSettingsCleanButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GearScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <!-- 1.5x Larger Gear (36px), Drop Shadow for maximum contrast, No Circle -->
                            <Path x:Name="GearPath"
                                  Data="M 12 15 C 10.343 15 9 13.657 9 12 C 9 10.343 10.343 9 12 9 C 13.657 9 15 10.343 15 12 C 15 13.657 13.657 15 12 15 Z M 19.43 12.98 C 19.47 12.66 19.5 12.34 19.5 12 C 19.5 11.66 19.47 11.34 19.43 11.02 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.97 19.05 5.05 L 16.56 6.05 C 16.04 5.65 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.73 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.02 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.66 4.57 12.98 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.72 19.03 4.95 18.95 L 7.44 17.95 C 7.96 18.35 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.28 19.04 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.98 Z"
                                  Fill="#EEEEEE" Width="36" Height="36" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.95" Color="#000000"/>
                                </Path.Effect>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GearPath" Property="Fill" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.14" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.14" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="GearScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Lunar-Style Version Card DataTemplate -->
        <DataTemplate x:Key="InstalledVersionCardTemplate">
            <Border x:Name="CardRoot"
                    Width="320" Height="155"
                    Margin="0,0,24,24"
                    CornerRadius="12"
                    BorderBrush="#25262D"
                    BorderThickness="1.5"
                    Cursor="Hand"
                    ClipToBounds="True"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>

                <Border.Background>
                    <ImageBrush ImageSource="{Binding ArtworkUri}"
                                Stretch="UniformToFill"
                                AlignmentX="Center" AlignmentY="Center"/>
                </Border.Background>

                <Grid>
                    <!-- 1. Dark Vignette / Contrast Overlay for perfect text readability -->
                    <Border CornerRadius="10.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#45000000" Offset="0.0"/>
                                <GradientStop Color="#15000000" Offset="0.45"/>
                                <GradientStop Color="#85000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 2. Top Badges (Loader + Version) -->
                    <Grid Margin="12,10,12,0" VerticalAlignment="Top">
                        <!-- Loader Pill Top-Left -->
                        <Border Background="#95000000" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding LoaderIconUri}" Width="13" Height="13" Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loader}" Foreground="#E5E5E8" FontSize="11" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Border>

                        <!-- Version Pill Top-Right -->
                        <Border Background="#95000000" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MinecraftVersion}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}"/>
                        </Border>
                    </Grid>

                    <!-- 3. Prominent Center Title & Subtitle (Like Lunar Client) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   Foreground="#FFFFFF"
                                   FontSize="23"
                                   FontWeight="ExtraBold"
                                   FontFamily="{StaticResource NunitoBoldFont}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="290">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.9" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding SubtitleText}"
                                   Foreground="#D2D2D8"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource NunitoFont}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- 4. Active Selection Border Highlight (Neutral Crisp White, No Blue) -->
                    <Border BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="10.5"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.45" Color="#FFFFFF"/>
                        </Border.Effect>
                    </Border>

                    <!-- 5. Grayish Dimming Overlay (Fades in on hover) -->
                    <Border x:Name="HoverOverlay"
                            Background="#50000000"
                            CornerRadius="10.5"
                            Opacity="0"
                            IsHitTestVisible="False"/>

                    <!-- 6. Centered Settings Icon (1.5x Bigger, No Circle, No Blue) -->
                    <Button x:Name="CenterSettingsBtn"
                            Style="{StaticResource CenterSettingsCleanButtonStyle}"
                            Opacity="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Tag="{Binding}"
                            Click="SettingsButton_Click"/>
                </Grid>
            </Border>

            <!-- Card Hover Triggers: Zoom, Gray Dim, Center Settings Icon -->
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Scale up slightly -->
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.03" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.03" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Grayish Dimming -->
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.18"/>

                                <!-- Show Center Settings Button -->
                                <DoubleAnimation Storyboard.TargetName="CenterSettingsBtn"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.18"/>

                                <!-- Border highlight (clean neutral gray, no blue) -->
                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#505058" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Return Scale -->
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Remove Grayish Dimming -->
                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.0" Duration="0:0:0.18"/>

                                <!-- Hide Settings Button -->
                                <DoubleAnimation Storyboard.TargetName="CenterSettingsBtn"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.0" Duration="0:0:0.18"/>

                                <!-- Return Border color -->
                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#25262D" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#101010">

        <!-- ══════════════ 1. INSTALLED VERSIONS GRID VIEW ══════════════ -->
        <Grid Visibility="{Binding IsViewingGrid, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header: "Installed Version" styled after reference image -->
            <Grid Grid.Row="0" Margin="36,28,36,18">
                <TextBlock Text="Installed Version"
                           Foreground="#FFFFFF"
                           FontSize="26"
                           FontWeight="Bold"
                           FontFamily="{StaticResource NunitoBoldFont}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Main Scrollable Area for Horizontal Poster Cards -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,6,14,32"
                          FocusVisualStyle="{x:Null}">
                <Grid>
                    <!-- Horizontal Cards Grid -->
                    <ItemsControl ItemsSource="{Binding FilteredVersions}"
                                  ItemTemplate="{StaticResource InstalledVersionCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Empty State (When no instances are found) -->
                    <Border Background="#14151B" BorderBrush="#20212A" BorderThickness="1" CornerRadius="12"
                            Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No Installed Versions Found" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Installed Minecraft versions will appear here as horizontal banner cards."
                                       Foreground="#72737D" FontSize="13" FontFamily="{StaticResource NunitoFont}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════ 2. INSTANCE SETTINGS PAGE (INFO & MODS TABS) ══════════════ -->
        <Grid Visibility="{Binding IsViewingSettings, Converter={StaticResource BoolToVis}}"
              Margin="36,24,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar with Back Button + Info/Mods Subtabs -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back to Library Capsule Button -->
                <Button Grid.Column="0" Style="{StaticResource LibraryCapsuleBackBtnStyle}"
                        Click="BackToLibrary_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 8.5,2 L 2.5,7 L 8.5,12"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="8" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Back to Library" FontSize="13" FontWeight="Bold"
                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Top Action Buttons: Folder & Delete (Non-red capsule style) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Folder" Style="{StaticResource ActionPillButtonStyle}" Click="OpenFolder_Click" Margin="0,0,10,0"/>
                    <Button Content="Delete" Style="{StaticResource ActionPillButtonStyle}" Click="Delete_Click" Margin="0"/>
                </StackPanel>
            </Grid>

            <!-- Content Area ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border MaxWidth="640" HorizontalAlignment="Left" Width="640">
                    <StackPanel>
                        <!-- ══════════════ TAB 1: INFO ══════════════ -->
                        <StackPanel Visibility="{Binding IsInfoTabSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Instance Showcase Capsule Banner -->
                            <Border Background="#1E1E22" BorderThickness="0" CornerRadius="22"
                                    Height="44" Padding="14,0,18,0" Margin="0,0,0,24" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#26262B" BorderThickness="0"
                                            CornerRadius="13" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding SelectedSettingsInstance.LoaderIconUri, Converter={StaticResource ImgSrc}}"
                                               Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedSettingsInstance.Name}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,1"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedSettingsInstance.Loader}" Foreground="#A0A0AA" FontSize="10" FontWeight="Bold"
                                                       FontFamily="{StaticResource NunitoFont}"/>
                                            <TextBlock Text=" · " Foreground="#55555C" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedSettingsInstance.MinecraftVersion}" Foreground="#7E7E84" FontSize="10" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource NunitoFont}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 1. RENAME INSTANCE -->
                            <TextBlock Text="INSTANCE NAME" FontSize="11" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="4,0,0,8"/>
                            <Border Height="40" Background="#1E1E22" BorderThickness="0"
                                    CornerRadius="20" Padding="16,0" Margin="0,0,0,22" SnapsToDevicePixels="True">
                                <Grid VerticalAlignment="Center">
                                    <TextBox Text="{Binding SettingsInstanceName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                             FontSize="13.5" FontFamily="{StaticResource NunitoFont}"
                                             CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2. ALLOCATED RAM -->
                            <Grid Margin="4,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ALLOCATED RAM (MEMORY)" FontSize="11" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#1E1E22" BorderThickness="0" CornerRadius="12" Padding="10,3">
                                    <TextBlock Text="{Binding SettingsRamText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}"/>
                                </Border>
                            </Grid>

                            <!-- RAM Presets Capsule Pills -->
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="2 GB" Tag="2048" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                                <Button Content="4 GB" Tag="4096" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                                <Button Content="6 GB" Tag="6144" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                                <Button Content="8 GB" Tag="8192" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                                <Button Content="10 GB" Tag="10240" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                                <Button Content="12 GB" Tag="12288" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                                <Button Content="16 GB" Tag="16384" Style="{StaticResource RamPillButtonStyle}" Click="RamPill_Click"/>
                            </WrapPanel>

                            <!-- RAM Slider -->
                            <Slider Style="{StaticResource ModernRamSliderStyle}"
                                    Minimum="1024" Maximum="16384" SmallChange="512" LargeChange="1024"
                                    Value="{Binding SettingsRamMb, UpdateSourceTrigger=PropertyChanged}"
                                    IsSnapToTickEnabled="True" TickFrequency="512"
                                    Margin="4,0,4,16"/>
                        </StackPanel>

                        <!-- ══════════════ TAB 2: MODS ══════════════ -->
                        <StackPanel Visibility="{Binding IsModsTabSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Mods Header: Title + Count + Action Buttons -->
                            <Grid Margin="4,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="INSTALLED MODS" FontSize="11" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                    <TextBlock Text="{Binding ModsCountText}" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="{StaticResource NunitoFont}" Foreground="#66666E" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Import Mod" Style="{StaticResource ActionPillButtonStyle}"
                                            Click="ImportMod_Click" Margin="0,0,10,0"/>
                                    <Button Content="Open Mods Folder" Style="{StaticResource ActionPillButtonStyle}"
                                            Click="OpenModsFolder_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Installed Mods Items List -->
                            <ItemsControl ItemsSource="{Binding InstalledMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E22" BorderThickness="0" CornerRadius="14"
                                                Padding="14,10" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Mod Image / Icon with Hover Delete -->
                                                <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center" x:Name="IconRoot" Background="Transparent">
                                                    <Grid x:Name="IconVisuals" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="IconScale" ScaleX="1.0" ScaleY="1.0"/>
                                                        </Grid.RenderTransform>

                                                        <!-- Fallback vector cube icon -->
                                                        <Border Background="#26262B" CornerRadius="10" Width="42" Height="42"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                            <Path Data="M 12 1.75 L 3.25 6.8 V 16.95 L 12 22 L 20.75 16.95 V 6.8 L 12 1.75 Z M 12 4.1 L 18.5 7.85 L 12 11.6 L 5.5 7.85 L 12 4.1 Z M 5.25 9.85 L 11 13.15 V 19.9 L 5.25 16.55 V 9.85 Z M 13 19.9 V 13.15 L 18.75 9.85 V 16.55 L 13 19.9 Z"
                                                                  Fill="#8E8E93" Width="20" Height="20" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Actual Mod Icon: rounded border with ImageBrush and dark backplate -->
                                                        <Border Width="42" Height="42" CornerRadius="10" Background="#26262B" SnapsToDevicePixels="True"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                            <Border Width="42" Height="42" CornerRadius="10" SnapsToDevicePixels="True">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImgSrc}}"
                                                                                Stretch="UniformToFill"
                                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Dark greyish overlay on hover -->
                                                    <Border x:Name="DeleteOverlay" Width="42" Height="42" CornerRadius="10"
                                                            Background="#B0141418" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True"/>

                                                    <!-- Trash Can Delete Button -->
                                                    <Button x:Name="TrashBtn" Width="42" Height="42"
                                                            Style="{StaticResource IconDeleteButtonStyle}"
                                                            Opacity="0" IsHitTestVisible="False"
                                                            Click="DeleteMod_Click"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Delete mod">
                                                        <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>

                                                <!-- 2. Mod Title & Subtitle / Filename -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                                               FontFamily="{StaticResource NunitoBoldFont}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#7E7E84" FontSize="11"
                                                               FontFamily="{StaticResource NunitoFont}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- 3. Toggle Action (Activate / Deactivate) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                                               FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Click="ModToggle_Click"
                                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                                              ToolTip="Click to enable or disable this mod"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsMouseOver, ElementName=IconRoot}" Value="True"/>
                                                    <Condition Binding="{Binding CanDelete}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="TrashBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="TrashBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                                <Setter TargetName="TrashBtn" Property="IsHitTestVisible" Value="True"/>
                                                <Setter TargetName="IconRoot" Property="Cursor" Value="Hand"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state if no mods -->
                            <Border Background="#161619" BorderThickness="0" CornerRadius="16" Padding="32" Margin="0,10,0,0"
                                    Visibility="{Binding HasInstalledMods, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No mods installed" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click 'Import Mod' or drop your .jar mod files into the instance folder."
                                               Foreground="#7E7E84" FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                               HorizontalAlignment="Center" Margin="0,6,0,16"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Import Mod" Style="{StaticResource ActionPillButtonStyle}"
                                                Click="ImportMod_Click" Margin="0,0,10,0"/>
                                        <Button Content="Open Mods Folder" Style="{StaticResource ActionPillButtonStyle}"
                                                Click="OpenModsFolder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════ TAB 3: TEXTURES ══════════════ -->
                        <StackPanel Visibility="{Binding IsTexturesTabSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Section Title Bar with Counter & Action Buttons -->
                            <Grid Margin="4,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="TEXTURE PACKS" FontSize="11" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                    <TextBlock Text="{Binding TexturesCountText}" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="{StaticResource NunitoFont}" Foreground="#66666E" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Import Texture" Style="{StaticResource ActionPillButtonStyle}"
                                            Click="ImportTexture_Click" Margin="0,0,10,0"/>
                                    <Button Content="Open Textures Folder" Style="{StaticResource ActionPillButtonStyle}"
                                            Click="OpenTexturesFolder_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Installed Textures Items List -->
                            <ItemsControl ItemsSource="{Binding InstalledTextures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E22" BorderThickness="0" CornerRadius="14"
                                                Padding="14,10" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Texture Image / Icon with Hover Delete -->
                                                <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center" x:Name="IconRoot" Background="Transparent">
                                                    <Grid x:Name="IconVisuals" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="IconScale" ScaleX="1.0" ScaleY="1.0"/>
                                                        </Grid.RenderTransform>

                                                        <!-- Fallback vector texture icon -->
                                                        <Border Background="#26262B" CornerRadius="10" Width="42" Height="42"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                            <Path Data="M 4 4 L 20 4 C 21.1 4 22 4.9 22 6 L 22 18 C 22 19.1 21.1 20 20 20 L 4 20 C 2.9 20 2 19.1 2 18 L 2 6 C 2 4.9 2.9 4 4 4 Z M 6.5 10 C 7.33 10 8 9.33 8 8.5 C 8 7.67 7.33 7 6.5 7 C 5.67 7 5 7.67 5 8.5 C 5 9.33 5.67 10 6.5 10 Z M 5 17 L 19 17 L 14.5 11 L 11 15.5 L 8.5 12.5 Z"
                                                                  Fill="#8E8E93" Width="20" Height="20" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Actual Pack Icon -->
                                                        <Border Width="42" Height="42" CornerRadius="10" Background="#26262B" SnapsToDevicePixels="True"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                            <Border Width="42" Height="42" CornerRadius="10" SnapsToDevicePixels="True">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImgSrc}}"
                                                                                Stretch="UniformToFill"
                                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Dark greyish overlay on hover -->
                                                    <Border x:Name="DeleteOverlay" Width="42" Height="42" CornerRadius="10"
                                                            Background="#B0141418" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True"/>

                                                    <!-- Trash Can Delete Button -->
                                                    <Button x:Name="TrashBtn" Width="42" Height="42"
                                                            Style="{StaticResource IconDeleteButtonStyle}"
                                                            Opacity="0" IsHitTestVisible="False"
                                                            Click="DeleteTexture_Click"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Delete texture pack">
                                                        <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>

                                                <!-- 2. Texture Title & Subtitle / Filename -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                                               FontFamily="{StaticResource NunitoBoldFont}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#7E7E84" FontSize="11"
                                                               FontFamily="{StaticResource NunitoFont}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- 3. Toggle Action (Activate / Deactivate) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                                               FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Click="TextureToggle_Click"
                                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                                              ToolTip="Click to enable or disable this texture pack"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsMouseOver, ElementName=IconRoot}" Value="True"/>
                                                    <Condition Binding="{Binding CanDelete}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="TrashBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="TrashBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                                <Setter TargetName="TrashBtn" Property="IsHitTestVisible" Value="True"/>
                                                <Setter TargetName="IconRoot" Property="Cursor" Value="Hand"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state if no textures -->
                            <Border Background="#161619" BorderThickness="0" CornerRadius="16" Padding="32" Margin="0,10,0,0"
                                    Visibility="{Binding HasInstalledTextures, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No texture packs installed" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click 'Import Texture' or drop your .zip resource pack files into the global folder."
                                               Foreground="#7E7E84" FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                               HorizontalAlignment="Center" Margin="0,6,0,16"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Import Texture" Style="{StaticResource ActionPillButtonStyle}"
                                                Click="ImportTexture_Click" Margin="0,0,10,0"/>
                                        <Button Content="Open Textures Folder" Style="{StaticResource ActionPillButtonStyle}"
                                                Click="OpenTexturesFolder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════ TAB 4: SHADERS ══════════════ -->
                        <StackPanel Visibility="{Binding IsShadersTabSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Section Title Bar with Counter & Action Buttons -->
                            <Grid Margin="4,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SHADER PACKS" FontSize="11" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                    <TextBlock Text="{Binding ShadersCountText}" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="{StaticResource NunitoFont}" Foreground="#66666E" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Import Shader" Style="{StaticResource ActionPillButtonStyle}"
                                            Click="ImportShader_Click" Margin="0,0,10,0"/>
                                    <Button Content="Open Shaders Folder" Style="{StaticResource ActionPillButtonStyle}"
                                            Click="OpenShadersFolder_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Installed Shaders Items List -->
                            <ItemsControl ItemsSource="{Binding InstalledShaders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E22" BorderThickness="0" CornerRadius="14"
                                                Padding="14,10" Margin="0,0,0,8" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Shader Image / Icon with Hover Delete -->
                                                <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center" x:Name="IconRoot" Background="Transparent">
                                                    <Grid x:Name="IconVisuals" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="IconScale" ScaleX="1.0" ScaleY="1.0"/>
                                                        </Grid.RenderTransform>

                                                        <!-- Fallback vector shader sparkle/sun icon -->
                                                        <Border Background="#26262B" CornerRadius="10" Width="42" Height="42"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                            <Path Data="M 12 7 A 5 5 0 1 0 12 17 A 5 5 0 1 0 12 7 Z M 12 2 L 12 5 M 12 19 L 12 22 M 4.93 4.93 L 7.05 7.05 M 16.95 16.95 L 19.07 19.07 M 2 12 L 5 12 M 19 12 L 22 12 M 4.93 19.07 L 7.05 16.95 M 16.95 7.05 L 19.07 4.93"
                                                                  Stroke="#8E8E93" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="20" Height="20" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Actual Shader Icon -->
                                                        <Border Width="42" Height="42" CornerRadius="10" Background="#26262B" SnapsToDevicePixels="True"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                            <Border Width="42" Height="42" CornerRadius="10" SnapsToDevicePixels="True">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImgSrc}}"
                                                                                Stretch="UniformToFill"
                                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Dark greyish overlay on hover -->
                                                    <Border x:Name="DeleteOverlay" Width="42" Height="42" CornerRadius="10"
                                                            Background="#B0141418" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="True"/>

                                                    <!-- Trash Can Delete Button -->
                                                    <Button x:Name="TrashBtn" Width="42" Height="42"
                                                            Style="{StaticResource IconDeleteButtonStyle}"
                                                            Opacity="0" IsHitTestVisible="False"
                                                            Click="DeleteShader_Click"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Delete shader pack">
                                                        <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>

                                                <!-- 2. Shader Title & Subtitle / Filename -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                                               FontFamily="{StaticResource NunitoBoldFont}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#7E7E84" FontSize="11"
                                                               FontFamily="{StaticResource NunitoFont}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- 3. Toggle Action (Activate / Deactivate) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                                               FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Click="ShaderToggle_Click"
                                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                                              ToolTip="Click to enable or disable this shader pack"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Path=IsMouseOver, ElementName=IconRoot}" Value="True"/>
                                                    <Condition Binding="{Binding CanDelete}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="TrashBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="TrashBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                                <Setter TargetName="TrashBtn" Property="IsHitTestVisible" Value="True"/>
                                                <Setter TargetName="IconRoot" Property="Cursor" Value="Hand"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state if no shaders -->
                            <Border Background="#161619" BorderThickness="0" CornerRadius="16" Padding="32" Margin="0,10,0,0"
                                    Visibility="{Binding HasInstalledShaders, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No shader packs installed" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click 'Import Shader' or drop your shader pack .zip files into the global folder."
                                               Foreground="#7E7E84" FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                               HorizontalAlignment="Center" Margin="0,6,0,16"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Import Shader" Style="{StaticResource ActionPillButtonStyle}"
                                                Click="ImportShader_Click" Margin="0,0,10,0"/>
                                        <Button Content="Open Shaders Folder" Style="{StaticResource ActionPillButtonStyle}"
                                                Click="OpenShadersFolder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════ TAB 5: MODRINTH ══════════════ -->
                        <StackPanel Visibility="{Binding IsModrinthTabSelected, Converter={StaticResource BoolToVis}}">
                            <!-- Category Filter Pills & Version Compatibility Pill -->
                            <Grid Margin="4,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Subtype Selector Pills (Mods | Textures | Shaders) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Mods" Tag="mod" Style="{StaticResource ModrinthSubTabModsBtnStyle}"
                                            Click="ModrinthSubtype_Click"/>
                                    <Button Content="Textures" Tag="resourcepack" Style="{StaticResource ModrinthSubTabTexturesBtnStyle}"
                                            Click="ModrinthSubtype_Click"/>
                                    <Button Content="Shaders" Tag="shader" Style="{StaticResource ModrinthSubTabShadersBtnStyle}"
                                            Click="ModrinthSubtype_Click"/>
                                </StackPanel>

                                <!-- Version / Loader Badge -->
                                <Border Grid.Column="2" Background="#1E1E22" BorderThickness="0" CornerRadius="14"
                                        Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModrinthStatusText}" Foreground="#8E8E93" FontSize="11.5"
                                               FontFamily="{StaticResource NunitoBoldFont}"/>
                                </Border>
                            </Grid>

                            <!-- Modern Capsule Search Bar -->
                            <Border Height="38" Background="#1E1E22" CornerRadius="19" Padding="14,0,6,0"
                                    SnapsToDevicePixels="True" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon -->
                                    <Path Grid.Column="0"
                                          Data="M 10.5 2 C 5.8 2 2 5.8 2 10.5 C 2 15.2 5.8 19 10.5 19 C 12.6 19 14.5 18.2 16 16.9 L 20.6 21.5 C 21 21.9 21.6 21.9 22 21.5 C 22.4 21.1 22.4 20.5 22 20.1 L 17.4 15.5 C 18.4 14.1 19 12.4 19 10.5 C 19 5.8 15.2 2 10.5 2 Z M 10.5 4 C 14.1 4 17 6.9 17 10.5 C 17 14.1 14.1 17 10.5 17 C 6.9 17 4 14.1 4 10.5 C 4 6.9 6.9 4 10.5 4 Z"
                                          Fill="#8E8E93" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Search Input -->
                                    <TextBox Grid.Column="1" x:Name="ModrinthSearchBox"
                                             Text="{Binding ModrinthSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="ModrinthSearch_KeyDown"
                                             Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                             CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="13"
                                             FontFamily="{StaticResource NunitoFont}"/>

                                    <!-- Watermark Text -->
                                    <TextBlock Grid.Column="1" Text="Search Modrinth for mods, textures, shaders…"
                                               Foreground="#6E6E76" FontSize="13" FontFamily="{StaticResource NunitoFont}"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ModrinthSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Search Button -->
                                    <Button Grid.Column="2" Content="Search" Style="{StaticResource ActionPillButtonStyle}"
                                            Height="28" Padding="14,0" Margin="0" FontSize="11.5"
                                            Click="ModrinthSearch_Click"/>
                                </Grid>
                            </Border>

                            <!-- Loading State -->
                            <Border Background="#161619" BorderThickness="0" CornerRadius="16" Padding="32" Margin="0,10,0,0"
                                    Visibility="{Binding IsModrinthLoading, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Loading Modrinth content…" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Fetching compatible projects from Modrinth API…"
                                               Foreground="#7E7E84" FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Modrinth Items List -->
                            <ItemsControl ItemsSource="{Binding ModrinthItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E22" BorderThickness="0" CornerRadius="14"
                                                Padding="16,14" Margin="0,0,0,10" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Icon -->
                                                <Grid Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                                                    <!-- Fallback Vector Icon -->
                                                    <Border Background="#26262B" CornerRadius="12" Width="48" Height="48"
                                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                                        <Path Data="M 12 1.75 L 3.25 6.8 V 16.95 L 12 22 L 20.75 16.95 V 6.8 L 12 1.75 Z M 12 4.1 L 18.5 7.85 L 12 11.6 L 5.5 7.85 L 12 4.1 Z M 5.25 9.85 L 11 13.15 V 19.9 L 5.25 16.55 V 9.85 Z M 13 19.9 V 13.15 L 18.75 9.85 V 16.55 L 13 19.9 Z"
                                                              Fill="#8E8E93" Width="22" Height="22" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- High-Quality Pack / Mod Icon with Rounded Corners -->
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#26262B" SnapsToDevicePixels="True"
                                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                                        <Border Width="48" Height="48" CornerRadius="12" SnapsToDevicePixels="True">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImgSrc}}"
                                                                            Stretch="UniformToFill"
                                                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                </Grid>

                                                <!-- 2. Info: Title, Author, Downloads, Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold"
                                                                   FontFamily="{StaticResource NunitoBoldFont}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                                        <Border Background="#28282E" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SubtitleText}" Foreground="#8E8E93" FontSize="10.5"
                                                                       FontFamily="{StaticResource NunitoBoldFont}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="#9C9C9D" FontSize="11.5"
                                                               FontFamily="{StaticResource NunitoFont}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32"/>
                                                </StackPanel>

                                                <!-- 3. Actions: Version Picker Dropdown + Install / Uninstall Button -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Version Picker Dropdown (Only shown when not installed and multiple versions available) -->
                                                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                              DisplayMemberPath="DisplayName"
                                                              Style="{StaticResource ModrinthVersionComboBoxStyle}"
                                                              MinWidth="86" MaxWidth="120" Margin="0,0,10,0"
                                                              ToolTip="Choose compatible version"
                                                              Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}"/>

                                                    <!-- Install Button -->
                                                    <Button Content="{Binding InstallButtonText}" Style="{StaticResource ActionPillButtonStyle}"
                                                            Height="34" Padding="18,0" Margin="0"
                                                            Click="InstallModrinthItem_Click"
                                                            Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}"
                                                            IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                                                    <!-- Installed (Included / Built-in) Badge -->
                                                    <Border Background="#25252B" CornerRadius="17" Padding="14,8" Margin="0"
                                                            Visibility="{Binding ShowIncludedBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Installed (Flow)" Foreground="#8E8E93" FontSize="11.5"
                                                                   FontFamily="{StaticResource NunitoBoldFont}"/>
                                                    </Border>

                                                    <!-- Installed Badge + Uninstall Button -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding ShowUninstallButton, Converter={StaticResource BoolToVis}}">
                                                        <Border Background="#222C24" CornerRadius="17" Padding="12,8" Margin="0,0,8,0">
                                                            <TextBlock Text="Installed" Foreground="#4CD964" FontSize="11.5"
                                                                       FontFamily="{StaticResource NunitoBoldFont}"/>
                                                        </Border>
                                                        <Button Content="Uninstall" Style="{StaticResource ActionPillButtonStyle}"
                                                                Height="34" Padding="14,0" Margin="0"
                                                                Click="UninstallModrinthItem_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State -->
                            <Border Background="#161619" BorderThickness="0" CornerRadius="16" Padding="32" Margin="0,10,0,0"
                                    Visibility="{Binding HasModrinthItems, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center" Visibility="{Binding IsModrinthLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                    <TextBlock Text="No projects found" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Try searching for another term or change the category above."
                                               Foreground="#7E7E84" FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
