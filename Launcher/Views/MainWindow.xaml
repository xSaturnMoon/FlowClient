<Window x:Class="Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Launcher.Converters"
        xmlns:vm="clr-namespace:Launcher.ViewModels"
        mc:Ignorable="d"
        Title="Flow Client"
        Icon="/flow.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Width="1114"
        Height="794"
        WindowState="Normal"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        FontFamily="{StaticResource NunitoFont}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#353744" BorderThickness="1" CornerRadius="12" Background="#141416" Margin="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════ TOP NAVIGATION BAR (IDENTICAL TO BLUEBERRY CLIENT) ══════ -->
            <Grid x:Name="TopBarGrid" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Flow Branding Logo + Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Source="/flowm.ico" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FLOW" Foreground="#FFFFFF" FontSize="16" FontWeight="ExtraBold"
                               FontFamily="{StaticResource FlowBrandFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CENTER: Navigation Menu (News, Account, Home, Versions, Settings) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 1. News Tab -->
                    <Button Style="{StaticResource TopNavTabButton}" Tag="News" Click="News_Click" Margin="4,0">
                        <Button.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M18,8 A6,6 0 0,0 6,8 C6,15 3,17 3,17 H21 C21,17 18,15 18,8 M13.73,21 A2,2 0 0,1 10.27,21"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="News" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Account Tab -->
                    <Button Style="{StaticResource TopNavTabButton}" Tag="Account" Click="Account_Click" Margin="4,0">
                        <Button.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountActive}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M20,21 V19 A4,4 0 0,0 16,15 H8 A4,4 0 0,0 4,19 V21 M12,11 A4,4 0 1,0 12,3 A4,4 0 0,0 12,11 Z"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="Account" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. Home Tab (Center) -->
                    <Button Style="{StaticResource TopNavTabButton}" Tag="Home" Click="Home_Click" Margin="4,0">
                        <Button.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M3,9.5 L12,2.5 L21,9.5 V20 A2,2 0 0,1 19,22 H5 A2,2 0 0,1 3,20 Z M9,22 V12 H15 V22"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="Home" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. Versions Tab -->
                    <Button Style="{StaticResource TopNavTabButton}" Tag="Versions" Click="Versions_Click" Margin="4,0">
                        <Button.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVersionsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="Versions" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. Settings Tab -->
                    <Button Style="{StaticResource TopNavTabButton}" Tag="Settings" Click="Settings_Click" Margin="4,0">
                        <Button.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource TopNavTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 0,0 12,15 Z M19.4,15 A1.65,1.65 0 0,0 20,16.24 L20.1,16.4 A2,2 0 0,1 17.27,19.23 L17.11,19.13 A1.65,1.65 0 0,0 15,19.4 V19.63 A2,2 0 0,1 11,19.63 V19.4 A1.65,1.65 0 0,0 8.9,19.13 L8.73,19.23 A2,2 0 0,1 5.9,16.4 L6,16.24 A1.65,1.65 0 0,0 6.6,15 H6.37 A2,2 0 0,1 6.37,11 H6.6 A1.65,1.65 0 0,0 6,9.76 L5.9,9.6 A2,2 0 0,1 8.73,6.77 L8.9,6.87 A1.65,1.65 0 0,0 11,6.6 V6.37 A2,2 0 0,1 15,6.37 V6.6 A1.65,1.65 0 0,0 17.11,6.87 L17.27,6.77 A2,2 0 0,1 20.1,9.6 L20,9.76 A1.65,1.65 0 0,0 19.4,11 H19.63 A2,2 0 0,1 19.63,15 Z"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="Settings" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- RIGHT: Account Profile Dropdown Pill (Crisp corners & border) -->
                <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                    <Border x:Name="AccountPillBorder"
                            Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6"
                            Padding="7,4" Cursor="Hand" MouseLeftButtonDown="AccountPill_Click"
                            SnapsToDevicePixels="True" UseLayoutRounding="True"
                            ToolTip="Account Menu">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#222226"/>
                                        <Setter Property="BorderBrush" Value="#333338"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Avatar Head -->
                            <Border Width="22" Height="22" CornerRadius="4" Background="#222226" ClipToBounds="True" Margin="0,0,8,0"
                                    SnapsToDevicePixels="True">
                                <Image Source="{Binding PlayerAvatar}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                            </Border>
                            <!-- Player Name -->
                            <TextBlock Text="{Binding PlayerName}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                       FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center" Margin="0,0,6,0"
                                       MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                            <!-- Chevron Dropdown Arrow -->
                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#8E8E98" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Width="8" Height="4" Margin="0,1,2,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ══════ MAIN CONTENT STAGE WITH DIRECTIONAL SLIDE ══════ -->
            <Border x:Name="ContentBorder" Grid.Row="1" Background="Transparent" ClipToBounds="True">
                <ContentControl x:Name="MainContentControl">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>

            <!-- ══════ IN-TREE ACCOUNT DROPDOWN OVERLAY (ROCK SOLID & NEVER CLOSES ON CLICK) ══════ -->
            <Grid x:Name="AccountMenuOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999" Visibility="Collapsed">
                <!-- Backdrop that covers the full window: clicking outside closes the menu cleanly -->
                <Border Background="#01000000" MouseLeftButtonDown="AccountMenuBackdrop_Click"/>

                <!-- Dropdown Card anchored below the account pill in top-right -->
                <Border Width="240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,22,0"
                        Background="#1A1B22" BorderBrush="#2D2F3C" BorderThickness="1"
                        CornerRadius="10" Padding="14,14" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Current Account Info -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="7" Background="#242530" ClipToBounds="True" Margin="0,0,10,0">
                                <Image Source="{Binding PlayerAvatar}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Microsoft Account" Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#282A38" Margin="0,0,0,8"/>

                        <!-- Option 1: Manage Cosmetics -->
                        <Button Style="{StaticResource DropdownMenuItem}" Click="AccountMenu_Manage_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C8.13,14 5,15.79 5,18 V20 H19 V18 C19,15.79 15.87,14 12,14 Z"
                                      Stroke="#A0A5B5" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage Skin &amp; Cosmetics" Foreground="#E2E8F0" FontSize="12.5" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Option 2: Add Account -->
                        <Button Style="{StaticResource DropdownMenuItem}" Click="AccountMenu_AddAccount_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,5 V19 M5,12 H19" Stroke="#3B82F6" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Microsoft Account" Foreground="#E2E8F0" FontSize="12.5" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#282A38" Margin="0,6,0,8"/>

                        <!-- Option 3: Sign Out -->
                        <Button Style="{StaticResource DropdownMenuItemDanger}" Click="AccountMenu_SignOut_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9"
                                      Stroke="#EF4444" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign Out" Foreground="#EF4444" FontSize="12.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
