<Window x:Class="Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Launcher.Converters"
        xmlns:vm="clr-namespace:Launcher.ViewModels"
        mc:Ignorable="d"
        Title="Flow Client"
        Icon="/flow.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Width="1114"
        Height="794"
        WindowState="Normal"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        FontFamily="{StaticResource NunitoFont}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToInverseVisibilityConverter x:Key="BoolToInverseVisibilityConverter"/>

            <!-- Top bar Sidebar toggle button ([| ]) -->
            <Style x:Key="TopBarSidebarToggleBtn" TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <Border x:Name="iconBd" Width="20" Height="15" CornerRadius="4.5" Background="#727278" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Border x:Name="barCutout" Width="3.5" Height="9" CornerRadius="1.5" Background="#101010" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2.5,0,0,0"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                    <Setter TargetName="iconBd" Property="Background" Value="#A0A0AA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                    <Setter TargetName="iconBd" Property="Background" Value="#C2C2CC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Top bar icon button (e.g. Community / Friends) -->
            <Style x:Key="TopBarIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window control button (Minimize) -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window control button (Close with red hover) -->
            <Style x:Key="WindowCloseButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Melty-Style Sidebar Pill Button Base -->
            <Style x:Key="SidebarPillButton" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#9C9C9D"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1E1E22"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#25252A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Active Pill Trigger Styles -->
            <Style x:Key="SidebarDiscoverBtnStyle" TargetType="Button" BasedOn="{StaticResource SidebarPillButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHomeActive}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarLibraryBtnStyle" TargetType="Button" BasedOn="{StaticResource SidebarPillButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLibraryActive}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarCreateBtnStyle" TargetType="Button" BasedOn="{StaticResource SidebarPillButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCreateActive}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarSettingsBtnStyle" TargetType="Button" BasedOn="{StaticResource SidebarPillButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarProfileBtnStyle" TargetType="Button" BasedOn="{StaticResource SidebarPillButton}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="8,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAccountActive}" Value="True">
                        <Setter Property="Background" Value="#262629"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="12" Background="#101010" Margin="1" SnapsToDevicePixels="True" SizeChanged="RootBorder_SizeChanged">
        <Grid x:Name="RootContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════ TOP BAR (MATCHING MELTY SCREENSHOT & CUSTOM FLOW LOGO) ══════ -->
            <Grid x:Name="TopBarGrid" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="195"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="195"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sidebar Toggle [| ] + FLOW Logo (from user attachment) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource TopBarSidebarToggleBtn}" Click="SidebarToggle_Click" ToolTip="Toggle Sidebar"/>
                    <Image Source="/Assets/flow_title_logo.png" Height="22" Stretch="Uniform" VerticalAlignment="Center"
                           Margin="14,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" MouseLeftButtonDown="Logo_MouseDown"
                           ToolTip="Flow Client"/>
                </StackPanel>

                <!-- CENTER: Search Box (True Capsule matching reference photo 2) -->
                <Border Grid.Column="1" Height="34" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1E1E22" CornerRadius="17" Padding="14,0" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Magnifying glass icon (clean outline path) -->
                        <Path Grid.Column="0"
                              Data="M 6.5,11.5 A 5,5 0 1,1 11.5,6.5 A 5,5 0 0,1 6.5,11.5 Z M 10,10 L 14.5,14.5"
                              Stroke="#9D9D9E" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Text Input & Placeholder -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TopSearchTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     FontSize="12.5"
                                     FontWeight="SemiBold"
                                     FontFamily="{StaticResource NunitoFont}"
                                     VerticalAlignment="Center"
                                     Padding="2,0,0,0"
                                     Margin="2,0,0,0"
                                     GotFocus="TopSearchTextBox_GotFocus"
                                     LostFocus="TopSearchTextBox_LostFocus"
                                     KeyDown="TopSearchTextBox_KeyDown"
                                     TextChanged="TopSearchTextBox_TextChanged"/>
                            <TextBlock x:Name="TopSearchPlaceholder"
                                       Text="Search mashups, games and players"
                                       Foreground="#8A8A92"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource NunitoFont}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Padding="2,0,0,0"
                                       Margin="2,0,0,0"/>
                        </Grid>

                        <!-- Shortcut key '/' pill badge -->
                        <Border Grid.Column="2" Background="#16161A" CornerRadius="5" Padding="7,2" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="/" Foreground="#717175" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT: Community / Friends + Window Controls (Minimize, Close - NO Fullscreen) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Quick Connect Servers Icon (Toggles Quick Connect Dropdown) -->
                    <Button x:Name="TopBarQuickConnectBtn" Style="{StaticResource TopBarIconButton}" Click="QuickConnect_Click" ToolTip="Quick Connect Servers" Margin="0,0,6,0">
                        <Path Data="M3 4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4zm3 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm3 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-6 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3zm3 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm3 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-6 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1zm3 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm3 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"
                              Fill="#8E8E98" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click" ToolTip="Minimize" Margin="0,0,2,0">
                        <Path Data="M0,5 L10,5" Stroke="#8E8E98" StrokeThickness="1.5" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#8E8E98" StrokeThickness="1.5" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══════ ROW 1: MAIN BODY (PERSISTENT LEFT SIDEBAR + CONTENT AREA) ══════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════ MELTY-STYLE LEFT SIDEBAR ══════ -->
                <Border x:Name="SidebarContainer" Grid.Column="0" Width="195" Background="#101010"
                        BorderBrush="#1C1C1E" BorderThickness="0,0,1,0" ClipToBounds="True">
                    <Grid Margin="10,6,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TOP NAVIGATION: Discover, Library, + Create, Settings -->
                        <StackPanel Grid.Row="0">
                            <!-- 1. Discover / Info -->
                            <Button x:Name="NavDiscoverBtn" Style="{StaticResource SidebarDiscoverBtnStyle}" Click="NavDiscover_Click">
                                <Grid>
                                    <!-- Default: Discover -->
                                    <Grid x:Name="NavDiscoverDefaultPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Data="F0 M 10,1.5 A 8.5,8.5 0 1,0 10,18.5 A 8.5,8.5 0 1,0 10,1.5 Z M 13.89,6.11 L 11.41,11.41 L 6.11,13.89 L 8.59,8.59 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Discover" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                    <!-- Instance Mode: Info -->
                                    <Grid x:Name="NavDiscoverInfoPanel" Opacity="0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 L 11 17 L 11 11 L 13 11 L 13 17 Z M 13 9 L 11 9 L 11 7 L 13 7 L 13 9 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Info" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <!-- 2. Library / Mod -->
                            <Button x:Name="NavLibraryBtn" Style="{StaticResource SidebarLibraryBtnStyle}" Click="NavLibrary_Click">
                                <Grid>
                                    <!-- Default: Library -->
                                    <Grid x:Name="NavLibraryDefaultPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M 1,4 L 8,1 L 15,4 L 8,7 Z M 1,8 L 8,11 L 15,8 M 1,12 L 8,15 L 15,12"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="15" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Library" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                    <!-- Instance Mode: Mod -->
                                    <Grid x:Name="NavLibraryModPanel" Opacity="0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Data="M 20.5 11 H 19 V 7 C 19 5.9 18.1 5 17 5 H 13 V 3.5 C 13 2.12 11.88 1 10.5 1 S 8 2.12 8 3.5 V 5 H 4 C 2.9 5 2.01 5.9 2.01 7 L 2 10.5 H 3.5 C 4.88 10.5 6 11.62 6 13 S 4.88 15.5 3.5 15.5 H 2 V 19 C 2 20.1 2.9 21 4 21 H 7.5 C 7.5 19.62 8.62 18.5 10 18.5 S 12.5 19.62 12.5 21 H 17 C 18.1 21 19 20.1 19 19 V 15.5 H 20.5 C 21.88 15.5 23 14.38 23 13 S 21.88 11 20.5 11 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Mods" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Grid>
                            </Button>

                            <!-- 3. Textures (Version Settings Mode) -->
                            <Grid x:Name="NavTexturesContainer" Height="0" Opacity="0" Visibility="Collapsed" ClipToBounds="True">
                                <Button x:Name="NavTexturesBtn" Style="{StaticResource SidebarLibraryBtnStyle}" Click="NavTextures_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Data="M 21 19 V 5 C 21 3.9 20.1 3 19 3 H 5 C 3.9 3 3 3.9 3 5 V 19 C 3 20.1 3.9 21 5 21 H 19 C 20.1 21 21 20.1 21 19 Z M 8.5 13.5 L 11 16.51 L 14.5 12 L 19 18 H 5 L 8.5 13.5 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Textures" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 4. Shaders (Version Settings Mode) -->
                            <Grid x:Name="NavShadersContainer" Height="0" Opacity="0" Visibility="Collapsed" ClipToBounds="True">
                                <Button x:Name="NavShadersBtn" Style="{StaticResource SidebarLibraryBtnStyle}" Click="NavShaders_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Data="M 19 9 L 17.74 6.26 L 15 5 L 17.74 3.74 L 19 1 L 20.26 3.74 L 23 5 L 20.26 6.26 L 19 9 Z M 9 4 L 6.5 9.5 L 1 12 L 6.5 14.5 L 9 20 L 11.5 14.5 L 17 12 L 11.5 9.5 L 9 4 Z M 19 15 L 17.74 17.74 L 15 19 L 17.74 20.26 L 19 23 L 20.26 20.26 L 23 19 L 20.26 17.74 L 19 15 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Shaders" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 5. Modrinth (Version Settings Mode) -->
                            <Grid x:Name="NavModrinthContainer" Height="0" Opacity="0" Visibility="Collapsed" ClipToBounds="True">
                                <Button x:Name="NavModrinthBtn" Style="{StaticResource SidebarLibraryBtnStyle}" Click="NavModrinth_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Data="M 12 1.75 L 3.25 6.8 V 16.95 L 12 22 L 20.75 16.95 V 6.8 L 12 1.75 Z M 12 4.1 L 18.5 7.85 L 12 11.6 L 5.5 7.85 L 12 4.1 Z M 5.25 9.85 L 11 13.15 V 19.9 L 5.25 16.55 V 9.85 Z M 13 19.9 V 13.15 L 18.75 9.85 V 16.55 L 13 19.9 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Modrinth" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 3. + Create (Collapsible in Version Settings Mode) -->
                            <Grid x:Name="NavCreateContainer" Height="40" ClipToBounds="True">
                                <Button x:Name="NavCreateBtn" Style="{StaticResource SidebarCreateBtnStyle}" Click="NavCreate_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M 7.5,1 L 7.5,14 M 1,7.5 L 14,7.5"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Create" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 4. Settings (Collapsible in Version Settings Mode) -->
                            <Grid x:Name="NavSettingsContainer" Height="40" ClipToBounds="True">
                                <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarSettingsBtnStyle}" Click="NavSettings_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M19.4,13 C19.5,12.7 19.5,12.3 19.5,12 C19.5,11.7 19.5,11.3 19.4,11 L21.5,9.3 C21.7,9.1 21.8,8.9 21.6,8.6 L19.6,5.2 C19.5,4.9 19.2,4.8 19,4.9 L16.5,5.9 C16,5.5 15.4,5.2 14.8,4.9 L14.4,2.3 C14.4,2 14.1,1.8 13.9,1.8 L9.9,1.8 C9.6,1.8 9.4,2 9.3,2.3 L9,4.9 C8.4,5.2 7.8,5.5 7.3,5.9 L4.8,4.9 C4.5,4.8 4.3,4.9 4.1,5.2 L2.1,8.6 C2,8.9 2.1,9.1 2.2,9.3 L4.4,11 C4.3,11.3 4.3,11.7 4.3,12 C4.3,12.3 4.3,12.7 4.4,13 L2.2,14.7 C2.1,14.9 2,15.1 2.1,15.4 L4.1,18.8 C4.3,19.1 4.5,19.2 4.8,19.1 L7.3,18.1 C7.8,18.5 8.4,18.8 9,19.1 L9.3,21.7 C9.4,22 9.6,22.2 9.9,22.2 L13.9,22.2 C14.1,22.2 14.4,22 14.4,21.7 L14.8,19.1 C15.4,18.8 16,18.5 16.5,18.1 L19,19.1 C19.2,19.2 19.5,19.1 19.6,18.8 L21.6,15.4 C21.8,15.1 21.7,14.9 21.5,14.7 Z M12,15.5 C10.1,15.5 8.5,13.9 8.5,12 C8.5,10.1 10.1,8.5 12,8.5 C13.9,8.5 15.5,10.1 15.5,12 C15.5,13.9 13.9,15.5 12,15.5 Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Settings" FontSize="13.5" FontWeight="Bold"
                                                   FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- BOTTOM NAVIGATION: Interactive Check Updates + Minecraft Profile -->
                        <StackPanel Grid.Row="2">
                            <!-- Check Updates (Interactive Animated Button) -->
                            <Button x:Name="NavCheckUpdatesBtn" Style="{StaticResource SidebarPillButton}" Click="CheckUpdates_Click" ToolTip="Check for launcher updates">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Interactive Update Icon with Outer Circle, Arrow, Spinning Arc, Checkmark, Cross -->
                                    <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 1. Outer Circle of Update Icon -->
                                        <Path x:Name="SidebarUpdateCircle"
                                              Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z"
                                              StrokeThickness="1.6" Fill="Transparent"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform x:Name="SidebarUpdateCircleScale" ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- 2. Inner Down Arrow -->
                                        <Path x:Name="SidebarUpdateArrow"
                                              Data="M2,2 M22,22 M12,8.5 L12,14.5 M9,12.5 L12,15.5 L15,12.5"
                                              StrokeThickness="1.6" Fill="Transparent"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform x:Name="SidebarUpdateArrowScale" ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- 3. Spinning arc (Windows 11 boot style) -->
                                        <Path x:Name="SidebarUpdateSpinner"
                                              Data="M2,2 M22,22 M12,2 A10,10 0 0,1 22,12"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="SidebarSpinnerScale" ScaleX="1" ScaleY="1"/>
                                                    <RotateTransform x:Name="SidebarSpinnerRotate" Angle="0"/>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- 4. Checkmark (✓) -->
                                        <Path x:Name="SidebarUpdateCheckmark"
                                              Data="M4,12 L9,17 L20,6"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              Stroke="#10B981"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="SidebarCheckmarkScale" ScaleX="0" ScaleY="0"/>
                                                    <RotateTransform x:Name="SidebarCheckmarkRotate" Angle="-35"/>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- 5. Cross (✕) -->
                                        <Path x:Name="SidebarUpdateCross"
                                              Data="M4,4 L20,20 M20,4 L4,20"
                                              StrokeThickness="1.8" Fill="Transparent"
                                              Stroke="#EF4444"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="SidebarCrossScale" ScaleX="0" ScaleY="0"/>
                                                    <RotateTransform x:Name="SidebarCrossRotate" Angle="90"/>
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Check Updates" FontSize="13.5" FontWeight="Bold"
                                               FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="8,2,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Minecraft Profile button (replaces toaster waffle) -->
                            <Button x:Name="NavProfileBtn" Style="{StaticResource SidebarProfileBtnStyle}" Click="Profile_Click" ToolTip="Manage Account &amp; Skin">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Minecraft Skin Head Avatar -->
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#242530" ClipToBounds="True" VerticalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding PlayerAvatar}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                                            <TextBlock Text="{Binding PlayerInitial}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                                                       FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasPlayerAvatar, Converter={StaticResource BoolToInverseVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding PlayerName}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                               FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center" Margin="9,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════ MAIN CONTENT STAGE WITH DIRECTIONAL SLIDE ══════ -->
                <Border x:Name="ContentBorder" Grid.Column="1" Background="Transparent" CornerRadius="0,0,11,11" ClipToBounds="True">
                    <ContentControl x:Name="MainContentControl">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Border>
            </Grid>

            <!-- ══════ IN-TREE ACCOUNT DROPDOWN OVERLAY (ROCK SOLID & NEVER CLOSES ON CLICK) ══════ -->
            <Grid x:Name="AccountMenuOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999" Visibility="Collapsed">
                <!-- Backdrop that covers the full window: clicking outside closes the menu cleanly -->
                <Border Background="#01000000" MouseLeftButtonDown="AccountMenuBackdrop_Click"/>

                <!-- Dropdown Card anchored below Community button in top-right -->
                <Border Width="240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,48,0"
                        Background="#1A1B22" BorderBrush="#2D2F3C" BorderThickness="1"
                        CornerRadius="10" Padding="14,14" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Current Account Info -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="7" Background="#242530" ClipToBounds="True" Margin="0,0,10,0">
                                <Image Source="{Binding PlayerAvatar}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Microsoft Account" Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#282A38" Margin="0,0,0,8"/>

                        <!-- Option 1: Manage Cosmetics -->
                        <Button Style="{StaticResource DropdownMenuItem}" Click="AccountMenu_Manage_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C8.13,14 5,15.79 5,18 V20 H19 V18 C19,15.79 15.87,14 12,14 Z"
                                      Stroke="#A0A5B5" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage Skin &amp; Cosmetics" Foreground="#E2E8F0" FontSize="12.5" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Option 2: Add Account -->
                        <Button Style="{StaticResource DropdownMenuItem}" Click="AccountMenu_AddAccount_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,5 V19 M5,12 H19" Stroke="#3B82F6" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Microsoft Account" Foreground="#E2E8F0" FontSize="12.5" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#282A38" Margin="0,6,0,8"/>

                        <!-- Option 3: Sign Out -->
                        <Button Style="{StaticResource DropdownMenuItemDanger}" Click="AccountMenu_SignOut_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9"
                                      Stroke="#EF4444" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign Out" Foreground="#EF4444" FontSize="12.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════ IN-TREE QUICK CONNECT SERVERS DROPDOWN OVERLAY ══════ -->
            <Grid x:Name="QuickConnectOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999" Visibility="Collapsed">
                <!-- Backdrop that covers the full window: clicking outside closes the menu cleanly -->
                <Border Background="#01000000" MouseLeftButtonDown="QuickConnectBackdrop_Click"/>

                <!-- Dropdown Card anchored below Quick Connect button in top-right -->
                <Border Width="330" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,48,0"
                        Background="#1E1E22" BorderThickness="0" CornerRadius="18" Padding="18,16" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header & Active Instance Indicator -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="QUICK CONNECT" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93"/>
                                <TextBlock x:Name="QuickConnectActiveInstanceText" Text="Selected Version: …" FontSize="11.5" FontFamily="{StaticResource NunitoFont}" Foreground="#6E6E76" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Add Server Section -->
                        <Border Background="#161619" CornerRadius="14" Padding="12,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ADD SERVER" FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#7E7E84" Margin="2,0,0,6"/>
                                <!-- Server Name Input -->
                                <Border Height="34" Background="#1E1E22" CornerRadius="17" Padding="12,0" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBox x:Name="QuickConnectNameInput"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                                 FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                                 CaretBrush="#FFFFFF" VerticalAlignment="Center"
                                                 GotFocus="QuickConnectInput_GotFocus" LostFocus="QuickConnectInput_LostFocus"/>
                                        <TextBlock x:Name="QuickConnectNamePlaceholder"
                                                   Text="Server Name (e.g. Hypixel)" Foreground="#65656E" FontSize="12"
                                                   FontFamily="{StaticResource NunitoFont}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Server IP Input -->
                                <Border Height="34" Background="#1E1E22" CornerRadius="17" Padding="12,0" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBox x:Name="QuickConnectAddressInput"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                                 FontSize="12" FontFamily="{StaticResource NunitoFont}"
                                                 CaretBrush="#FFFFFF" VerticalAlignment="Center"
                                                 GotFocus="QuickConnectInput_GotFocus" LostFocus="QuickConnectInput_LostFocus"/>
                                        <TextBlock x:Name="QuickConnectAddressPlaceholder"
                                                   Text="Server IP (e.g. mc.hypixel.net)" Foreground="#65656E" FontSize="12"
                                                   FontFamily="{StaticResource NunitoFont}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Add Server Action Button & Status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="QuickConnectStatusText" Foreground="#F59E0B" FontSize="11"
                                               FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Margin="2,0,8,0" Visibility="Collapsed"/>
                                    <Button x:Name="QuickConnectAddBtn" Grid.Column="1" Content="+ Add Server"
                                            Height="28" Padding="14,0" Background="#FFFFFF" Foreground="#101010"
                                            FontWeight="Bold" FontSize="11.5" FontFamily="{StaticResource NunitoBoldFont}"
                                            Cursor="Hand" Click="QuickConnectAdd_Click" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#E5E5E5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#28282E" Margin="0,2,0,10"/>

                        <!-- Servers List Header -->
                        <TextBlock Text="SAVED SERVERS" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" Foreground="#8E8E93" Margin="2,0,0,8"/>

                        <!-- Empty State -->
                        <TextBlock x:Name="QuickConnectEmptyText" Text="No servers added yet. Enter a server name and IP above."
                                   Foreground="#65656E" FontSize="11.5" FontFamily="{StaticResource NunitoFont}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,10,0,10" Visibility="Collapsed"/>

                        <!-- Servers Scrollable ItemsControl -->
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="QuickConnectItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161619" CornerRadius="14" Padding="12,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Server Name (White) & IP (Grey, smaller) - NO ICON as requested -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                                                               FontFamily="{StaticResource NunitoBoldFont}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Address}" Foreground="#8E8E93" FontSize="11"
                                                               FontFamily="{StaticResource NunitoFont}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Actions: Delete & Play -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Delete Button -->
                                                    <Button Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" ToolTip="Delete server" Margin="0,0,6,0"
                                                            Tag="{Binding Id}" Click="QuickConnectDelete_Click" FocusVisualStyle="{x:Null}">
                                                        <Path Data="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"
                                                              Stroke="#6E6E76" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Play Button -->
                                                    <Button Height="28" Padding="14,0" Background="#FFFFFF" Foreground="#101010"
                                                            FontWeight="Bold" FontSize="11.5" FontFamily="{StaticResource NunitoBoldFont}"
                                                            Cursor="Hand" Tag="{Binding}" Click="QuickConnectPlay_Click" FocusVisualStyle="{x:Null}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="pb" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="pb" Property="Background" Value="#E5E5E5"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="Play" Foreground="#101010" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════ IN-WINDOW UPDATE PROGRESS OVERLAY ══════ -->
            <Grid x:Name="UpdateOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10000" Visibility="Collapsed">
                <!-- Semi-transparent dark blur backdrop -->
                <Border Background="#A0000000"/>

                <!-- Update Modal Card -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="400"
                        Background="#141416" BorderBrush="#25252A" BorderThickness="1"
                        CornerRadius="14" Padding="28,24" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Icon + Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Image Source="/Assets/flow_title_logo.png" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Flow Client Update" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Status text -->
                        <TextBlock x:Name="UpdateOverlayStatus" Text="Downloading update..."
                                   Foreground="#9E9EA6" FontSize="13" FontFamily="{StaticResource NunitoFont}" Margin="0,0,0,14"/>

                        <!-- Progress Bar Container -->
                        <Border Height="8" Background="#222228" CornerRadius="4" ClipToBounds="True">
                            <ProgressBar x:Name="UpdateOverlayProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#3B82F6" Background="Transparent" BorderThickness="0"/>
                        </Border>

                        <!-- Percentage & Download Size -->
                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="UpdateOverlayDetails" Text="0 MB / 40 MB"
                                       Foreground="#71717A" FontSize="11.5" FontFamily="{StaticResource NunitoFont}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="UpdateOverlayPercent" Text="0%"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NunitoBoldFont}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
