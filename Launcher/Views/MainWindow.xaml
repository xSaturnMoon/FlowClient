<Window x:Class="Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.ViewModels"
        mc:Ignorable="d"
        Title="Flow Client"
        Icon="/flow.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Width="1114"
        Height="794"
        WindowState="Normal"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        FontFamily="{StaticResource NunitoFont}">

    <Window.Resources>
        <!-- Simple icon button style for the mini sidebar — no min-width, fully centered -->
        <Style x:Key="MiniSidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#252128"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Clip>
        <RectangleGeometry x:Name="WindowClipGeometry" RadiusX="10" RadiusY="10" Rect="0,0,1114,794"/>
    </Window.Clip>
    <Border BorderBrush="#222224" BorderThickness="0.3" CornerRadius="10">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="227" />
            <ColumnDefinition Width="48"  />
            <ColumnDefinition Width="*"   />
        </Grid.ColumnDefinitions>

        <!-- ═══ COLUMN 0 — MAIN LEFT SIDEBAR  (original, untouched) ═══ -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#1B1619" BorderBrush="#222224" BorderThickness="0,0,0.3,0" MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,28">
                    <Image Source="/flowm.ico" Height="26" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FLOW" Foreground="#FFFFFF" FontFamily="{StaticResource FlowBrandFont}" FontSize="26" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav menu -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Border x:Name="NavIndicator" Height="48" CornerRadius="5" Background="#0A6FCB"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch" IsHitTestVisible="False" Panel.ZIndex="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavIndicatorTransform" Y="0"/>
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel Panel.ZIndex="1">
                        <Button Style="{StaticResource NavigationButtonStyleGhost}" Margin="0,0,0,9" Height="48" Click="Launch_Click" Tag="Launch">
                            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                                <Path Data="M12,2 C12,2 7,6 7,12 L9,12 C9,12 9,10 12,8 C15,10 15,12 15,12 L17,12 C17,6 12,2 12,2 Z M9,14 L9,18 L11,17 L11,20 L13,20 L13,17 L15,18 L15,14 Z"
                                      StrokeThickness="0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Launch" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavigationButtonStyleGhost}" Margin="0,0,0,9" Height="48" Click="Explore_Click" Tag="Explore">
                            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                                <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M16.24,7.76 L14.12,14.12 L7.76,16.24 L9.88,9.88 Z"
                                      StrokeThickness="2" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Explore" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavigationButtonStyleGhost}" Height="48" Click="Account_Click" Tag="Account">
                            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C8.13,14 5,15.79 5,18 V20 H19 V18 C19,15.79 15.87,14 12,14 Z"
                                      StrokeThickness="2" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Account" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Installed versions -->
                <Grid Grid.Row="2" Margin="4,30,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Installed versions" Foreground="#777777" FontSize="11"
                               FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <Line Grid.Column="1" Stroke="#2A2A2E" StrokeThickness="0.8"
                          X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>

                <!-- Spacer -->
                <Grid Grid.Row="3"/>

                <!-- Separator above Settings -->
                <Line Grid.Row="4" Stroke="#2A2A2E" StrokeThickness="0.8"
                      X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Margin="4,0,4,6"/>

                <!-- Settings button -->
                <Grid Grid.Row="5">
                    <Border x:Name="BottomNavIndicator" Height="48" CornerRadius="5" Background="#0A6FCB"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch" IsHitTestVisible="False"
                            Visibility="Collapsed" Panel.ZIndex="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BottomNavIndicatorTransform" Y="0"/>
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel Panel.ZIndex="1">
                        <Button Style="{StaticResource NavigationButtonStyleGhost}" Height="48" Click="Settings_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal" Margin="-4,0,0,0">
                                <Path Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z M19.4,13 L21.7,9.2 L19.1,4.6 L16.4,5.7 C15.8,5.3 15.2,4.9 14.5,4.6 L14.1,1.7 L9.5,1.7 L9.1,4.6 C8.4,4.9 7.8,5.3 7.2,5.7 L4.5,4.6 L1.9,9.2 L4.2,11 C4.1,11.3 4.1,11.7 4.1,12 C4.1,12.3 4.1,12.7 4.2,13 L1.9,14.8 L4.5,19.4 L7.2,18.3 C7.8,18.7 8.4,19.1 9.1,19.4 L9.5,22.3 L14.1,22.3 L14.5,19.4 C15.2,19.1 15.8,18.7 16.4,18.3 L19.1,19.4 L21.7,14.8 Z"
                                      StrokeThickness="2" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ COLUMN 1 — MINI ICON SIDEBAR ═══ -->
        <Grid x:Name="MiniSidebarGrid" Grid.Column="1" Background="#1B1619">
            <!-- Left separator — same as Line Stroke="#2A2A2E" StrokeThickness="0.8" -->
            <Rectangle Width="0.8" Fill="#2A2A2E" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
            <!-- Right separator — same style -->
            <Rectangle Width="0.8" Fill="#2A2A2E" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

            <Grid Margin="4,16,4,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10"   />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Update -->
                <Button x:Name="BtnUpdate" Grid.Row="1"
                        Style="{StaticResource MiniSidebarButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="Update_Click" Tag="Update" ToolTip="Controlla aggiornamenti">
                    <Grid Width="18" Height="18">
                        <!-- 1. Outer Circle of Update Icon (same 18x18 size as Power icon) -->
                        <Path x:Name="OuterCircle"
                              Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z"
                              StrokeThickness="1.6" Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Width="18" Height="18" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="OuterCircleScale" ScaleX="1" ScaleY="1"/>
                            </Path.RenderTransform>
                        </Path>

                        <!-- 2. Inner Down Arrow (recedes into distance on click, perfectly centered at 12,12) -->
                        <Path x:Name="IconUpdateArrow"
                              Data="M2,2 M22,22 M12,8.5 L12,14.5 M9,12.5 L12,15.5 L15,12.5"
                              StrokeThickness="1.6" Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="UpdateArrowScale" ScaleX="1" ScaleY="1"/>
                            </Path.RenderTransform>
                        </Path>

                        <!-- 3. Windows 11 boot style spinning arc (NO faint background line!) -->
                        <Path x:Name="OuterCircleSpinner"
                              Data="M2,2 M22,22 M12,2 A10,10 0 0,1 22,12"
                              StrokeThickness="1.8" Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="Uniform"
                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SpinnerScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <!-- 4. Checkmark (✓) - the circle morphs directly into this (full 18x18 size) -->
                        <Path x:Name="IconCheckmark"
                              Data="M4,12 L9,17 L20,6"
                              StrokeThickness="1.8" Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="18" Height="18" Stretch="Uniform"
                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CheckmarkScale" ScaleX="0" ScaleY="0"/>
                                    <RotateTransform x:Name="CheckmarkRotate" Angle="-35"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>

                        <!-- 5. Cross (✕) - the circle morphs directly into this (full 18x18 size) -->
                        <Path x:Name="IconCross"
                              Data="M4,4 L20,20 M20,4 L4,20"
                              StrokeThickness="1.8" Fill="Transparent"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="Uniform"
                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CrossScale" ScaleX="0" ScaleY="0"/>
                                    <RotateTransform x:Name="CrossRotate" Angle="90"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>

                <!-- Quit/Power -->
                <Button Grid.Row="3"
                        Style="{StaticResource MiniSidebarButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="Quit_Click" Tag="Quit" ToolTip="Quit">
                    <Path Data="M12,3 L12,12 M6.34,5.64 A8,8 0 1,0 17.66,5.64"
                          StrokeThickness="1.6" Fill="Transparent"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Grid>

        <!-- ═══ COLUMN 2 — MAIN CONTENT ═══ -->
        <Border x:Name="ContentBorder" Grid.Column="2" Background="#131114">
            <ContentControl x:Name="MainContentControl"/>
        </Border>
    </Grid>
    </Border>
</Window>
