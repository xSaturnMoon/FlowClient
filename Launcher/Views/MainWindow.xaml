<Window x:Class="Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Launcher.Converters"
        xmlns:vm="clr-namespace:Launcher.ViewModels"
        mc:Ignorable="d"
        Title="Flow Client"
        Icon="/flow.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Width="1114"
        Height="794"
        WindowState="Normal"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        FontFamily="{StaticResource NunitoFont}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Top bar Sidebar toggle button ([| ]) -->
            <Style x:Key="TopBarSidebarToggleBtn" TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <Border x:Name="iconBd" Width="20" Height="15" CornerRadius="4.5" Background="#727278" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Border x:Name="barCutout" Width="3.5" Height="9" CornerRadius="1.5" Background="#141416" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2.5,0,0,0"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                    <Setter TargetName="iconBd" Property="Background" Value="#A0A0AA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                    <Setter TargetName="iconBd" Property="Background" Value="#C2C2CC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Top bar icon button (e.g. Community / Friends) -->
            <Style x:Key="TopBarIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window control button (Minimize) -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2C2C34"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window control button (Close with red hover) -->
            <Style x:Key="WindowCloseButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#C40E1E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar flyout menu item style -->
            <Style x:Key="SidebarMenuItem" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#222228"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2A2A32"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#25252A" BorderThickness="1" CornerRadius="12" Background="#141416" Margin="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════ TOP BAR (MATCHING MELTY SCREENSHOT & CUSTOM FLOW LOGO) ══════ -->
            <Grid x:Name="TopBarGrid" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Sidebar Toggle [| ] + FLOW Logo (from user attachment) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource TopBarSidebarToggleBtn}" Click="SidebarToggle_Click" ToolTip="Navigation Menu"/>
                    <Image Source="/Assets/flow_title_logo.png" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                           Margin="14,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" MouseLeftButtonDown="Logo_MouseDown"
                           ToolTip="Flow Client"/>
                </StackPanel>

                <!-- CENTER: Search Box (Capsule matching Melty) -->
                <Border Grid.Column="1" Height="32" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1A1918" BorderBrush="#2A2826" BorderThickness="1" CornerRadius="10" Padding="12,0" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Magnifying glass icon -->
                        <Path Grid.Column="0" Data="M15.5,14 H14.71 L14.43,13.73 A6.47,6.47 0 0,0 16,9.5 A6.5,6.5 0 1,0 9.5,16 A6.47,6.47 0 0,0 13.73,14.43 L14,14.71 V15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 A4.5,4.5 0 1,1 14,9.5 A4.5,4.5 0 0,1 9.5,14 Z"
                              Fill="#7A7875" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Text Input & Placeholder -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TopSearchTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#60A5FA"
                                     FontSize="12"
                                     FontFamily="{StaticResource NunitoFont}"
                                     VerticalAlignment="Center"
                                     Padding="0,0"
                                     KeyDown="TopSearchTextBox_KeyDown"
                                     TextChanged="TopSearchTextBox_TextChanged"/>
                            <TextBlock x:Name="TopSearchPlaceholder"
                                       Text="Search mashups, games and players"
                                       Foreground="#666460"
                                       FontSize="12"
                                       FontFamily="{StaticResource NunitoFont}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Shortcut key '/' badge -->
                        <Border Grid.Column="2" Background="#262422" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="/" Foreground="#7E7B77" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT: Community / Friends + Window Controls (Minimize, Close - NO Fullscreen) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Community / Friends Icon (Toggles Account Menu) -->
                    <Button Style="{StaticResource TopBarIconButton}" Click="Community_Click" ToolTip="Community &amp; Account" Margin="0,0,6,0">
                        <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                              Fill="#8E8E98" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click" ToolTip="Minimize" Margin="0,0,2,0">
                        <Path Data="M0,5 L10,5" Stroke="#8E8E98" StrokeThickness="1.5" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#8E8E98" StrokeThickness="1.5" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ══════ SIDEBAR NAVIGATION FLYOUT (TOGGLED BY [| ] BUTTON) ══════ -->
            <Grid x:Name="SidebarNavOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9998" Visibility="Collapsed">
                <Border Background="#01000000" MouseLeftButtonDown="SidebarNavBackdrop_Click"/>

                <Border Width="220" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,44,0,0"
                        Background="#161619" BorderBrush="#2A2A30" BorderThickness="1"
                        CornerRadius="10" Padding="8,8" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="NAVIGATION" Foreground="#606068" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource NunitoFont}" Margin="10,4,10,6"/>

                        <!-- 1. Discover / Home -->
                        <Button Style="{StaticResource SidebarMenuItem}" Click="NavDiscover_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z"
                                      Stroke="#A0A5B5" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Discover" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Library / Versions -->
                        <Button Style="{StaticResource SidebarMenuItem}" Click="NavLibrary_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                                      Stroke="#A0A5B5" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Library" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. News -->
                        <Button Style="{StaticResource SidebarMenuItem}" Click="NavNews_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18,8 A6,6 0 0,0 6,8 C6,15 3,17 3,17 H21 C21,17 18,15 18,8 M13.73,21 A2,2 0 0,1 10.27,21"
                                      Stroke="#A0A5B5" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="News" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Height="1" Fill="#282A34" Margin="4,6,4,6"/>

                        <!-- 4. Settings -->
                        <Button Style="{StaticResource SidebarMenuItem}" Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z M19.4,13 L21.7,9.2 L19.1,4.6 L16.4,5.7 C15.8,5.3 15.2,4.9 14.5,4.6 L14.1,1.7 L9.5,1.7 L9.1,4.6 C8.4,4.9 7.8,5.3 7.2,5.7 L4.5,4.6 L1.9,9.2 L4.2,11 C4.1,11.3 4.1,11.7 4.1,12 C4.1,12.3 4.1,12.7 4.2,13 L1.9,14.8 L4.5,19.4 L7.2,18.3 C7.8,18.7 8.4,19.1 9.1,19.4 L9.5,22.3 L14.1,22.3 L14.5,19.4 C15.2,19.1 15.8,18.7 16.4,18.3 L19.1,19.4 L21.7,14.8 Z"
                                      Stroke="#A0A5B5" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Account -->
                        <Button Style="{StaticResource SidebarMenuItem}" Click="NavAccount_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20,21 V19 A4,4 0 0,0 16,15 H8 A4,4 0 0,0 4,19 V21 M12,11 A4,4 0 1,0 12,3 A4,4 0 0,0 12,11 Z"
                                      Stroke="#A0A5B5" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Account" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════ MAIN CONTENT STAGE WITH DIRECTIONAL SLIDE ══════ -->
            <Border x:Name="ContentBorder" Grid.Row="1" Background="Transparent" CornerRadius="0,0,11,11" ClipToBounds="True">
                <ContentControl x:Name="MainContentControl">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>

            <!-- ══════ IN-TREE ACCOUNT DROPDOWN OVERLAY (ROCK SOLID & NEVER CLOSES ON CLICK) ══════ -->
            <Grid x:Name="AccountMenuOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999" Visibility="Collapsed">
                <!-- Backdrop that covers the full window: clicking outside closes the menu cleanly -->
                <Border Background="#01000000" MouseLeftButtonDown="AccountMenuBackdrop_Click"/>

                <!-- Dropdown Card anchored below Community button in top-right -->
                <Border Width="240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,48,0"
                        Background="#1A1B22" BorderBrush="#2D2F3C" BorderThickness="1"
                        CornerRadius="10" Padding="14,14" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Current Account Info -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="7" Background="#242530" ClipToBounds="True" Margin="0,0,10,0">
                                <Image Source="{Binding PlayerAvatar}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold"
                                           FontFamily="{StaticResource NunitoFont}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Microsoft Account" Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{StaticResource NunitoFont}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#282A38" Margin="0,0,0,8"/>

                        <!-- Option 1: Manage Cosmetics -->
                        <Button Style="{StaticResource DropdownMenuItem}" Click="AccountMenu_Manage_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C8.13,14 5,15.79 5,18 V20 H19 V18 C19,15.79 15.87,14 12,14 Z"
                                      Stroke="#A0A5B5" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage Skin &amp; Cosmetics" Foreground="#E2E8F0" FontSize="12.5" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Option 2: Add Account -->
                        <Button Style="{StaticResource DropdownMenuItem}" Click="AccountMenu_AddAccount_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,5 V19 M5,12 H19" Stroke="#3B82F6" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Microsoft Account" Foreground="#E2E8F0" FontSize="12.5" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#282A38" Margin="0,6,0,8"/>

                        <!-- Option 3: Sign Out -->
                        <Button Style="{StaticResource DropdownMenuItemDanger}" Click="AccountMenu_SignOut_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9"
                                      Stroke="#EF4444" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign Out" Foreground="#EF4444" FontSize="12.5" FontWeight="SemiBold" FontFamily="{StaticResource NunitoFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
