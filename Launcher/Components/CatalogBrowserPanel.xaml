<UserControl x:Class="Launcher.Components.CatalogBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Launcher.Converters"
             xmlns:vm="clr-namespace:Launcher.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ExploreResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
            <conv:StringToImageSourceConverter x:Key="ImgSrc"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="460">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Browse list -->
        <Border Grid.Column="0" Style="{StaticResource ExploreCatalogPane}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Style="{StaticResource ExploreSearchBox}" Margin="0,0,0,10"
                         Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="CatalogSearch_TextChanged"/>

                <ListBox Grid.Row="1" x:Name="CatalogList"
                         Style="{StaticResource ExploreCatalogList}"
                         ItemContainerStyle="{StaticResource ExploreCatalogListItem}"
                         ItemsSource="{Binding CatalogHits}"
                         SelectionChanged="CatalogList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CatalogHitViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="10" Background="#161618" Padding="5" Margin="0,0,12,0" ClipToBounds="True">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource ImgSrc}}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Modrinth-style detail -->
        <Border Grid.Column="2" Style="{StaticResource ExploreCatalogPane}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding HasCatalogProject, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="Select a project" Foreground="#505054" FontSize="14" TextAlignment="Center"/>
                    <TextBlock Text="Pick a mod from the list to view details." Foreground="#3A3A3E" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="DetailScrollViewer" Visibility="{Binding HasCatalogProject, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto" Padding="20">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ExploreScrollBar}"/>
                    </ScrollViewer.Resources>

                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="14" Background="#161618" Padding="8" Margin="0,0,16,0" ClipToBounds="True">
                                <Image Source="{Binding CatalogDetailIcon, Converter={StaticResource ImgSrc}}" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CatalogDetailTitle}" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CatalogDetailDesc}" Foreground="#8E8E93" FontSize="13" Margin="0,6,0,0"
                                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Foreground="#6E6E72" FontSize="12" Margin="0,0,16,0">
                                        <Run Text="↓ "/><Run Text="{Binding CatalogDetailDownloadsText}"/><Run Text=" downloads"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#6E6E72" FontSize="12">
                                        <Run Text="♡ "/><Run Text="{Binding CatalogDetailFollowersText}"/><Run Text=" followers"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="PrimaryActionBtn" Grid.Column="2" Style="{StaticResource ExploreCatalogDownloadBtn}"
                                    VerticalAlignment="Top" Click="PrimaryAction_Click"
                                    IsEnabled="{Binding CanPrimaryAction}"/>
                        </Grid>

                        <!-- Category tags -->
                        <ItemsControl ItemsSource="{Binding CatalogDetailCategories}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ExploreCatalogTag}">
                                        <TextBlock Text="{Binding}" Foreground="#CCE4FF" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tabs -->
                        <WrapPanel Margin="0,0,0,14">
                            <Button x:Name="TabDesc" Content="Description" Tag="description" Style="{StaticResource ExploreCatalogTabActive}" Click="CatalogTab_Click"/>
                            <Button x:Name="TabChangelog" Content="Changelog" Tag="changelog" Style="{StaticResource ExploreCatalogTab}" Click="CatalogTab_Click"/>
                            <Button x:Name="TabVersions" Content="Versions" Tag="versions" Style="{StaticResource ExploreCatalogTab}" Click="CatalogTab_Click"/>
                        </WrapPanel>

                        <!-- Tab: Description -->
                        <Border Background="#0B0B0D" CornerRadius="10" Padding="2"
                                Visibility="{Binding IsCatalogDescTab, Converter={StaticResource BoolToVisibilityConverter}}">
                            <wv2:WebView2 x:Name="DescriptionWebView" DefaultBackgroundColor="#0B0B0D" MinHeight="240"/>
                        </Border>

                        <!-- Tab: Changelog -->
                        <Border Background="#0B0B0D" CornerRadius="10" Padding="2"
                                Visibility="{Binding IsCatalogChangelogTab, Converter={StaticResource BoolToVisibilityConverter}}">
                            <wv2:WebView2 x:Name="ChangelogWebView" DefaultBackgroundColor="#0B0B0D" MinHeight="240"/>
                        </Border>

                        <!-- Tab: Versions -->
                        <ItemsControl ItemsSource="{Binding CatalogVersions}"
                                      Visibility="{Binding IsCatalogVersionsTab, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CatalogVersionViewModel}">
                                    <Border Background="#0E0E10" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionNumber}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LoadersText}" Foreground="#505054" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Tag="{Binding Id}" Click="VersionAction_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ExploreInstallBtn}">
                                                        <Setter Property="Content" Value="Install"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Content" Value="Uninstall"/>
                                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
